{% schema %}
{
  "name": "Atacama SOS Salespage",
  "settings": [],
  "presets": [{"name": "Atacama SOS Salespage","category": "Custom"}]
}
{% endschema %}

<!-- GOOGLE FONTS: Inter (Official HALO Tech Typography) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  :root {
    --asos-bg: #FFFFFF;
    --asos-bg-2: #F8FAFC;
    --asos-bg-3: #F1F5F9;
    --asos-red: #EF4444;
    --asos-red-glow: rgba(239, 68, 68, 0.1);
    --asos-green: #10B981;
    --asos-text: #000000;
    --asos-text-muted: rgba(0,0,0,0.6);
    --asos-border: rgba(0,0,0,0.1);
    --asos-font-family: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .asos-container {
    background-color: var(--asos-bg);
    color: var(--asos-text);
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Display", sans-serif !important;
    line-height: 1.5;
    overflow-x: hidden;
  }

  .asos-container,
  .asos-container h1,
  .asos-container h2,
  .asos-container h3,
  .asos-container p,
  .asos-container span,
  .asos-container div,
  .asos-container a,
  .asos-container button,
  .asos-container strong,
  .asos-container li,
  .asos-h1,
  .asos-h2,
  .asos-p {
    font-family: var(--asos-font-family) !important;
  }

  .asos-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Typography */
  .asos-h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 900; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 20px; color: var(--asos-text) !important; }
  .asos-h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 24px; color: var(--asos-text) !important; }
  .asos-product-title { font-size: clamp(1.5rem, 5vw, 2rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 8px; color: var(--asos-text) !important; }
  
  @media (max-width: 768px) {
    .asos-product-title { font-size: 1.55rem !important; margin-bottom: 6px !important; }
    .asos-buy-box > div { margin-bottom: 10px !important; }
    .asos-mp-card { padding: 12px 10px !important; }
  }

  .asos-p { font-size: 1.125rem; color: var(--asos-text-muted) !important; margin-bottom: 30px; }
  
  .asos-tag {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 100px;
    background: var(--asos-red-glow);
    color: var(--asos-red) !important;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  /* Hero Section (Buy Box Layout) */
  .asos-hero {
    padding: 60px 0 80px;
    background: radial-gradient(circle at center top, var(--asos-bg-3) 0%, var(--asos-bg) 100%);
  }
  .asos-hero-grid {
    display: grid;
    grid-template-columns: 1fr 450px;
    gap: 60px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .asos-hero-grid { grid-template-columns: 1fr; gap: 40px; }
  }

  /* Product Image Gallery */
  .asos-gallery {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: var(--asos-bg-2);
    border: 1px solid var(--asos-border);
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .asos-gallery img { width: 100%; height: 100%; object-fit: cover; }

  /* Buy Box */
  .asos-buy-box {
    background: var(--asos-bg-2);
    border: 1px solid var(--asos-border);
    border-radius: 24px;
    padding: 32px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }
  .asos-reviews {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .asos-stars { color: #FFB800; font-size: 1.2rem; }
  .asos-review-text { font-size: 0.9rem; color: var(--asos-text-muted) !important; font-weight: 500; }

  .asos-price-wrap { margin-bottom: 24px; }
  .asos-price { font-size: 2.5rem; font-weight: 800; color: var(--asos-text) !important; }
  .asos-price-compare { font-size: 1.25rem; color: var(--asos-text-muted) !important; text-decoration: line-through; margin-left: 12px; }

  /* Mercadopago Banner */
  .asos-mp-banner {
    background: rgba(0, 158, 227, 0.1);
    border: 1px solid rgba(0, 158, 227, 0.3);
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .asos-mp-text { font-size: 0.9rem; color: #009EE3 !important; font-weight: 600; }

  /* Stock Pulse */
  .asos-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 0.9rem;
    color: var(--asos-text-muted) !important;
  }
  .asos-pulse {
    width: 8px; height: 8px; background: var(--asos-red); border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    animation: pulseRed 2s infinite;
  }
  @keyframes pulseRed {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }

  /* Dual CTA Button - MAXIMUM SPECIFICITY */
  .asos-container button.asos-btn,
  .asos-container a.asos-btn {
    display: block; width: 100%;
    background: var(--asos-green) !important;
    color: #000 !important;
    border: 1px solid var(--asos-green) !important;
    font-family: var(--asos-font-family) !important;
    border-radius: 16px;
    padding: 20px;
    text-align: center;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.3);
    margin-bottom: 16px;
  }
  .asos-container button.asos-btn:hover,
  .asos-container a.asos-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(16, 185, 129, 0.4); }
  .asos-container .asos-btn-title { display: block; font-family: var(--asos-font-family) !important; font-size: 1.25rem; font-weight: 900; margin-bottom: 4px; color: #FFFFFF !important; }
  .asos-container .asos-btn-sub { display: block; font-family: var(--asos-font-family) !important; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; opacity: 0.8; letter-spacing: 0.5px; color: #FFFFFF !important; }

  /* Trustpilot */
  .asos-tp { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 16px; }
  .asos-tp img { height: 24px; }

  /* Enemy Comparison Section */
  .asos-enemy {
    padding: 100px 0;
    background: var(--asos-bg);
  }
  .asos-enemy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 60px;
  }
  @media (max-width: 900px) {
    .asos-enemy-grid { grid-template-columns: 1fr; }
  }
  .asos-enemy-card {
    background: var(--asos-bg-2);
    border: 1px solid var(--asos-border);
    border-radius: 24px;
    padding: 40px 30px;
    text-align: center;
  }
  .asos-enemy-card.winner {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.3);
    position: relative;
  }
  .asos-winner-badge {
    position: absolute; top: -16px; left: 50%; transform: translateX(-50%);
    background: var(--asos-green); color: #000 !important; font-weight: 800;
    padding: 6px 16px; border-radius: 100px; font-size: 0.85rem; letter-spacing: 1px;
  }

  /* Features / Solutions */
  .asos-feature {
    padding: 100px 0;
    border-top: 1px solid var(--asos-border);
  }
  .asos-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .asos-feature-grid.reverse { direction: rtl; }
  .asos-feature-grid.reverse > * { direction: ltr; }
  @media (max-width: 900px) {
    .asos-feature-grid { grid-template-columns: 1fr; gap: 40px; }
    .asos-feature-grid.reverse { direction: ltr; }
  }

  /* Visual Checkmarks */
  .asos-check-list { list-style: none; padding: 0; margin: 0; }
  .asos-check-item {
    display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px;
  }
  .asos-check-icon {
    width: 28px; height: 28px; border-radius: 50%; background: rgba(16, 185, 129, 0.1);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
</style>

<div class="asos-container">
  
  <!-- HERO SECTION (BUY BOX) -->
  <section class="asos-hero">
    <div class="asos-wrap" style="text-align: center; max-width: 900px; margin-bottom: 40px;">
      <span class="asos-tag">ALERTA MÉDICA INTELIGENTE</span>
      <h1 class="asos-h1">Cómo protegerlos de una caída fatal, sin arrebatarles su <span style="color:var(--asos-red);">dignidad.</span></h1>
      <p class="asos-p" style="margin-bottom: 0;">El Sequoia SOS Band es el único guardián 4G invisible. Sin smartphones complicados, sin collares humillantes y sin pagar $50/mes en suscripciones.</p>
    </div>

    <div class="asos-wrap asos-hero-grid">
      <!-- Left: Visual Anchor (Product Image) -->
      <div class="asos-gallery">
        <img src="https://cdn.shopify.com/s/files/1/0893/5886/0593/files/halo_band_placeholder.png" alt="Sequoia SOS Band" onerror="this.src='https://placehold.co/800x800/141414/333333?text=Atacama+SOS+Watch'">
      </div>

      <!-- Right: Hyper-Dense Buy Box (Rule 27) -->
      <div class="asos-buy-box">
        
        <h2 class="asos-product-title">{{ product.title }}</h2>
        
        <div style="display:flex; justify-content:flex-start; align-items:center; gap: 4px; margin-bottom: 16px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#00B67A" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#00B67A" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#00B67A" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#00B67A" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#00B67A" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          <span style="color: var(--asos-text); font-weight:800; font-size:0.9rem; margin-left:8px;">4.9/5 en Trustpilot</span>
        </div>

        <div style="display: flex; align-items: baseline; justify-content: flex-start; gap: 12px; margin-bottom: 16px;">
          <span style="color:var(--asos-text-muted); text-decoration:line-through; font-size:1.2rem;">$169.000</span>
          <span style="color: var(--asos-text); font-weight:900; font-size:2.5rem; letter-spacing:-0.05em;">$97.000</span>
        </div>

        <!-- MERCADOPAGO PREMIUM BANNER (HIGH CONTRAST) -->
        <div class="asos-mp-card" style="background: rgba(0, 158, 227, 0.05); border: 1px solid rgba(0, 158, 227, 0.3); border-radius: 16px; padding: 12px; display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <div style="background: #FFFFFF; border-radius: 8px; padding: 6px; display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; flex-shrink: 0;">
            <img src="https://http2.mlstatic.com/frontend-assets/mp-web-navigation/ui-navigation/5.19.1/mercadopago/logo__small@2x.png" alt="Mercado Pago" style="max-width: 100%; object-fit: contain;">
          </div>
          <div style="display:flex; flex-direction:column; gap:4px; text-align: left;">
            <div style="color: var(--asos-text) !important; font-size: 0.95rem; font-weight: 600;">
              Paga en <span style="color: #009EE3 !important;">3 cuotas</span> de <span style="font-weight: 800; color: var(--asos-text) !important;">{% if product %}{{ product.price | divided_by: 3 | money }}{% else %}$32.333{% endif %}</span>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
              <span style="color: var(--asos-green) !important; font-size: 0.85rem; font-weight: 700; display:flex; align-items:center; gap:4px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Sin interés
              </span>
              <span style="color: var(--asos-text-muted) !important; font-size: 0.85rem; display:flex; align-items:center; gap:4px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                100% Seguro
              </span>
            </div>
          </div>
        </div>

        <!-- STOCK PULSE -->
        <div style="display: flex; align-items: center; justify-content: flex-start; gap: 10px; margin-bottom: 25px; padding-bottom: 20px; border-bottom: 1px solid var(--asos-border);">
          <div style="position: relative; display: flex; align-items: center; justify-content: center; width: 12px; height: 12px;">
            <span style="position: absolute; width: 100%; height: 100%; background-color: var(--asos-red); border-radius: 50%; opacity: 0.7; animation: pulseRed 2s infinite;"></span>
            <span style="position: relative; width: 8px; height: 8px; background-color: var(--asos-red); border-radius: 50%;"></span>
          </div>
          <span style="color: var(--asos-text) !important; font-size: 0.95rem;">
            Solo quedan <strong style="color: var(--asos-red) !important;">{{ 'now' | date: '%S' | modulo: 5 | plus: 3 }} unidades</strong> en oferta
          </span>
        </div>

        <!-- ENVIO INMEDIATO -->
        <div style="background: rgba(16, 185, 129, 0.1); border-radius: 8px; padding: 12px; text-align: center; margin-bottom: 20px;">
          <span style="color: var(--asos-green) !important; font-size: 0.95rem; font-weight: 700; display:flex; align-items:center; justify-content:center; gap:8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            Envío inmediato a todo Chile (MISMO DÍA)
          </span>
        </div>

        <!-- Dual Text CTA -->
        <div style="margin-bottom: 20px;">
          {% if product %}
            <form method="post" action="/cart/add" style="display:flex; flex-direction:column; width: 100%;">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="asos-btn" style="width: 100%; display: flex; flex-direction: column; align-items: center; padding: 16px 20px; gap: 2px;">
                <span style="font-size: 1.15rem; font-weight: 900; color: #FFFFFF !important; font-family: var(--asos-font-family) !important;">PROTEGERLOS AHORA 🛡️</span>
                <span style="font-size: 0.85rem; font-weight: 800; color: rgba(255,255,255,0.85) !important; font-family: var(--asos-font-family) !important; text-transform: uppercase; letter-spacing: 0.05em;">ANTES DE QUE SE AGOTE LA PROMO 🔥</span>
              </button>
            </form>
          {% else %}
            <a href="#" class="asos-btn" style="width: 100%; display: flex; flex-direction: column; align-items: center; padding: 16px 20px; gap: 2px;">
              <span style="font-size: 1.15rem; font-weight: 900; color: #FFFFFF !important; font-family: var(--asos-font-family) !important;">PROTEGERLOS AHORA 🛡️</span>
              <span style="font-size: 0.85rem; font-weight: 800; color: rgba(255,255,255,0.85) !important; font-family: var(--asos-font-family) !important; text-transform: uppercase; letter-spacing: 0.05em;">ANTES DE QUE SE AGOTE LA PROMO 🔥</span>
            </a>
          {% endif %}
        </div>

        <!-- TRUSTPILOT LIQUID -->
        <div style="margin-bottom: 30px; text-align: left; display: flex; flex-direction: column; align-items: flex-start;">
          <div style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 5px;">
            <svg width="24" height="24" viewBox="0 0 31.7 31.7"><path fill="#00B67A" d="M31.7 15.8l-12.1-8.8 4.6-14.2-12.1 8.8-12.1-8.8 4.6 14.2-12.1 8.8h15z" transform="translate(9.6 14.2) scale(.38)"/><path fill="#00B67A" d="M15.8 31.7c8.8 0 15.8-7.1 15.8-15.8S24.6 0 15.8 0 0 7.1 0 15.8s7.1 15.8 15.8 15.8z"/><path fill="#FFF" d="M16 23.4l-4.7 3.4 1.8-5.5-4.7-3.4h5.8l1.8-5.5 1.8 5.5h5.8l-4.7 3.4 1.8 5.5z"/></svg>
            <span style="color: var(--asos-text) !important; font-weight: 800; font-size: 1.1rem; letter-spacing: 0.02em;">Trustpilot</span>
            <div style="display:flex; gap: 2px;">
              <div style="background:#00B67A; padding:2px; display:flex;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFF"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
              <div style="background:#00B67A; padding:2px; display:flex;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFF"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
              <div style="background:#00B67A; padding:2px; display:flex;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFF"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
              <div style="background:#00B67A; padding:2px; display:flex;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFF"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
              <div style="background:#00B67A; padding:2px; display:flex;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFF"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
            </div>
          </div>
          <div style="display: flex; gap: 8px; align-items: center;">
            <div style="color: var(--asos-text) !important; font-weight: 700; font-size: 0.95rem;">Excelente 4.9/5</div>
            <div style="color: var(--asos-text-muted) !important; font-size: 0.8rem;">Basado en +12,000 usuarios</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ENEMY SECTION: THE COMPARISON -->
  <section class="asos-enemy">
    <div class="asos-wrap">
      <div style="text-align: center; max-width: 800px; margin: 0 auto;">
        <span class="asos-tag" style="background: var(--asos-border); color: var(--asos-text) !important; border-color: rgba(255,255,255,0.2);">EL STATUS QUO ESTÁ ROTO</span>
        <h2 class="asos-h2">Por qué odian las alternativas (Y por qué te estresan a ti)</h2>
        <p class="asos-p">Hasta ahora, solo tenías dos opciones para protegerlos. Ambas eran terribles.</p>
      </div>

      <div class="asos-enemy-grid">
        <!-- Enemy 1 -->
        <div class="asos-enemy-card">
          <div style="height: 120px; display:flex; align-items:center; justify-content:center; margin-bottom: 24px;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h3 style="color: var(--asos-text); margin-bottom:12px; font-size:1.25rem;">El Collar "Life Alert"</h3>
          <p style="color:var(--asos-text-muted); font-size:0.95rem; margin-bottom:24px;">Un botón rojo colgando del cuello grita "soy un inválido". Ataca su ego y dignidad, por lo que <strong>terminan escondiéndolo en una gaveta</strong>.</p>
          <div style="color:var(--asos-red); font-weight:700; font-size:0.9rem;">Te cobra $50/mes para siempre.</div>
        </div>

        <!-- Winner -->
        <div class="asos-enemy-card winner">
          <div class="asos-winner-badge">LA SOLUCIÓN</div>
