<style>
  /* ═══════════════════════════════
     HALO BOUTIQUE COLLECTION
     ═══════════════════════════════ */
  :root {
    --hh-black: #0A0A0A;
    --hh-white: #FFFFFF;
    --hh-green: #00C97B;
    --hh-font: 'Inter', -apple-system, sans-serif;
  }

  .hh-col-page {
    background-color: var(--hh-black);
    min-height: 100vh;
    padding-bottom: 100px;
  }

  /* 1. HERO HEADER */
  .hh-col-hero {
    padding: 120px 24px 60px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .hh-col-hero-title {
    font-family: var(--hh-font) !important;
    font-size: 56px;
    font-weight: 900;
    color: var(--hh-white);
    letter-spacing: -0.02em;
    margin: 0 0 16px 0;
    line-height: 1.1;
  }
  .hh-col-hero-desc {
    font-family: var(--hh-font) !important;
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* 2. GRID CONTROLS */
  .hh-col-controls {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .hh-col-count {
    font-family: var(--hh-font) !important;
    font-size: 12px;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  /* 3. PRODUCT GRID */
  .hh-col-grid-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
  }
  .hh-col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* PRODUCT CARD */
  .hh-hero-prod-card {
    background: var(--hh-white);
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 20px; 
    overflow: hidden;
    display: flex; 
    flex-direction: column;
    transition: border-color 0.3s, transform 0.3s; 
    cursor: pointer;
    text-decoration: none;
    position: relative;
  }
  .hh-hero-prod-card:hover { 
    border-color: rgba(0,201,123,0.8); 
    transform: translateY(-4px);
  }

  .hh-hero-prod-img-wrap {
    background: transparent;
    display: flex; align-items: center; justify-content: center;
    padding: 30px; 
    aspect-ratio: 1/1;
  }
  .hh-hero-prod-img {
    width: 100%; height: 100%; object-fit: contain;
    transition: transform 0.3s;
  }
  .hh-hero-prod-card:hover .hh-hero-prod-img { transform: scale(1.05); }

  .hh-hero-prod-info { 
    padding: 24px; 
    display: flex; flex-direction: column; 
    gap: 6px; 
    background: #F8F8F8; 
    border-top: 1px solid rgba(0,0,0,0.03);
    flex-grow: 1;
  }
  .hh-hero-prod-cat { 
    font-size: 10px; font-weight: 800; letter-spacing: 0.12em; 
    text-transform: uppercase; color: var(--hh-green); 
    font-family: var(--hh-font) !important; 
  }
  .hh-hero-prod-name { 
    font-size: 18px; font-weight: 900; color: var(--hh-black); 
    font-family: var(--hh-font) !important; line-height: 1.3; 
  }
  .hh-hero-prod-price { 
    font-size: 16px; font-weight: 800; color: var(--hh-black); 
    margin-top: auto; padding-top: 12px;
    font-family: var(--hh-font) !important; 
  }

  /* EMPTY STATE */
  .hh-col-empty {
    text-align: center;
    padding: 80px 24px;
    color: rgba(255,255,255,0.4);
    font-family: var(--hh-font) !important;
  }

  @media (max-width: 900px) {
    .hh-col-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .hh-col-hero-title { font-size: 40px; }
  }
  @media (max-width: 600px) {
    .hh-col-grid { grid-template-columns: 1fr; }
    .hh-col-hero-title { font-size: 32px; }
    .hh-col-hero { padding: 80px 20px 40px 20px; }
    .hh-hero-prod-img-wrap { padding: 40px; }
  }
</style>

<div class="hh-col-page">
  
  <section class="hh-col-hero">
    <h1 class="hh-col-hero-title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="hh-col-hero-desc">{{ collection.description }}</div>
    {% endif %}
  </section>

  <div class="hh-col-controls">
    <div class="hh-col-count">{{ collection.products_count }} Equipos Tácticos</div>
  </div>

  <div class="hh-col-grid-wrap">
    {% if collection.products_count == 0 %}
      <div class="hh-col-empty">
        <p>No hay equipos disponibles en esta categoría en este momento.</p>
      </div>
    {% else %}
      <div class="hh-col-grid">
        {% for product in collection.products %}
          <a href="{{ product.url | within: collection }}" class="hh-hero-prod-card">
            <div class="hh-hero-prod-img-wrap">
              <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title | escape }}" class="hh-hero-prod-img" loading="lazy">
            </div>
            <div class="hh-hero-prod-info">
              <span class="hh-hero-prod-cat">{{ product.type | default: 'Equipamiento' }}</span>
              <span class="hh-hero-prod-name">{{ product.title }}</span>
              <span class="hh-hero-prod-price">{{ product.price | money }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>

</div>

{% schema %}
{
  "name": "HALO Colección Brutal",
  "settings": []
}
{% endschema %}
