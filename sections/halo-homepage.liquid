{% comment %}
  HALO® — Brand Homepage v4.1
  Products: Compress Bag® | SmartPaine® | Atacama Band®
  URLs & Images loaded dynamically via all_products
{% endcomment %}

{% assign compress_bag_prod = all_products['compress-bag'] %}
{% assign smartpaine_prod   = all_products['smartpaine®-inteligencia-artificial-con-cambio-de-color-audio-hd-traduccion'] %}
{% assign atacama_band_prod = all_products['atacama-band®'] %}

{% assign compress_bag_url = compress_bag_prod.url | default: '/products/compress-bag' %}
{% assign smartpaine_url   = smartpaine_prod.url   | default: '/products/smartpaine%C2%AE-inteligencia-artificial-con-cambio-de-color-audio-hd-traduccion' %}
{% assign atacama_band_url = atacama_band_prod.url | default: '/products/atacama-band%C2%AE' %}

{% assign compress_bag_img = 'halo-compress-bag-white.webp' | asset_url %}

{% assign smartpaine_img = 'halo-smartpaine-white.webp' | asset_url %}

{% assign atacama_band_img = 'halo-atacama-band-white.webp' | asset_url %}

<!-- ⚡ LCP OPTIMIZATION: Preload de la Hero Image (Menos Resource Load Delay) -->
<link rel="preload" as="image" href="{{ compress_bag_img }}" fetchpriority="high">

{% assign compress_bag_price = compress_bag_prod.price_min | money | default: '$49.990' %}
{% assign smartpaine_price   = smartpaine_prod.price_min   | money | default: '$89.990' %}
{% assign atacama_band_price = atacama_band_prod.price_min | money | default: '$19.990' %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* =====================================================
   HALO® — BRAND HOMEPAGE v4.1
   Compress Bag® | SmartPaine® | Atacama Band®
   Protocolo: Regla 39 (Grayscale) + Regla 10 (Homepage)
   ===================================================== */

  .halo-home {
    --hh-white:      #FFFFFF;
    --hh-snow:       #FAF9F6;
    --hh-slate:      #F4F4F5;
    --hh-gray-light: #ECECEE;
    --hh-gray-mid:   #71717A;
    --hh-gray-dark:  #52525B;
    --hh-black:      #0A0A0A;
    --hh-carbon:     #121214;
    --hh-charcoal:   #18181B;
    --hh-green:      #00C97B;
    --hh-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-family: var(--hh-font);
    -webkit-font-smoothing: antialiased;
    background: var(--hh-white);
    color: var(--hh-black);
    overflow-x: hidden;
  }

  .halo-home * { box-sizing: border-box; margin: 0; padding: 0; }
  .halo-home a { text-decoration: none; color: inherit; }
  .halo-home img { display: block; max-width: 100%; }

  .hh-c { max-width: 1240px; margin: 0 auto; padding: 0 28px; }

  /* ── BUTTONS ── */
  .hh-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--hh-font) !important;
    font-size: 14px; font-weight: 800; letter-spacing: 0.01em;
    padding: 13px 26px; border-radius: 9999px;
    border: none; cursor: pointer; transition: all 0.2s;
    white-space: nowrap;
  }
  .hh-btn-dark { background: var(--hh-black); color: #fff !important; }
  .hh-btn-dark:hover { opacity: 0.82; }
  .hh-btn-green { background: var(--hh-green); color: #fff !important; box-shadow: 0 6px 24px rgba(0,201,123,0.30); }
  .hh-btn-green:hover { box-shadow: 0 12px 32px rgba(0,201,123,0.50); transform: translateY(-1px); }
  .hh-btn-ghost-white {
    background: transparent; color: #fff !important;
    border: 1.5px solid rgba(255,255,255,0.22);
  }
  .hh-btn-ghost-white:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.5); }

  .hh-eyebrow {
    display: inline-block;
    font-size: 10px; font-weight: 800; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--hh-green);
    margin-bottom: 14px; font-family: var(--hh-font) !important;
  }

  .hh-h2 {
    font-size: clamp(2rem, 3.8vw, 3.2rem) !important;
    font-weight: 900 !important; color: var(--hh-black) !important;
    letter-spacing: -0.035em; line-height: 1.08;
    font-family: var(--hh-font) !important;
  }
  .hh-h2-white { color: #fff !important; }

  /* ═══════════════════════════════
     1. HERO
     ═══════════════════════════════ */
  .hh-hero {
    background: var(--hh-black);
    min-height: 100vh;
    display: grid; grid-template-rows: 1fr auto;
    position: relative; overflow: hidden;
  }

  .hh-hero::before {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, rgba(0,201,123,0.06) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 20% 80%, rgba(255,255,255,0.025) 0%, transparent 60%);
    pointer-events: none; z-index: 0;
  }

  .hh-hero-grid {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 100vh; align-items: stretch;
  }

  .hh-hero-copy {
    display: flex; flex-direction: column;
    justify-content: center; padding: 80px 60px 80px 0;
  }

  .hh-hero-label {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 16px; margin-bottom: 32px;
    background: rgba(0,201,123,0.10);
    border: 1px solid rgba(0,201,123,0.25);
    border-radius: 9999px; width: fit-content;
  }
  .hh-hero-label-dot {
    width: 6px; height: 6px; background: var(--hh-green);
    border-radius: 50%; animation: hh-pulse 2s ease-in-out infinite;
  }
  @keyframes hh-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.5)} }
  .hh-hero-label-text {
    font-size: 10px; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--hh-green);
    font-family: var(--hh-font) !important;
  }

  .hh-hero-title {
    font-size: clamp(3rem, 5.2vw, 5.8rem) !important;
    font-weight: 900 !important; color: #fff !important;
    letter-spacing: -0.045em; line-height: 0.96; margin-bottom: 28px;
    font-family: var(--hh-font) !important;
  }
  .hh-hero-title-accent { color: var(--hh-green); }

  .hh-hero-sub {
    font-size: 17px; color: rgba(255,255,255,0.55);
    line-height: 1.7; max-width: 440px; margin-bottom: 44px;
    font-family: var(--hh-font) !important;
  }

  .hh-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 52px; }

  .hh-hero-trust {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.08);
  }
  .hh-hero-tp-stars { color: var(--hh-green); font-size: 14px; letter-spacing: 2px; }
  .hh-hero-tp-text { font-size: 12px; color: rgba(255,255,255,0.45); font-family: var(--hh-font) !important; }
  .hh-hero-tp-text strong { color: rgba(255,255,255,0.80); }
  .hh-hero-trust-sep { color: rgba(255,255,255,0.12); font-size: 18px; }
  .hh-hero-trust-meta { font-size: 12px; color: rgba(255,255,255,0.35); font-family: var(--hh-font) !important; }

  /* PRODUCT CARDS HERO */
  .hh-hero-products {
    display: flex; flex-direction: column;
    justify-content: center; gap: 12px;
    padding: 60px 0 60px 40px;
    border-left: 1px solid rgba(255,255,255,0.06);
  }

  .hh-hero-prod-card {
    background: var(--hh-white);
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 20px; overflow: hidden;
    display: grid; grid-template-columns: 120px 1fr;
    transition: border-color 0.3s; cursor: pointer;
    text-decoration: none;
  }
  .hh-hero-prod-card:hover { border-color: rgba(0,201,123,0.8); }
  .hh-hero-prod-card.highlight { border-color: rgba(0,201,123,0.25); }

  .hh-hero-prod-img-wrap {
    background: transparent;
    display: flex; align-items: center; justify-content: center;
    padding: 16px; aspect-ratio: 1/1;
  }
  .hh-hero-prod-img {
    width: 88%; height: 88%; object-fit: contain;
    transition: transform 0.3s;
  }
  .hh-hero-prod-card:hover .hh-hero-prod-img { transform: scale(1.07); }

  .hh-hero-prod-info { padding: 18px 18px 18px 14px; display: flex; flex-direction: column; justify-content: center; gap: 4px; }
  .hh-hero-prod-cat { font-size: 9px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--hh-green); font-family: var(--hh-font) !important; }
  .hh-hero-prod-name { font-size: 14px; font-weight: 800; color: var(--hh-black); font-family: var(--hh-font) !important; line-height: 1.3; }
  .hh-hero-prod-desc { font-size: 11px; color: rgba(0,0,0,0.5); font-family: var(--hh-font) !important; line-height: 1.4; }
  .hh-hero-prod-price { font-size: 14px; font-weight: 900; color: var(--hh-black); margin-top: 6px; font-family: var(--hh-font) !important; }

  .hh-hero-scroll {
    position: relative; z-index: 2;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 14px 0; text-align: center;
  }
  .hh-hero-scroll span { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.28); font-family: var(--hh-font) !important; }

  /* ═══════════════════════════════
     2. TICKER
     ═══════════════════════════════ */
  .hh-strip { background: var(--hh-charcoal); border-bottom: 1px solid rgba(255,255,255,0.06); overflow: hidden; }
  .hh-strip-inner { display: flex; animation: hh-marquee 30s linear infinite; width: max-content; }
  @keyframes hh-marquee { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
  .hh-strip-item { display: flex; align-items: center; gap: 10px; padding: 14px 32px; border-right: 1px solid rgba(255,255,255,0.05); white-space: nowrap; flex-shrink: 0; }
  .hh-strip-dot { width: 5px; height: 5px; background: var(--hh-green); border-radius: 50%; flex-shrink: 0; }
  .hh-strip-text { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: rgba(255,255,255,0.50); font-family: var(--hh-font) !important; }

  /* ═══════════════════════════════
     3. LAS 3 LÍNEAS
     ═══════════════════════════════ */
  .hh-lines { padding: 110px 0; background: var(--hh-white); }
  .hh-lines-header { margin-bottom: 64px; }

  .hh-lines-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }

  .hh-line-card {
    border-radius: 28px; overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1), box-shadow 0.35s;
    cursor: pointer; text-decoration: none; color: inherit; position: relative;
  }
  .hh-line-card:hover { transform: translateY(-8px); box-shadow: 0 32px 72px rgba(0,0,0,0.13); }

  .hh-line-card-1 { background: var(--hh-white); }
  .hh-line-card-2 { background: var(--hh-white); }
  .hh-line-card-3 { background: var(--hh-white); }

  .hh-line-badge {
    position: absolute; top: 22px; right: 22px;
    background: var(--hh-green); color: #fff;
    font-size: 9px; font-weight: 800; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 4px 10px; border-radius: 6px;
    font-family: var(--hh-font) !important; z-index: 2;
  }

  .hh-line-img-frame {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 48px 40px; min-height: 280px; position: relative; overflow: hidden;
  }
  .hh-line-img {
    width: 78%; max-height: 230px; object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.22,1,0.36,1);
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.45));
    position: relative; z-index: 1;
  }
  .hh-line-card-3 .hh-line-img { filter: drop-shadow(0 16px 32px rgba(0,0,0,0.15)); }
  .hh-line-card:hover .hh-line-img { transform: scale(1.07) translateY(-4px); }

  .hh-line-body { padding: 28px 28px 32px; }

  .hh-line-cat { font-size: 9px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--hh-green); margin-bottom: 6px; display: block; font-family: var(--hh-font) !important; }
  .hh-line-name { font-size: 22px !important; font-weight: 900 !important; color: var(--hh-black) !important; letter-spacing: -0.02em; margin-bottom: 8px; line-height: 1.2; font-family: var(--hh-font) !important; }
  .hh-line-card-3 .hh-line-name { color: var(--hh-black) !important; }
  .hh-line-desc { font-size: 13px; color: rgba(0,0,0,0.6); line-height: 1.6; margin-bottom: 22px; font-family: var(--hh-font) !important; }
  .hh-line-card-3 .hh-line-desc { color: var(--hh-gray-mid); }

  .hh-line-footer { display: flex; align-items: center; justify-content: space-between; }
  .hh-line-price { font-size: 22px; font-weight: 900; color: var(--hh-black); font-family: var(--hh-font) !important; }
  .hh-line-card-3 .hh-line-price { color: var(--hh-black); }

  .hh-line-cta {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 800; color: var(--hh-black) !important;
    background: rgba(0,0,0,0.06); border-radius: 9999px; padding: 8px 16px;
    border: 1px solid rgba(255,255,255,0.12); transition: all 0.2s;
    font-family: var(--hh-font) !important;
  }
  .hh-line-card:hover .hh-line-cta { background: var(--hh-green); border-color: var(--hh-green); }
  .hh-line-card-3 .hh-line-cta { color: var(--hh-black) !important; background: rgba(0,0,0,0.07); border-color: rgba(0,0,0,0.12); }
  .hh-line-card-3:hover .hh-line-cta { background: var(--hh-green); border-color: var(--hh-green); color: #fff !important; }

  /* ═══════════════════════════════
     4. MANIFESTO
     ═══════════════════════════════ */
  .hh-manifesto { background: var(--hh-black); padding: 130px 0; position: relative; overflow: hidden; }
  .hh-manifesto::before {
    content: ''; position: absolute; top: -300px; right: -300px;
    width: 700px; height: 700px; border-radius: 50%;
    background: radial-gradient(circle, rgba(0,201,123,0.06) 0%, transparent 65%);
    pointer-events: none;
  }
  .hh-manifesto-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; align-items: center; position: relative; z-index: 1; }

  .hh-manifesto-pull { font-size: clamp(2rem,4.2vw,3.8rem) !important; font-weight: 900 !important; color: #fff !important; letter-spacing: -0.04em; line-height: 1.06; margin-bottom: 32px; font-family: var(--hh-font) !important; }
  .hh-manifesto-pull em { font-style: normal; color: var(--hh-green); }
  .hh-manifesto-body { font-size: 16px; color: rgba(255,255,255,0.52); line-height: 1.80; margin-bottom: 40px; font-family: var(--hh-font) !important; }

  .hh-manifesto-nums { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; }
  .hh-manifesto-num { background: rgba(255,255,255,0.025); padding: 22px 16px; text-align: center; }
  .hh-manifesto-num-val { font-size: 26px; font-weight: 900; color: #fff; display: block; font-family: var(--hh-font) !important; }
  .hh-manifesto-num-lbl { font-size: 10px; color: rgba(255,255,255,0.32); display: block; margin-top: 4px; font-family: var(--hh-font) !important; }

  .hh-mini-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 10px; }
  .hh-mini { background: var(--hh-carbon); border: 1px solid rgba(255,255,255,0.07); border-radius: 18px; padding: 22px 18px; display: flex; flex-direction: column; gap: 8px; }
  .hh-mini.span-2 { grid-column: 1/3; flex-direction: row; align-items: center; gap: 18px; }
  .hh-mini-img { width: 60px; height: 60px; object-fit: contain; border-radius: 10px; background: var(--hh-charcoal); padding: 6px; flex-shrink: 0; }
  .hh-mini-icon { font-size: 26px; }
  .hh-mini-name { font-size: 13px; font-weight: 800; color: #fff; font-family: var(--hh-font) !important; }
  .hh-mini-tag { font-size: 11px; color: rgba(255,255,255,0.38); font-family: var(--hh-font) !important; }
  .hh-mini-badge { background: var(--hh-green); color: #fff; font-size: 9px; font-weight: 800; padding: 3px 8px; border-radius: 6px; width: fit-content; font-family: var(--hh-font) !important; }

  /* ═══════════════════════════════
     5. BENTO FEATURES
     ═══════════════════════════════ */
  .hh-features { padding: 110px 0; background: var(--hh-snow); }
  .hh-features-bento { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 56px; }
  .hh-feat { background: var(--hh-white); border: 1px solid rgba(0,0,0,0.06); border-radius: 22px; padding: 30px 24px; transition: box-shadow 0.3s; }
  .hh-feat:hover { box-shadow: 0 12px 36px rgba(0,0,0,0.07); }
  .hh-feat.dark { background: var(--hh-black); border-color: rgba(255,255,255,0.06); }
  .hh-feat.span-2 { grid-column: span 2; }
  .hh-feat-icon { font-size: 30px; margin-bottom: 18px; }
  .hh-feat-line { font-size: 9px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--hh-green); margin-bottom: 6px; display: block; font-family: var(--hh-font) !important; }
  .hh-feat-name { font-size: 16px; font-weight: 900; color: var(--hh-black); margin-bottom: 8px; line-height: 1.25; font-family: var(--hh-font) !important; }
  .hh-feat.dark .hh-feat-name { color: #fff; }
  .hh-feat-desc { font-size: 13px; color: var(--hh-gray-mid); line-height: 1.6; font-family: var(--hh-font) !important; }
  .hh-feat.dark .hh-feat-desc { color: rgba(255,255,255,0.42); }

  /* ═══════════════════════════════
     6. REVIEWS
     ═══════════════════════════════ */
  .hh-reviews { padding: 110px 0; background: var(--hh-white); }
  .hh-reviews-hdr { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 56px; }
  .hh-tp-badge { display: flex; align-items: center; gap: 10px; background: var(--hh-slate); border-radius: 12px; padding: 10px 18px; }
  .hh-tp-stars { color: #00B67A; font-size: 18px; letter-spacing: 1px; }
  .hh-tp-name { font-size: 14px; font-weight: 800; font-family: var(--hh-font) !important; display: block; }
  .hh-tp-sub { font-size: 11px; color: var(--hh-gray-mid); font-family: var(--hh-font) !important; display: block; }

  .hh-reviews-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
  .hh-rv { background: var(--hh-slate); border-radius: 20px; padding: 26px; display: flex; flex-direction: column; gap: 14px; transition: box-shadow 0.2s; }
  .hh-rv:hover { box-shadow: 0 8px 28px rgba(0,0,0,0.06); }
  .hh-rv:first-child { background: var(--hh-black); }
  .hh-rv-stars { color: #00B67A; font-size: 14px; letter-spacing: 1px; }
  .hh-rv:first-child .hh-rv-stars { color: var(--hh-green); }
  .hh-rv-tag { display: inline-flex; align-items: center; gap: 5px; background: rgba(0,201,123,0.10); border-radius: 6px; padding: 3px 9px; font-size: 9px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--hh-green); width: fit-content; font-family: var(--hh-font) !important; }
  .hh-rv-quote { font-size: 14px; color: var(--hh-black); font-weight: 500; line-height: 1.65; flex: 1; font-family: var(--hh-font) !important; }
  .hh-rv:first-child .hh-rv-quote { color: rgba(255,255,255,0.85); }
  .hh-rv-author { display: flex; align-items: center; gap: 10px; }
  .hh-rv-av { width: 38px; height: 38px; border-radius: 50%; background: var(--hh-green); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; flex-shrink: 0; font-family: var(--hh-font) !important; }
  .hh-rv:first-child .hh-rv-av { background: rgba(255,255,255,0.10); }
  .hh-rv-name { font-size: 13px; font-weight: 800; color: var(--hh-black); font-family: var(--hh-font) !important; }
  .hh-rv:first-child .hh-rv-name { color: #fff; }
  .hh-rv-meta { font-size: 11px; color: var(--hh-gray-mid); font-family: var(--hh-font) !important; }
  .hh-rv:first-child .hh-rv-meta { color: rgba(255,255,255,0.32); }

  /* ═══════════════════════════════
     7. FAQ
     ═══════════════════════════════ */
  .hh-faq { padding: 90px 0; background: var(--hh-snow); }
  .hh-faq-body { max-width: 760px; margin: 52px auto 0; display: flex; flex-direction: column; gap: 10px; }
  .hh-faq-item { background: var(--hh-white); border: 1px solid rgba(0,0,0,0.06); border-radius: 14px; overflow: hidden; }
  .hh-faq-q { padding: 20px 22px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; gap: 14px; }
  .hh-faq-qt { font-size: 14px; font-weight: 800; color: var(--hh-black); flex: 1; font-family: var(--hh-font) !important; }
  .hh-faq-ico { width: 26px; height: 26px; border-radius: 50%; background: var(--hh-slate); display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--hh-black); flex-shrink: 0; transition: transform 0.3s, background 0.2s; }
  .hh-faq-item.open .hh-faq-ico { transform: rotate(45deg); background: var(--hh-green); color: #fff; }
