{% schema %}
{
  "name": "HALO Homepage",
  "settings": [
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link del Producto (HALO Loop)"
    }
  ],
  "presets": [
    {
      "name": "HALO Homepage",
      "category": "HALO"
    }
  ]
}
{% endschema %}

<!-- GOOGLE FONTS: Inter (Official HALO Tech Typography) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

{%- assign product = all_products['loop-band'] -%}

<style>
  :root {
    --h-bg: #030303;
    --h-surface: #09090b;
    --h-surface-light: #18181b;
    --h-cyan: #00ECFF;
    --h-green: #00C97B;
    --h-text-main: #FFFFFF;
    --h-text-muted: #94a3b8;
    --h-border: rgba(255,255,255,0.08);
    --font-family: 'Inter', sans-serif;
  }

  .halo-home {
    background: var(--h-bg);
    color: var(--h-text-main);
    font-family: var(--font-family);
    overflow-x: hidden;
  }

  /* Fade-In Scroll Animation Utility */
  .hh-fade-in {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hh-fade-in.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .halo-home h1, .halo-home h2, .halo-home h3, .halo-home h4 {
    font-family: var(--font-family);
    margin: 0;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .hh-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hh-tag {
    display: inline-block;
    font-family: var(--font-family);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--h-cyan);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
  }

  /* PREMIUM BUTTONS (Apple / Vercel Aesthetic) */
  .hh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF !important;
    border: 1px solid #FFFFFF !important;
    color: #000000 !important;
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 1rem;
    padding: 16px 36px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
    cursor: pointer;
  }
  .hh-btn:hover {
    background: #000000 !important;
    color: #FFFFFF !important;
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.2);
  }
  .hh-btn span {
    color: inherit !important;
    letter-spacing: -0.01em;
  }

  .hh-btn--secondary {
    background: transparent;
    border: 1px solid var(--h-border);
    color: #FFFFFF !important;
    box-shadow: none;
  }
  .hh-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #FFFFFF;
  }
  .hh-btn--secondary span {
    color: inherit !important;
  }

  /* ===== BLOCK 1: HERO (Glow Dynamic Transition) ===== */
  .hh-hero {
    position: relative;
    padding: 180px 0 120px;
    min-height: 95vh;
    display: flex;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }
  .hh-hero__bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 20%, rgba(0, 236, 255, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 20% 50%, rgba(0, 201, 123, 0.04) 0%, transparent 40%),
      var(--h-bg);
    z-index: 0;
  }
  .hh-hero__content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
  }
  .hh-hero h1 {
    font-size: clamp(3rem, 7vw, 5.2rem);
    font-weight: 800;
    margin-bottom: 28px;
    background: linear-gradient(180deg, #FFFFFF 30%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hh-hero p {
    font-size: 1.35rem;
    color: var(--h-text-muted);
    max-width: 720px;
    margin: 0 auto 44px;
    line-height: 1.6;
    font-weight: 400;
  }

  .hh-hero__stars {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 0.9rem;
    background: rgba(255,255,255,0.03);
    padding: 6px 16px;
    border-radius: 9999px;
    border: 1px solid var(--h-border);
  }
  .hh-hero__stars span {
    color: #FFFFFF !important;
  }
  .hh-stars {
    color: #FFC107;
  }

  /* SHOWCASE RENDER */
  .hh-showcase {
    margin-top: 80px;
    height: 480px;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(24,24,27,0.8) 0%, rgba(9,9,11,0.9) 100%);
    border: 1px solid var(--h-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 40px 80px rgba(0,0,0,0.8);
    overflow: hidden;
    backdrop-filter: blur(20px);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hh-showcase:hover {
    transform: scale(1.01);
  }
  .hh-showcase::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(0,236,255,0.05), transparent);
    transform: skewX(-20deg) translateX(-150%);
    animation: hh-shimmer 6s infinite;
  }

  /* ===== BLOCK 2: LOGO BAR ===== */
  .hh-logobar {
    padding: 60px 0;
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
    background: #0A0A0A;
    position: relative;
  }
  .hh-logobar::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--h-cyan), transparent);
    opacity: 0.3;
  }
  .hh-logobar__inner {
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    opacity: 0.4;
  }
  .hh-logobar__logo {
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  /* ===== BLOCK 3: PIVOTE (PROBLEM vs SOLUTION) ===== */
  .hh-split {
    padding: 140px 0;
    background: #141414;
    position: relative;
  }
  .hh-split--alt {
    background: #1F1F1F;
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
  }
  .hh-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
  }
  .hh-split h2 {
    font-size: 3.2rem;
    margin-bottom: 28px;
    font-weight: 800;
  }
  .hh-split p {
    font-size: 1.15rem;
    color: var(--h-text-muted);
    margin-bottom: 28px;
    line-height: 1.7;
  }
  .hh-split__img {
    height: 520px;
    border-radius: 24px;
    border: 1px solid var(--h-border);
    background: radial-gradient(circle at center, rgba(255,255,255,0.02) 0%, #09090b 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    transition: border-color 0.4s ease;
  }
  .hh-split__img:hover {
    border-color: rgba(0, 236, 255, 0.3);
  }

  /* ===== BLOCK 4: PITCH (SHOPPING GRID DIRECT) ===== */
  .hh-pitch {
    padding: 140px 0;
    background: #0A0A0A;
    border-bottom: 1px solid var(--h-border);
    text-align: center;
    position: relative;
  }
  .hh-pitch::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(0, 236, 255, 0.03) 0%, transparent 70%);
    pointer-events: none;
  }
  .hh-pitch h2 {
    font-size: 3.4rem;
    margin-bottom: 18px;
    font-weight: 800;
  }
  .hh-pitch__sub {
    color: var(--h-text-muted);
    font-size: 1.25rem;
    margin-bottom: 60px;
  }
  .hh-product-card {
    max-width: 900px;
    margin: 0 auto;
    background: rgba(24, 24, 27, 0.4);
    border: 1px solid var(--h-border);
    border-radius: 32px;
    padding: 50px;
    text-align: left;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    align-items: center;
    backdrop-filter: blur(10px);
  }
  .hh-product-gallery {
    background: #030303;
    border-radius: 20px;
    height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--h-border);
    position: relative;
    overflow: hidden;
  }
  .hh-product-gallery::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 236, 255, 0.1) 0%, transparent 60%);
  }
  .hh-price-stack {
    margin: 20px 0 30px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .hh-price-current {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--h-cyan);
  }
  .hh-price-compare {
    font-size: 1.5rem;
    text-decoration: line-through;
    color: var(--h-text-muted);
  }

  /* ===== BLOCK 5: LA CONEXIÓN (MANIFESTO) ===== */
  .hh-manifesto {
    padding: 160px 0;
    background: #141414;
    text-align: center;
    position: relative;
  }
  .hh-manifesto__inner {
    max-width: 850px;
    margin: 0 auto;
  }
  .hh-manifesto h2 {
    font-size: 3.6rem;
    margin-bottom: 44px;
    font-weight: 800;
  }
  .hh-manifesto p {
    font-size: 1.4rem;
    line-height: 1.8;
    color: var(--h-text-muted);
    margin-bottom: 36px;
    font-weight: 300;
  }
  .hh-signature {
    margin-top: 60px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--h-cyan);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ===== BLOCK 6: TRUSTPILOT MARQUEE ===== */
  .hh-trust {
    padding: 120px 0;
    background: #1F1F1F;
    overflow: hidden;
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
  }
  .hh-trust h2 { text-align: center; font-size: 2.8rem; margin-bottom: 60px; font-weight: 800; }
  .hh-marquee-wrapper {
    display: flex;
    overflow: hidden;
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }
  .hh-marquee {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: hh-scroll 40s linear infinite;
  }
  .hh-marquee:hover { animation-play-state: paused; }
  .hh-review {
    width: 400px;
    background: rgba(24, 24, 27, 0.6);
    border: 1px solid var(--h-border);
    border-radius: 24px;
    padding: 36px;
    backdrop-filter: blur(10px);
  }
  .hh-review__stars { color: #00B67A; font-size: 1.2rem; margin-bottom: 18px; }
  .hh-review__title { font-weight: 800; font-size: 1.2rem; margin-bottom: 12px; }
  .hh-review__body { font-size: 1rem; color: var(--h-text-muted); margin-bottom: 24px; line-height: 1.6; }
  .hh-review__author { font-size: 0.85rem; font-weight: 700; color: #fff; }

  /* ===== BLOCK 7: FAQS & CLOSING ===== */
  .hh-closing {
    padding: 140px 0;
    background: #0A0A0A;
  }
  .hh-faq-grid {
    max-width: 850px;
    margin: 0 auto 100px;
  }
  .hh-faq-item {
    border-bottom: 1px solid var(--h-border);
    padding: 28px 0;
  }
  .hh-faq-question {
    font-size: 1.35rem;
    font-weight: 700;
    color: #FFFFFF !important;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }
  .hh-faq-question:hover {
    color: var(--h-cyan);
  }
  .hh-faq-answer {
    margin-top: 20px;
    font-size: 1.05rem;
    color: #FFFFFF !important;
    line-height: 1.7;
    display: none;
  }
  .hh-faq-item[open] .hh-faq-answer {
    display: block;
  }
  .hh-faq-toggle::after {
    content: '+';
    font-size: 1.5rem;
    transition: transform 0.3s ease;
  }
  .hh-faq-item[open] .hh-faq-toggle::after {
    content: '−';
  }

  .hh-guarantee-box {
    max-width: 900px;
    margin: 0 auto;
    background: radial-gradient(circle at top left, rgba(0, 236, 255, 0.03) 0%, rgba(9, 9, 11, 0.8) 100%);
    border: 1px solid rgba(0, 236, 255, 0.2);
    border-radius: 32px;
    padding: 60px 40px;
    text-align: center;
    box-shadow: 0 40px 80px rgba(0,0,0,0.6);
  }
  .hh-guarantee-box h3 {
    font-size: 2.4rem;
    color: #FFFFFF;
    margin-bottom: 24px;
    font-weight: 800;
  }

  .hh-features-row {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    font-size: 0.95rem;
    color: #FFFFFF !important;
    font-weight: 600;
  }
  .hh-features-row span {
    color: #FFFFFF !important;
  }

  @keyframes hh-shimmer {
    0% { transform: skewX(-20deg) translateX(-150%); }
    50%, 100% { transform: skewX(-20deg) translateX(150%); }
  }

  @keyframes hh-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .hh-split__grid, .hh-product-card { grid-template-columns: 1fr; gap: 50px; }
    .hh-hero h1 { font-size: 2.8rem; }
    .hh-split__img, .hh-product-gallery { height: 340px; }
    .hh-manifesto h2 { font-size: 2.6rem; }
  }
</style>

<div class="halo-home">

  <!-- BLOQUE 1: GANCHO (HERO) -->
  <section class="hh-hero">
    <div class="hh-hero__bg"></div>
    <div class="hh-wrap hh-hero__content hh-fade-in" id="hero-content">
      <div class="hh-hero__stars">
        <span class="hh-stars">★★★★★</span>
        <span>4.9/5 de más de 12,000 atletas</span>
      </div>
      <br>
      <span class="hh-tag">El Estándar Biométrico</span>
      <h1>Te despiertas cansado porque no has sabido leer tu descanso profundo.</h1>
      <p>Dormir no es lo mismo que descansar. Optimiza tu recuperación y descansa mejor desde la primera noche con LOOP.</p>
      
      <a href="#comprar" class="hh-btn">
        <span>CONSEGUIR TU LOOP BAND</span>
      </a>

      <div class="hh-showcase hh-hero-visual">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,236,255,0.4)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span style="font-size:1.1rem; color:rgba(255,255,255,0.7); margin-top:16px; font-weight: 600;">RENDER: LOOP BAND (TECNOLOGÍA INVISIBLE)</span>
      </div>
    </div>
  </section>

  <!-- BLOQUE 2: CONFÍAN EN NOSOTROS (LOGOS) -->
  <section class="hh-logobar">
    <div class="hh-wrap">
      <div class="hh-logobar__inner">
        <div class="hh-logobar__logo">GQ</div>
        <div class="hh-logobar__logo">MEN'S HEALTH</div>
        <div class="hh-logobar__logo">FORBES</div>
        <div class="hh-logobar__logo">WIRED</div>
      </div>
    </div>
  </section>

  <!-- BLOQUE 3: EL PIVOTE (PROBLEMA VS SOLUCIÓN) -->
  <section class="hh-split">
    <div class="hh-wrap hh-split__grid hh-fade-in">
      <div>
        <span class="hh-tag" style="color: #FFFFFF;">El Problema Actual</span>
        <h2>Tu smartwatch es un juguete de notificaciones, no un sensor clínico.</h2>
        <p>Te despiertas, miras el reloj y dejas que un algoritmo adivine tu cansancio. Pero sigues tomando decisiones basándote en sensaciones vagas.</p>
        <p>Los atletas de élite no adivinan su variabilidad de la frecuencia cardíaca (HRV) ni dejan su ciclo de sueño profundo al azar. Entrenar y vivir sin conocer tu estado de recuperación es garantizar un desgaste continuo.</p>
        <a href="#comprar" class="hh-btn hh-btn--secondary">
          <span>Ver Diferencia</span>
        </a>
      </div>
      <div class="hh-split__img" style="border-color: rgba(255,255,255,0.12);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span style="font-size:1.1rem; color:rgba(255,255,255,0.7); margin-top:16px; font-weight: 600;">DISEÑO SIN PANTALLA NI DISTRACCIONES</span>
      </div>
    </div>
  </section>

  <section class="hh-split hh-split--alt">
    <div class="hh-wrap hh-split__grid hh-fade-in">
      <div class="hh-split__img">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,201,123,0.3)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span style="font-size:1.1rem; color:rgba(255,255,255,0.7); margin-top:16px; font-weight: 600;">ECOSISTEMA DE ANÁLISIS CLÍNICO</span>
      </div>
      <div>
        <span class="hh-tag">La Solución HALO</span>
        <h2>Para medirte no tienes que distraerte.</h2>
        <p>La tecnología médica debe adaptarse a ti, no tú a ella. La <strong>Loop Band®</strong> recolecta tus biomarcadores esenciales en total silencio físico y mental.</p>
        <ul style="list-style: none; padding: 0; margin-top: 24px;">
          <li style="margin-bottom: 12px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="color: var(--h-green); font-weight: bold;">✓</span>
            <span style="color: var(--h-text-muted);">Precisión clínica de HRV, SpO2 y ondas de sueño.</span>
          </li>
          <li style="margin-bottom: 12px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="color: var(--h-green); font-weight: bold;">✓</span>
            <span style="color: var(--h-text-muted);">Sin cuotas mensuales. Tus datos te pertenecen para siempre.</span>
          </li>
          <li style="margin-bottom: 12px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="color: var(--h-green); font-weight: bold;">✓</span>
            <span style="color: var(--h-text-muted);">Batería imperceptible de carga continua.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- BLOQUE 4: EL PITCH (COMPRA DIRECTA) -->
  <section class="hh-pitch" id="comprar">
    <div class="hh-wrap hh-fade-in">
      <span class="hh-tag">Oferta Exclusiva</span>
      <h2>Adquiere tu LOOP Band</h2>
      <p class="hh-pitch__sub">Desbloquea tu potencial biométrico con un solo pago. Sin suscripciones.</p>

      <div class="hh-product-card">
        <div class="hh-product-gallery">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
        <div>
          <h3 style="font-size: 2rem; margin-bottom: 12px; font-weight: 800;">LOOP Band® Classic</h3>
          <p style="color: var(--h-text-muted); font-size: 1rem; line-height: 1.5;">Incluye sensor de grado médico, banda textil de alta resistencia y cargador inalámbrico.</p>
          
          <div class="hh-price-stack">
            <span class="hh-price-current">{% if product %}{{ product.price | money }}{% else %}$149.00{% endif %}</span>
            <span class="hh-price-compare">{% if product %}{{ product.compare_at_price | money }}{% else %}$199.00{% endif %}</span>
          </div>

          {% if product %}
            <form method="post" action="/cart/add" enctype="multipart/form-data">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
              <button type="submit" class="hh-btn" style="width: 100%;">
                <span>AÑADIR AL CARRITO</span>
              </button>
            </form>
          {% else %}
            <a href="{{ section.settings.cta_url | default: '#' }}" class="hh-btn" style="width: 100%;">
              <span>COMPRAR AHORA</span>
            </a>
          {% endif %}

          <div style="margin-top: 24px; font-size: 0.9rem; color: var(--h-text-muted); display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-weight: 500;">
            <div>✓ Envío gratuito exprés</div>
            <div>✓ Garantía contra defectos</div>
