{% endschema %}

<!-- GOOGLE FONTS -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --h-bg: #030303;
    --h-surface: #0A0A0A;
    --h-surface-light: #141414;
    --h-cyan: #00ECFF;
    --h-green: #00C97B;
    --h-text-main: #FFFFFF;
    --h-text-muted: #A0AAB5;
    --h-border: rgba(255,255,255,0.08);
  }

  .halo-home {
    background: var(--h-bg);
    color: var(--h-text-main);
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
  }

  .halo-home h1, .halo-home h2, .halo-home h3, .halo-home h4 {
    font-family: 'Inter', sans-serif;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hh-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hh-tag {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--h-cyan);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
  }

  .hh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--h-green);
    color: #000;
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 201, 123, 0.3);
  }
  .hh-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(0, 201, 123, 0.5);
  }
  .hh-btn span { color: #000 !important; }

  /* ===== HERO SECTION ===== */
  .hh-hero {
    position: relative;
    padding: 120px 0 80px;
    min-height: 90vh;
    display: flex;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }
  .hh-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center 20%, rgba(0,236,255,0.08) 0%, var(--h-bg) 60%);
    z-index: 0;
  }
  .hh-hero__content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }
  .hh-hero h1 {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    background: linear-gradient(180deg, #FFFFFF 0%, #A0AAB5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hh-hero p {
    font-size: 1.2rem;
    color: var(--h-text-muted);
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.6;
  }

  /* PREMIUM PLACEHOLDER */
  .hh-placeholder {
    width: 100%;
    border-radius: 24px;
    background: linear-gradient(145deg, #111 0%, #050505 100%);
    border: 1px solid var(--h-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }
  .hh-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.03), transparent);
    transform: skewX(-20deg) translateX(-150%);
    animation: hh-shimmer 4s infinite;
  }
  @keyframes hh-shimmer {
    0% { transform: skewX(-20deg) translateX(-150%); }
    50%, 100% { transform: skewX(-20deg) translateX(150%); }
  }

  .hh-hero-visual {
    margin-top: 60px;
    height: 400px;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    border-color: rgba(0,236,255,0.15);
  }

  /* ===== LOGO BAR ===== */
  .hh-logobar {
    padding: 40px 0;
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
    background: #0A0A0A; /* ZONA: Gris ultra oscuro */
  }
  .hh-logobar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
    opacity: 0.5;
  }
  .hh-logobar__logo {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ===== PAIN & SOLUTION ===== */
  .hh-split {
    padding: 100px 0;
    background: #030303; /* ZONA: Negro profundo */
  }
  .hh-split--alt {
    background: #0A0A0A; /* ZONA: Gris ultra oscuro */
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
  }
  .hh-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .hh-split h2 {
    font-size: 2.5rem;
    margin-bottom: 24px;
  }
  .hh-split p {
    font-size: 1.1rem;
    color: var(--h-text-muted);
    margin-bottom: 24px;
    line-height: 1.7;
  }
  .hh-split__img {
    height: 500px;
    border-color: rgba(0,201,123,0.15);
  }

  /* ===== TRUSTPILOT CAROUSEL ===== */
  .hh-trust {
    padding: 80px 0;
    background: #141414; /* ZONA: Gris intermedio */
    overflow: hidden;
  }
  .hh-trust h2 { text-align: center; font-size: 2rem; margin-bottom: 40px; }
  .hh-marquee {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: hh-scroll 30s linear infinite;
  }
  .hh-marquee:hover { animation-play-state: paused; }
  @keyframes hh-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .hh-review {
    width: 350px;
    background: #1F1F1F; /* Tarjetas más claras para contraste */
    border: 1px solid var(--h-border);
    border-radius: 16px;
    padding: 24px;
  }
  .hh-review__stars { color: #00B67A; font-size: 1.2rem; margin-bottom: 12px; }
  .hh-review__title { font-weight: 700; font-size: 1.1rem; margin-bottom: 8px; font-family: 'Inter', sans-serif; }
  .hh-review__body { font-size: 0.95rem; color: var(--h-text-muted); margin-bottom: 16px; line-height: 1.5; }
  .hh-review__author { font-size: 0.85rem; font-weight: 700; color: #fff; }

  /* ===== CTA FINAL ===== */
  .hh-cta-section {
    padding: 100px 0;
    text-align: center;
    background: #030303; /* ZONA: Negro profundo */
    position: relative;
  }
  .hh-cta-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0,201,123,0.08) 0%, transparent 60%);
    pointer-events: none;
  }
  .hh-cta-section h2 { font-size: 3rem; margin-bottom: 24px; position: relative; z-index: 1; }
  .hh-cta-section p, .hh-cta-section .hh-btn, .hh-cta-section .hh-features { position: relative; z-index: 1; }
  
  /* ===== GLOBAL OVERRIDES FOR HOMEPAGE (CONTRAST FIX) ===== */
  #shopify-section-footer, #shopify-section-subfooter, .footer, .subfooter {
    background-color: #0A0A0A !important;
    color: #A0AAB5 !important;
    border-top: 1px solid rgba(255,255,255,0.08) !important;
  }
  #shopify-section-footer a, #shopify-section-subfooter a, .footer a, .subfooter a {
    color: #FFFFFF !important;
  }
  .footer__block h4, .footer h4, .subfooter h4 {
    color: #FFFFFF !important;
  }

  @media (max-width: 768px) {
    .hh-split__grid { grid-template-columns: 1fr; gap: 40px; }
    .hh-hero h1 { font-size: 2.5rem; }
    .hh-split__img { height: 350px; }
  }
</style>

