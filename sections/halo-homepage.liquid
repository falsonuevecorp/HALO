{% schema %}
{
  "name": "HALO Homepage",
  "settings": [],
  "presets": [
    {
      "name": "HALO Homepage",
      "category": "HALO"
    }
  ]
}
{% endschema %}

<!-- GOOGLE FONTS: Fredoka (Headings) & Nunito (Body) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">

{%- assign product = all_products['loop-band'] -%}

<style>
  :root {
    --h-bg: #030303;
    --h-surface: #0A0A0A;
    --h-surface-light: #141414;
    --h-cyan: #00ECFF;
    --h-green: #00C97B;
    --h-text-main: #FFFFFF;
    --h-text-muted: #A0AAB5;
    --h-border: rgba(255,255,255,0.06);
    --font-heading: 'Fredoka', sans-serif;
    --font-body: 'Nunito', sans-serif;
  }

  .halo-home {
    background: var(--h-bg);
    color: var(--h-text-main);
    font-family: var(--font-body);
    overflow-x: hidden;
  }

  .halo-home h1, .halo-home h2, .halo-home h3, .halo-home h4 {
    font-family: var(--font-heading);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .hh-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hh-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--h-cyan);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
  }

  /* PREMIUM BUTTONS */
  .hh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border: none;
    color: #000000 !important;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    padding: 16px 36px;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
    cursor: pointer;
  }
  .hh-btn:hover {
    background: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.25);
  }
  .hh-btn span {
    color: #000000 !important;
    letter-spacing: 0.02em;
  }

  .hh-btn--secondary {
    background: rgba(0, 236, 255, 0.05);
    border: 1px solid rgba(0, 236, 255, 0.25);
    color: var(--h-cyan) !important;
    box-shadow: none;
  }
  .hh-btn--secondary:hover {
    background: rgba(0, 236, 255, 0.1);
    border-color: var(--h-cyan);
    box-shadow: 0 4px 15px rgba(0, 236, 255, 0.15);
  }
  .hh-btn--secondary span {
    color: var(--h-cyan) !important;
  }

  /* ===== BLOCK 1: HERO ===== */
  .hh-hero {
    position: relative;
    padding: 140px 0 100px;
    min-height: 95vh;
    display: flex;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }
  .hh-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center 15%, rgba(0,236,255,0.06) 0%, rgba(0,201,123,0.02) 40%, var(--h-bg) 75%);
    z-index: 0;
  }
  .hh-hero__content {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: 0 auto;
  }
  .hh-hero h1 {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 700;
    margin-bottom: 24px;
    background: linear-gradient(180deg, #FFFFFF 0%, #A0AAB5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hh-hero p {
    font-size: 1.25rem;
    color: var(--h-text-muted);
    max-width: 680px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  .hh-hero__stars {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }
  .hh-stars {
    color: #FFC107;
  }

  /* PLACEHOLDER / SHOWCASE RENDER */
  .hh-showcase {
    margin-top: 60px;
    height: 420px;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 28px;
    background: linear-gradient(145deg, #0d0d0d 0%, #050505 100%);
    border: 1px solid var(--h-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 30px 60px rgba(0,0,0,0.6);
    overflow: hidden;
  }
  .hh-showcase::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.02), transparent);
    transform: skewX(-20deg) translateX(-150%);
    animation: hh-shimmer 5s infinite;
  }

  /* ===== BLOCK 2: LOGO BAR ===== */
  .hh-logobar {
    padding: 45px 0;
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
    background: #060606;
  }
  .hh-logobar__inner {
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    opacity: 0.45;
  }
  .hh-logobar__logo {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  /* ===== BLOCK 3: PIVOTE (PROBLEM vs SOLUTION) ===== */
  .hh-split {
    padding: 120px 0;
    background: var(--h-bg);
  }
  .hh-split--alt {
    background: var(--h-surface);
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
  }
  .hh-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .hh-split h2 {
    font-size: 2.6rem;
    margin-bottom: 24px;
    font-weight: 700;
  }
  .hh-split p {
    font-size: 1.1rem;
    color: var(--h-text-muted);
    margin-bottom: 24px;
    line-height: 1.7;
  }
  .hh-split__img {
    height: 480px;
    border-radius: 24px;
    border: 1px solid var(--h-border);
    background: #070707;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* ===== BLOCK 4: PITCH (SHOPPING GRID DIRECT) ===== */
  .hh-pitch {
    padding: 120px 0;
    background: var(--h-surface-light);
    border-bottom: 1px solid var(--h-border);
    text-align: center;
  }
  .hh-pitch h2 {
    font-size: 2.8rem;
    margin-bottom: 16px;
  }
  .hh-pitch__sub {
    color: var(--h-text-muted);
    font-size: 1.2rem;
    margin-bottom: 50px;
  }
  .hh-product-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--h-surface);
    border: 1px solid var(--h-border);
    border-radius: 28px;
    padding: 40px;
    text-align: left;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: center;
  }
  .hh-product-gallery {
    background: #030303;
    border-radius: 20px;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--h-border);
  }
  .hh-price-stack {
    margin: 15px 0 25px;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .hh-price-current {
    font-size: 2.2rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--h-green);
  }
  .hh-price-compare {
    font-size: 1.4rem;
    text-decoration: line-through;
    color: var(--h-text-muted);
  }

  /* ===== BLOCK 5: LA CONEXIÓN (MANIFESTO) ===== */
  .hh-manifesto {
    padding: 140px 0;
    background: var(--h-bg);
    text-align: center;
  }
  .hh-manifesto__inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .hh-manifesto h2 {
    font-size: 3rem;
    margin-bottom: 40px;
  }
  .hh-manifesto p {
    font-size: 1.3rem;
    line-height: 1.8;
    color: var(--h-text-muted);
    margin-bottom: 30px;
  }
  .hh-signature {
    margin-top: 50px;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--h-cyan);
    letter-spacing: 0.05em;
  }

  /* ===== BLOCK 6: TRUSTPILOT MARQUEE ===== */
  .hh-trust {
    padding: 100px 0;
    background: var(--h-surface);
    overflow: hidden;
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
  }
  .hh-trust h2 { text-align: center; font-size: 2.5rem; margin-bottom: 50px; }
  .hh-marquee-wrapper {
    display: flex;
    overflow: hidden;
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }
  .hh-marquee {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: hh-scroll 35s linear infinite;
  }
  .hh-marquee:hover { animation-play-state: paused; }
  .hh-review {
    width: 380px;
    background: var(--h-surface-light);
    border: 1px solid var(--h-border);
    border-radius: 20px;
    padding: 30px;
  }
  .hh-review__stars { color: #00B67A; font-size: 1.25rem; margin-bottom: 16px; }
  .hh-review__title { font-weight: 700; font-size: 1.15rem; margin-bottom: 10px; font-family: var(--font-heading); }
  .hh-review__body { font-size: 0.95rem; color: var(--h-text-muted); margin-bottom: 20px; line-height: 1.6; }
  .hh-review__author { font-size: 0.85rem; font-weight: 700; color: #fff; }

  /* ===== BLOCK 7: FAQS & CLOSING ===== */
  .hh-closing {
    padding: 120px 0;
    background: var(--h-bg);
  }
  .hh-faq-grid {
    max-width: 800px;
    margin: 0 auto 80px;
  }
  .hh-faq-item {
    border-bottom: 1px solid var(--h-border);
    padding: 24px 0;
  }
  .hh-faq-question {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hh-faq-answer {
    margin-top: 15px;
    font-size: 1rem;
    color: var(--h-text-muted);
    line-height: 1.6;
    display: none;
  }
  .hh-faq-item[open] .hh-faq-answer {
    display: block;
  }
  .hh-faq-toggle::after {
    content: '+';
    font-size: 1.4rem;
  }
  .hh-faq-item[open] .hh-faq-toggle::after {
    content: '−';
  }

  .hh-guarantee-box {
    max-width: 800px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(0, 236, 255, 0.02) 0%, rgba(0, 201, 123, 0.02) 100%);
    border: 1px solid rgba(0, 236, 255, 0.15);
    border-radius: 28px;
    padding: 50px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
  }
  .hh-guarantee-box h3 {
    font-size: 2rem;
    color: var(--h-cyan);
    margin-bottom: 20px;
  }

  .hh-features-row {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    font-size: 0.95rem;
    color: #FFFFFF !important;
    font-weight: 600;
  }
  .hh-features-row span {
    color: #FFFFFF !important;
  }

  /* GLOBAL OVERRIDES */
  #shopify-section-footer, #shopify-section-subfooter, .footer, .subfooter {
    background-color: #0A0A0A !important;
    color: #A0AAB5 !important;
    border-top: 1px solid rgba(255,255,255,0.08) !important;
  }
  #shopify-section-footer a, #shopify-section-subfooter a, .footer a, .subfooter a {
    color: #FFFFFF !important;
  }
  .footer__block h4, .footer h4, .subfooter h4 {
    color: #FFFFFF !important;
  }

  @keyframes hh-shimmer {
    0% { transform: skewX(-20deg) translateX(-150%); }
    50%, 100% { transform: skewX(-20deg) translateX(150%); }
  }

  @keyframes hh-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .hh-split__grid, .hh-product-card { grid-template-columns: 1fr; gap: 40px; }
    .hh-hero h1 { font-size: 2.4rem; }
    .hh-split__img, .hh-product-gallery { height: 320px; }
    .hh-manifesto h2 { font-size: 2.2rem; }
  }
</style>

<div class="halo-home">

  <!-- BLOQUE 1: GANCHO (HERO) -->
  <section class="hh-hero">
    <div class="hh-hero__bg"></div>
    <div class="hh-wrap hh-hero__content">
      <div class="hh-hero__stars">
        <span class="hh-stars">★★★★★</span>
        <span>4.9/5 de más de 12,000 atletas</span>
      </div>
      <span class="hh-tag">El Estándar Biométrico</span>
      <h1>Te despiertas cansado porque no has sabido leer tu descanso profundo.</h1>
      <p>Dormir no es lo mismo que descansar. Optimiza tu recuperación y descansa mejor desde la primera noche con LOOP.</p>
      
      <a href="#comprar" class="hh-btn">
        <span>CONSEGUIR TU LOOP BAND</span>
      </a>

      <div class="hh-showcase hh-hero-visual">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,236,255,0.4)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span style="font-family:var(--font-heading); font-size:1.1rem; color:rgba(255,255,255,0.7); margin-top:16px;">RENDER: LOOP BAND (TECNOLOGÍA INVISIBLE)</span>
      </div>
    </div>
  </section>

  <!-- BLOQUE 2: CONFÍAN EN NOSOTROS (LOGOS) -->
  <section class="hh-logobar">
    <div class="hh-wrap">
      <div class="hh-logobar__inner">
        <div class="hh-logobar__logo">GQ</div>
        <div class="hh-logobar__logo">MEN'S HEALTH</div>
        <div class="hh-logobar__logo">FORBES</div>
        <div class="hh-logobar__logo">WIRED</div>
      </div>
    </div>
  </section>

  <!-- BLOQUE 3: EL PIVOTE (PROBLEMA VS SOLUCIÓN) -->
  <section class="hh-split">
    <div class="hh-wrap hh-split__grid">
      <div>
        <span class="hh-tag" style="color: #FF6B6B;">El Problema Actual</span>
        <h2>Tu smartwatch es un juguete de notificaciones, no un sensor clínico.</h2>
        <p>Te despiertas, miras el reloj y dejas que un algoritmo adivine tu cansancio. Pero sigues tomando decisiones basándote en sensaciones vagas.</p>
        <p>Los atletas de élite no adivinan su variabilidad de la frecuencia cardíaca (HRV) ni dejan su ciclo de sueño profundo al azar. Entrenar y vivir sin conocer tu estado de recuperación es garantizar un desgaste continuo.</p>
        <a href="#comprar" class="hh-btn hh-btn--secondary">
          <span>Ver Diferencia</span>
        </a>
      </div>
      <div class="hh-split__img" style="border-color: rgba(255,107,107,0.12);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,107,107,0.3)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span style="font-family:var(--font-heading); font-size:1.1rem; color:rgba(255,255,255,0.7); margin-top:16px;">DISEÑO SIN PANTALLA NI DISTRACCIONES</span>
      </div>
    </div>
  </section>

  <section class="hh-split hh-split--alt">
    <div class="hh-wrap hh-split__grid">
      <div class="hh-split__img">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,201,123,0.3)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span style="font-family:var(--font-heading); font-size:1.1rem; color:rgba(255,255,255,0.7); margin-top:16px;">ECOSISTEMA DE ANÁLISIS CLÍNICO</span>
      </div>
      <div>
        <span class="hh-tag">La Solución HALO</span>
        <h2>Para medirte no tienes que distraerte.</h2>
        <p>La tecnología médica debe adaptarse a ti, no tú a ella. La <strong>Loop Band®</strong> recolecta tus biomarcadores esenciales en total silencio físico y mental.</p>
        <ul style="list-style: none; padding: 0; margin-top: 24px;">
          <li style="margin-bottom: 12px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="color: var(--h-green); font-weight: bold;">✓</span>
            <span style="color: var(--h-text-muted);">Precisión clínica de HRV, SpO2 y ondas de sueño.</span>
          </li>
          <li style="margin-bottom: 12px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="color: var(--h-green); font-weight: bold;">✓</span>
            <span style="color: var(--h-text-muted);">Sin cuotas mensuales. Tus datos te pertenecen para siempre.</span>
          </li>
          <li style="margin-bottom: 12px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="color: var(--h-green); font-weight: bold;">✓</span>
            <span style="color: var(--h-text-muted);">Batería imperceptible de carga continua.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- BLOQUE 4: EL PITCH (COMPRA DIRECTA) -->
  <section class="hh-pitch" id="comprar">
    <div class="hh-wrap">
      <span class="hh-tag">Oferta Exclusiva</span>
      <h2>Adquiere tu LOOP Band</h2>
      <p class="hh-pitch__sub">Desbloquea tu potencial biométrico con un solo pago. Sin suscripciones.</p>

      <div class="hh-product-card">
        <div class="hh-product-gallery">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
        <div>
          <h3 style="font-size: 1.8rem; margin-bottom: 8px;">LOOP Band® Classic</h3>
          <p style="color: var(--h-text-muted); font-size: 0.95rem;">Incluye sensor de grado médico, banda textil de alta resistencia y cargador inalámbrico.</p>
          
          <div class="hh-price-stack">
            <span class="hh-price-current">{% if product %}{{ product.price | money }}{% else %}$149.00{% endif %}</span>
            <span class="hh-price-compare">{% if product %}{{ product.compare_at_price | money }}{% else %}$199.00{% endif %}</span>
          </div>

          {% if product %}
            <form method="post" action="/cart/add" enctype="multipart/form-data">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
              <button type="submit" class="hh-btn" style="width: 100%;">
                <span>AÑADIR AL CARRITO</span>
              </button>
            </form>
          {% else %}
            <a href="/products/loop-band" class="hh-btn" style="width: 100%;">
              <span>COMPRAR AHORA</span>
            </a>
          {% endif %}

          <div style="margin-top: 20px; font-size: 0.85rem; color: var(--h-text-muted); display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <div>✓ Envío gratuito exprés</div>
            <div>✓ Garantía de 60 noches</div>
            <div>✓ App incluida de por vida</div>
            <div>✓ Soporte prioritario 24/7</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOQUE 5: LA CONEXIÓN (MANIFIESTO) -->
  <section class="hh-manifesto">
    <div class="hh-wrap hh-manifesto__inner">
      <span class="hh-tag">Manifiesto HALO</span>
      <h2>El secuestro de tus propios datos de salud.</h2>
      <p>Nos negamos a aceptar que las corporaciones te cobren una renta mensual por decirte cómo latió tu corazón anoche. Pagas por el sensor, pagas por el diseño y luego te obligan a pagar para ver tu propio HRV.</p>
      <p>Creamos HALO para devolverle el control al atleta. Sin pantallas táctiles que exijan tu atención, sin notificaciones que disparen tu cortisol, y bajo una premisa firme: pagas una vez, y tus datos médicos son tuyos de por vida.</p>
      <div class="hh-signature">DISEÑADO PARA EL RENDIMIENTO SILENCIOSO</div>
    </div>
  </section>

  <!-- BLOQUE 6: TRUSTPILOT MARQUEE -->
  <section class="hh-trust">
    <h2>Avalado por Atletas Reales</h2>
    <div class="hh-marquee-wrapper">
      <div class="hh-marquee">
        <!-- GRUPO 1 -->
        <div class="hh-review">
          <div class="hh-review__stars">★★★★★</div>
          <div class="hh-review__title">Descanso medible real</div>
          <div class="hh-review__body">"Me despertaba cansado a pesar de dormir 8 horas. Con Loop entendí que mi fase profunda era casi nula por cenar tarde. Cambio radical."</div>
          <div class="hh-review__author">Carlos M. - Atleta</div>
        </div>
        <div class="hh-review">
