<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* =====================================================
   HALO® — BRAND HOMEPAGE v3.0 "Grandes Marcas"
   Arquitectura: Apple / Away / Rimowa / Patagonia
   Protocolo HALO Pure Grayscale (Regla 39)
   ===================================================== */

  .halo-home {
    --hh-white:      #FFFFFF;
    --hh-snow:       #FAF9F6;
    --hh-slate:      #F4F4F5;
    --hh-gray-light: #ECECEE;
    --hh-gray-mid:   #71717A;
    --hh-gray-dark:  #52525B;
    --hh-black:      #0A0A0A;
    --hh-carbon:     #121214;
    --hh-charcoal:   #18181B;
    --hh-green:      #00C97B;
    --hh-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-family: var(--hh-font);
    -webkit-font-smoothing: antialiased;
    background: var(--hh-white);
    color: var(--hh-black);
    overflow-x: hidden;
  }

  .halo-home * { box-sizing: border-box; margin: 0; padding: 0; }
  .halo-home a { text-decoration: none; color: inherit; }
  .halo-home img { display: block; max-width: 100%; }

  .hh-wrap { max-width: 1280px; margin: 0 auto; padding: 0 32px; }

  /* ── BUTTONS ── */
  .hh-btn-solid {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--hh-black); color: #fff !important;
    font-family: var(--hh-font) !important;
    font-size: 14px; font-weight: 700; letter-spacing: 0.01em;
    padding: 14px 28px; border-radius: 9999px;
    transition: opacity 0.2s; border: none; cursor: pointer;
  }
  .hh-btn-solid:hover { opacity: 0.82; }

  .hh-btn-green {
    background: var(--hh-green) !important; color: #fff !important;
    box-shadow: 0 6px 20px rgba(0,201,123,0.30);
  }
  .hh-btn-green:hover { box-shadow: 0 10px 28px rgba(0,201,123,0.45); opacity: 1; }

  .hh-btn-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: var(--hh-black) !important;
    font-family: var(--hh-font) !important;
    font-size: 14px; font-weight: 700;
    padding: 13px 28px; border-radius: 9999px;
    border: 1.5px solid rgba(0,0,0,0.18);
    transition: background 0.2s, border-color 0.2s; cursor: pointer;
  }
  .hh-btn-outline:hover { background: var(--hh-slate); border-color: var(--hh-black); }

  /* ════════════════════════════════════════
     1. HERO — Declaración de Marca (Full Width)
     ════════════════════════════════════════ */
  .hh-hero {
    position: relative;
    background: var(--hh-black);
    min-height: 92vh;
    display: flex; align-items: center;
    overflow: hidden;
  }

  .hh-hero-bg-text {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(140px, 22vw, 280px);
    font-weight: 900;
    color: rgba(255,255,255,0.025);
    letter-spacing: -0.06em;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    z-index: 0;
  }

  .hh-hero-inner {
    position: relative; z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: center;
  }

  .hh-hero-label {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(0,201,123,0.12);
    border: 1px solid rgba(0,201,123,0.3);
    border-radius: 9999px;
    padding: 5px 14px;
    margin-bottom: 28px;
  }
  .hh-hero-label-dot {
    width: 6px; height: 6px;
    background: var(--hh-green); border-radius: 50%;
    animation: pulse-green 2s infinite;
  }
  @keyframes pulse-green {
    0%,100% { opacity:1; transform: scale(1); }
    50% { opacity:0.6; transform: scale(1.4); }
  }
  .hh-hero-label-text {
    font-size: 11px; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--hh-green);
    font-family: var(--hh-font) !important;
  }

  .hh-hero-title {
    font-size: clamp(3rem, 5.5vw, 5.2rem) !important;
    font-weight: 900 !important;
    color: #FFFFFF !important;
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: 24px;
    font-family: var(--hh-font) !important;
  }

  .hh-hero-title em {
    font-style: normal;
    color: var(--hh-green);
  }

  .hh-hero-sub {
    font-size: 18px; color: rgba(255,255,255,0.60);
    line-height: 1.65; margin-bottom: 40px;
    max-width: 500px;
    font-family: var(--hh-font) !important;
  }

  .hh-hero-ctas {
    display: flex; gap: 14px; flex-wrap: wrap; align-items: center;
    margin-bottom: 48px;
  }

  .hh-hero-btn-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: #fff !important;
    font-family: var(--hh-font) !important;
    font-size: 14px; font-weight: 700;
    padding: 13px 28px; border-radius: 9999px;
    border: 1.5px solid rgba(255,255,255,0.25);
    transition: border-color 0.2s, background 0.2s;
  }
  .hh-hero-btn-outline:hover { border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.06); }

  .hh-hero-trust {
    display: flex; align-items: center; gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.10);
  }
  .hh-hero-trust-stars { color: var(--hh-green); font-size: 16px; letter-spacing: 2px; }
  .hh-hero-trust-text { font-size: 13px; color: rgba(255,255,255,0.50); font-family: var(--hh-font) !important; }
  .hh-hero-trust-text strong { color: rgba(255,255,255,0.85); }

  /* HERO VISUAL */
  .hh-hero-visual {
    display: flex; flex-direction: column; gap: 16px;
  }

  .hh-hero-img-frame {
    background: var(--hh-carbon);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 32px;
    padding: 32px;
    aspect-ratio: 1 / 1;
    display: flex; align-items: center; justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hh-hero-img-frame::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(0,201,123,0.07) 0%, transparent 60%);
    pointer-events: none;
  }

  .hh-hero-product-img {
    width: 85%; height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 50px rgba(0,0,0,0.6));
    position: relative; z-index: 1;
  }

  .hh-hero-stats {
    display: grid; grid-template-columns: repeat(3,1fr); gap: 10px;
  }

  .hh-hero-stat {
    background: var(--hh-carbon);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px; padding: 16px 14px; text-align: center;
  }
  .hh-hero-stat-val {
    font-size: 22px; font-weight: 900; color: #fff;
    font-family: var(--hh-font) !important;
    display: block;
  }
  .hh-hero-stat-label {
    font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 3px;
    font-family: var(--hh-font) !important;
    display: block;
  }

  /* ════════════════════════════════════════
     2. TICKER — Aerolíneas
     ════════════════════════════════════════ */
  .hh-ticker {
    background: var(--hh-charcoal);
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 14px 0;
    overflow: hidden;
  }

  .hh-ticker-track {
    display: flex; gap: 56px; align-items: center;
    animation: ticker-scroll 28s linear infinite;
    width: max-content;
  }

  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hh-ticker-item {
    display: flex; align-items: center; gap: 10px;
    white-space: nowrap;
  }
  .hh-ticker-label {
    font-size: 11px; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(255,255,255,0.35);
  }
  .hh-ticker-brand {
    font-size: 13px; font-weight: 800; letter-spacing: 0.06em;
    color: rgba(255,255,255,0.75);
    background: rgba(255,255,255,0.05);
    padding: 4px 12px; border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  /* ════════════════════════════════════════
     3. COLECCION — Productos (Editorial Grid)
     ════════════════════════════════════════ */
  .hh-collection {
    padding: 120px 0;
    background: var(--hh-white);
  }

  .hh-section-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 60px; gap: 24px; flex-wrap: wrap;
  }

  .hh-section-eyebrow {
    font-size: 11px; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--hh-green);
    margin-bottom: 10px; display: block;
    font-family: var(--hh-font) !important;
  }

  .hh-section-title {
    font-size: clamp(2rem, 4vw, 3.2rem) !important;
    font-weight: 900 !important; color: var(--hh-black) !important;
    letter-spacing: -0.03em; line-height: 1.1;
    font-family: var(--hh-font) !important;
  }

  .hh-collection-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 20px;
  }

  .hh-prod-card {
    background: var(--hh-slate);
    border-radius: 24px; overflow: hidden;
    position: relative;
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
  }
  .hh-prod-card:hover { transform: translateY(-6px); box-shadow: 0 24px 60px rgba(0,0,0,0.10); }

  .hh-prod-card.featured {
    background: var(--hh-black);
  }

  .hh-prod-card-badge {
    position: absolute; top: 20px; left: 20px; z-index: 2;
    background: var(--hh-green); color: #fff;
    font-size: 10px; font-weight: 800; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 4px 10px; border-radius: 6px;
    font-family: var(--hh-font) !important;
  }

  .hh-prod-card-img-wrap {
    aspect-ratio: 1 / 1;
    display: flex; align-items: center; justify-content: center;
    padding: 32px;
  }

  .hh-prod-card.featured .hh-prod-card-img-wrap { aspect-ratio: 4/3; }

  .hh-prod-card-img {
    width: 80%; height: auto; object-fit: contain;
    transition: transform 0.4s;
  }
  .hh-prod-card:hover .hh-prod-card-img { transform: scale(1.05); }

  .hh-prod-card-body { padding: 0 24px 28px; }

  .hh-prod-card-tag {
    font-size: 10px; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--hh-green); margin-bottom: 6px;
    display: block; font-family: var(--hh-font) !important;
  }

  .hh-prod-card-name {
    font-size: 17px !important; font-weight: 800 !important;
    color: var(--hh-black) !important;
    line-height: 1.3; margin-bottom: 6px;
    font-family: var(--hh-font) !important;
  }

  .hh-prod-card.featured .hh-prod-card-name { color: #fff !important; }

  .hh-prod-card-desc {
    font-size: 13px; color: var(--hh-gray-mid); line-height: 1.5;
    margin-bottom: 16px; font-family: var(--hh-font) !important;
  }
  .hh-prod-card.featured .hh-prod-card-desc { color: rgba(255,255,255,0.50); }

  .hh-prod-card-footer {
    display: flex; align-items: center; justify-content: space-between;
  }

  .hh-prod-card-price {
    font-size: 20px; font-weight: 900; color: var(--hh-black);
    font-family: var(--hh-font) !important;
  }
  .hh-prod-card.featured .hh-prod-card-price { color: #fff; }

  .hh-prod-card-arrow {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--hh-black); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; transition: background 0.2s;
  }
  .hh-prod-card:hover .hh-prod-card-arrow { background: var(--hh-green); }
  .hh-prod-card.featured .hh-prod-card-arrow { background: rgba(255,255,255,0.10); }

  /* ════════════════════════════════════════
     4. MANIFESTO — Sección Negra Disruptiva
     ════════════════════════════════════════ */
  .hh-manifesto {
    background: var(--hh-black);
    padding: 140px 0;
    position: relative; overflow: hidden;
  }

  .hh-manifesto::before {
    content: '';
    position: absolute; top: -200px; right: -200px;
    width: 600px; height: 600px; border-radius: 50%;
    background: radial-gradient(circle, rgba(0,201,123,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hh-manifesto-inner {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: center; position: relative; z-index: 1;
  }

  .hh-manifesto-label {
    font-size: 11px; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--hh-green);
    margin-bottom: 20px; display: block;
    font-family: var(--hh-font) !important;
  }

  .hh-manifesto-title {
    font-size: clamp(2.4rem, 4.5vw, 4rem) !important;
    font-weight: 900 !important; color: #FFFFFF !important;
    letter-spacing: -0.035em; line-height: 1.08;
    margin-bottom: 28px;
    font-family: var(--hh-font) !important;
  }

  .hh-manifesto-body {
    font-size: 17px; color: rgba(255,255,255,0.60);
    line-height: 1.75; margin-bottom: 40px;
    font-family: var(--hh-font) !important;
  }

  .hh-manifesto-stats {
    display: grid; grid-template-columns: repeat(3,1fr); gap: 1px;
    border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; overflow: hidden;
    background: rgba(255,255,255,0.06);
  }

  .hh-manifesto-stat {
    padding: 24px 20px; text-align: center;
    background: rgba(255,255,255,0.03);
  }

  .hh-manifesto-stat-num {
    font-size: 28px; font-weight: 900; color: #fff; display: block;
    font-family: var(--hh-font) !important;
  }
  .hh-manifesto-stat-lbl {
    font-size: 11px; color: rgba(255,255,255,0.40); margin-top: 4px;
    display: block; font-family: var(--hh-font) !important;
  }

  .hh-manifesto-visual {
    position: relative;
  }

  .hh-manifesto-img-frame {
    background: var(--hh-carbon);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 28px; overflow: hidden;
    aspect-ratio: 4/5;
    display: flex; align-items: center; justify-content: center;
    padding: 40px;
  }

  .hh-manifesto-img {
    width: 100%; height: auto; object-fit: contain;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.8));
  }

  .hh-manifesto-float-badge {
    position: absolute; bottom: 24px; left: -20px;
    background: var(--hh-green); color: #fff;
    border-radius: 16px; padding: 16px 20px;
    box-shadow: 0 16px 40px rgba(0,201,123,0.4);
  }
  .hh-manifesto-float-badge strong {
    font-size: 22px; font-weight: 900; display: block;
    font-family: var(--hh-font) !important;
  }
  .hh-manifesto-float-badge span {
    font-size: 12px; opacity: 0.85;
    font-family: var(--hh-font) !important;
  }

  /* ════════════════════════════════════════
     5. PILLARS — Los 3 Pilares (Bento Grid)
     ════════════════════════════════════════ */
  .hh-pillars {
    padding: 120px 0;
    background: var(--hh-snow);
  }

  .hh-pillars-bento {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px; margin-top: 60px;
  }

  .hh-pillar-card {
    background: var(--hh-white);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 24px; padding: 36px 28px;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: box-shadow 0.3s;
    min-height: 260px;
  }
  .hh-pillar-card:hover { box-shadow: 0 16px 40px rgba(0,0,0,0.06); }

  .hh-pillar-card.dark {
    background: var(--hh-black);
    border-color: rgba(255,255,255,0.06);
    grid-column: 1; grid-row: 1 / 3;
  }

  .hh-pillar-icon {
    width: 54px; height: 54px; background: var(--hh-slate);
    border-radius: 15px; display: flex; align-items: center;
    justify-content: center; font-size: 26px;
    margin-bottom: 24px;
  }
  .hh-pillar-card.dark .hh-pillar-icon { background: rgba(255,255,255,0.07); }

  .hh-pillar-name {
    font-size: 20px !important; font-weight: 900 !important;
    color: var(--hh-black) !important; margin-bottom: 10px; line-height: 1.25;
    font-family: var(--hh-font) !important;
  }
  .hh-pillar-card.dark .hh-pillar-name { color: #fff !important; }

  .hh-pillar-desc {
    font-size: 14px; color: var(--hh-gray-mid); line-height: 1.6;
    font-family: var(--hh-font) !important;
  }
  .hh-pillar-card.dark .hh-pillar-desc { color: rgba(255,255,255,0.50); }

  /* ════════════════════════════════════════
     6. REVIEWS — Muro de Testimonios
     ════════════════════════════════════════ */
  .hh-reviews {
    padding: 120px 0;
    background: var(--hh-white);
  }

  .hh-reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px; margin-top: 60px;
  }

  .hh-review-card {
    background: var(--hh-slate);
    border-radius: 20px; padding: 28px;
    display: flex; flex-direction: column;
    gap: 16px; transition: box-shadow 0.2s;
  }
  .hh-review-card:hover { box-shadow: 0 10px 30px rgba(0,0,0,0.06); }
  .hh-review-card:first-child { background: var(--hh-black); }

  .hh-review-stars { color: #00B67A; font-size: 15px; letter-spacing: 2px; }
  .hh-review-card:first-child .hh-review-stars { color: var(--hh-green); }

  .hh-review-quote {
    font-size: 15px; color: var(--hh-black); font-weight: 500; line-height: 1.6;
    font-family: var(--hh-font) !important;
    flex: 1;
  }
  .hh-review-card:first-child .hh-review-quote { color: #fff; }

  .hh-review-author { display: flex; align-items: center; gap: 12px; }
  .hh-review-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--hh-green); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 800; flex-shrink: 0;
    font-family: var(--hh-font) !important;
  }
  .hh-review-card:first-child .hh-review-avatar { background: rgba(255,255,255,0.12); }
  .hh-review-name {
    font-size: 14px; font-weight: 800; color: var(--hh-black);
    font-family: var(--hh-font) !important;
  }
  .hh-review-card:first-child .hh-review-name { color: #fff; }
  .hh-review-meta {
    font-size: 12px; color: var(--hh-gray-mid);
    font-family: var(--hh-font) !important;
  }
  .hh-review-card:first-child .hh-review-meta { color: rgba(255,255,255,0.40); }

  /* ════════════════════════════════════════
     7. FAQ
     ════════════════════════════════════════ */
  .hh-faq { padding: 100px 0; background: var(--hh-snow); }

  .hh-faq-inner { max-width: 800px; margin: 60px auto 0; display: flex; flex-direction: column; gap: 12px; }

  .hh-faq-item {
    background: var(--hh-white); border: 1px solid rgba(0,0,0,0.06);
    border-radius: 16px; overflow: hidden;
  }

  .hh-faq-q {
    padding: 22px 24px; display: flex; align-items: center;
    justify-content: space-between; cursor: pointer; user-select: none;
    gap: 16px;
  }

  .hh-faq-q-text {
    font-size: 15px; font-weight: 800; color: var(--hh-black); flex: 1;
    font-family: var(--hh-font) !important;
  }

  .hh-faq-toggle {
    width: 28px; height: 28px; border-radius: 50%; background: var(--hh-slate);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 18px; font-weight: 700; color: var(--hh-black);
    transition: transform 0.3s, background 0.2s;
  }

  .hh-faq-item.open .hh-faq-toggle { transform: rotate(45deg); background: var(--hh-green); color: #fff; }

  .hh-faq-a { display: none; padding: 0 24px 22px; }
  .hh-faq-item.open .hh-faq-a { display: block; }
  .hh-faq-a p { font-size: 14px; color: var(--hh-gray-mid); line-height: 1.7; font-family: var(--hh-font) !important; }

  /* ════════════════════════════════════════
     8. TRUST FINAL — Dark CTA Banner
     ════════════════════════════════════════ */
  .hh-trust {
    background: var(--hh-black); padding: 100px 0; text-align: center;
  }

  .hh-trust-badges {
    display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;
    margin-bottom: 60px;
  }

  .hh-trust-badge {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .hh-trust-badge-icon { font-size: 32px; }
  .hh-trust-badge-title { font-size: 14px; font-weight: 800; color: #fff; font-family: var(--hh-font) !important; }
  .hh-trust-badge-desc { font-size: 12px; color: rgba(255,255,255,0.45); font-family: var(--hh-font) !important; }

  .hh-trust-divider { width: 60px; height: 1px; background: rgba(255,255,255,0.1); margin: 0 auto 50px; }

  .hh-trust-headline {
    font-size: clamp(2rem, 4vw, 3.2rem) !important;
    font-weight: 900 !important; color: #fff !important;
