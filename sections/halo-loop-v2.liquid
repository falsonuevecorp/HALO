{% schema %}
{
  "name": "HALO Loop V2",
  "settings": [],
  "presets": [
    {
      "name": "HALO Loop V2",
      "category": "HALO"
    }
  ]
}
{% endschema %}

<!-- GOOGLE FONTS: Inter (Official HALO Tech Typography) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Remove hardcoded product -->

<style>
  :root {
    --h2-bg-0: #030303;
    --h2-bg-1: #0A0A0A;
    --h2-bg-2: #141414;
    --h2-bg-3: #1F1F1F;
    --h2-cyan: #00ECFF;
    --h2-green: #00C97B;
    --h2-text-main: #FFFFFF;
    --h2-text-muted: #94a3b8;
    --h2-border: rgba(255, 255, 255, 0.08);
    --font-family: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* RESET & BASE */
  .halo-loop-v2 {
    background: var(--h2-bg-0);
    color: var(--h2-text-main);
    font-family: var(--font-family);
    overflow-x: hidden;
  }
  
  .halo-loop-v2 h1, .halo-loop-v2 h2, .halo-loop-v2 h3, .halo-loop-v2 h4 {
    font-family: var(--font-family);
    margin: 0;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .hl2-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* KINETIC VANGUARD UTILS */
  .hl2-fade {
    opacity: 0;
    transform: translateY(30px) scale(0.98);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hl2-fade.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .hl2-tag {
    display: inline-block;
    font-family: var(--font-family);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--h2-cyan) !important;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 24px;
  }

  /* BUTTONS: ZERO RED, APPLE STEALTH AESTHETIC */
  .hl2-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--h2-green) !important;
    border: 1px solid var(--h2-green) !important;
    color: #FFFFFF !important; /* HARDCODED CONTRAST */
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 18px 42px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0, 201, 123, 0.3);
    cursor: pointer;
  }
  .hl2-btn span {
    color: inherit !important;
  }
  .hl2-btn:hover {
    background: #00A865 !important;
    border-color: #00A865 !important;
    color: #FFFFFF !important;
    box-shadow: 0 0 30px rgba(0, 201, 123, 0.5);
  }

  .hl2-btn--outline {
    background: transparent !important;
    border: 1px solid var(--h2-border) !important;
    color: #FFFFFF !important;
    box-shadow: none;
  }
  .hl2-btn--outline:hover {
    background: rgba(255, 255, 255, 0.05) !important;
    border-color: #FFFFFF !important;
  }

  /* ====== BLOCK 1: HERO (SPLIT LAYOUT) ====== */
  .hl2-hero {
    position: relative;
    padding: 60px 0 100px;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--h2-bg-0);
  }
  .hl2-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(0, 236, 255, 0.06) 0%, transparent 50%);
    pointer-events: none;
  }
  .hl2-hero__content {
    position: relative;
    z-index: 10;
    width: 100%;
  }
  .hl2-hero__grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .hl2-hero__buybox {
    background: var(--h2-bg-1);
    border: 1px solid var(--h2-border);
    border-radius: 32px;
    padding: 45px;
    box-shadow: 0 40px 80px rgba(0,0,0,0.6);
  }
  .hl2-hero__buybox h1 {
    font-size: clamp(2.5rem, 4vw, 3.2rem);
    margin-bottom: 10px;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: #FFFFFF;
  }
  .hl2-hero__specs-box {
    background: var(--h2-bg-0);
    border: 1px solid var(--h2-border);
    border-radius: 20px;
    padding: 24px;
    margin-top: 25px;
  }
  .hl2-hero__text {
    text-align: left;
  }
  .hl2-hero h1 {
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 800;
    margin-bottom: 25px;
    background: linear-gradient(180deg, #FFFFFF 20%, #71717a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hl2-hero p {
    font-size: 1.25rem;
    color: var(--h2-text-muted) !important; /* HARDCODED CONTRAST */
    margin: 0 0 40px 0;
    line-height: 1.6;
    font-weight: 400;
    max-width: 90%;
  }
  .hl2-hero__price {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin-bottom: 30px;
  }
  .hl2-hero__price .price-current {
    font-size: 2.5rem;
    font-weight: 800;
    color: #FFFFFF !important;
  }
  .hl2-hero__price .price-compare {
    font-size: 1.2rem;
    color: var(--h2-text-muted) !important;
    text-decoration: line-through;
  }
  .hl2-hero__micro-proof {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: #FFFFFF !important;
    margin-bottom: 30px;
  }
  .stock-dot {
    width: 8px;
    height: 8px;
    background-color: var(--h2-green);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px var(--h2-green);
  }
  .hl2-hero__badges {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    padding-top: 25px;
    border-top: 1px solid var(--h2-border);
    max-width: 90%;
  }
  .hl2-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #FFFFFF !important;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .hl2-badge svg {
    color: var(--h2-green);
  }
  .hl2-badge span {
    color: #FFFFFF !important;
  }
  
  /* ====== CTA TRUST BADGES (COGNITIVE BIASES) ====== */
  .hl2-trust-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 18px;
    margin-top: 15px;
  }
  .hl2-trust-badges span {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--h2-text-muted) !important;
  }
  .hl2-trust-badges svg {
    color: var(--h2-green);
    width: 16px;
    height: 16px;
  }
  .hl2-hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hl2-hero__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
    animation: floatImage 6s ease-in-out infinite;
  }
  .hl2-hero-img {
    width: 100%;
    height: auto;
    border-radius: 24px;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,0.4));
  }
  .hl2-hero-placeholder {
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--h2-bg-1);
    border: 1px solid var(--h2-border);
    border-radius: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
  }
  .hl2-hero-placeholder span {
    color: #FFFFFF !important;
    font-weight: 600;
    margin-top: 20px;
    letter-spacing: 0.05em;
  }
  @keyframes floatImage {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }
  @keyframes ping {
    75%, 100% {
      transform: scale(2.5);
      opacity: 0;
    }
  }

  /* MERCADOPAGO HIGH-CONTRAST CARD & ANTI-INVISIBILIDAD REGLA 19 */
  .hl2-mp-card {
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.22) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }
  .hl2-mp-card,
  .hl2-mp-card span,
  .hl2-mp-card div,
  .hl2-mp-card .money,
  .hl2-mp-card * {
    color: #FFFFFF !important;
  }
  .hl2-mp-card .hl2-mp-highlight {
    color: #009EE3 !important;
  }
  .hl2-mp-card .hl2-mp-green {
    color: var(--h2-green) !important;
  }
  .hl2-mp-card .hl2-mp-muted {
    color: var(--h2-text-muted) !important;
  }

  .hl2-stars {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
    background: rgba(255,255,255,0.04);
    padding: 8px 20px;
    border-radius: 9999px;
    border: 1px solid var(--h2-border);
  }
  /* REGLA 19 ANTI-INVISIBILIDAD */
  .hl2-stars span, .hl2-stars div {
    color: #FFFFFF !important; 
    font-size: 0.95rem;
    font-weight: 600;
  }
  .hl2-stars svg {
    color: #FFC107;
  }

  /* ====== BLOCK 2: LOGO BAR MARQUEE ====== */
  .hl2-logos {
    padding: 20px 0;
    background: var(--h2-bg-1);
    border-top: 1px solid var(--h2-border);
    border-bottom: 1px solid var(--h2-border);
    overflow: hidden;
    position: relative;
  }
  .hl2-logos::after, .hl2-logos::before {
    content: '';
    position: absolute;
    top: 0;
    width: 60px;
    height: 100%;
    z-index: 2;
  }
  .hl2-logos::before {
    left: 0;
    background: linear-gradient(to right, var(--h2-bg-1), transparent);
  }
  .hl2-logos::after {
    right: 0;
    background: linear-gradient(to left, var(--h2-bg-1), transparent);
  }
  .hl2-logos__track {
    display: flex;
    gap: 80px;
    width: max-content;
    animation: hl2-scroll-logos 20s linear infinite;
    opacity: 0.4;
    align-items: center;
  }
  .hl2-logos__item {
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #FFFFFF !important;
    white-space: nowrap;
  }
  @keyframes hl2-scroll-logos {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ====== BLOCK 3: EL PIVOTE (ENEMIGO COMÚN) ====== */
  .hl2-pivot {
    padding: 80px 0;
    background: var(--h2-bg-2);
    position: relative;
  }
  .hl2-pivot__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .hl2-pivot h2 {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.1;
  }
  .hl2-pivot p {
    font-size: 1.2rem;
    color: var(--h2-text-muted) !important;
    line-height: 1.7;
    margin-bottom: 30px;
  }
  .hl2-pivot__visual {
    height: 350px;
    background: var(--h2-bg-1);
    border: 1px solid var(--h2-border);
    border-radius: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
  }
  .hl2-pivot__visual span {
    color: #FFFFFF !important;
    font-weight: 600;
    margin-top: 20px;
    letter-spacing: 0.05em;
  }

  /* ====== BLOCK 4: STICKY STACKING ====== */
  .hl2-sticky-section {
    background: var(--h2-bg-3);
    padding: 80px 0 150px;
    position: relative;
    border-top: 1px solid var(--h2-border);
  }
  .hl2-sticky-container {
    max-width: 900px;
    margin: 0 auto;
  }
  .hl2-sticky-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .hl2-sticky-header h2 {
    font-size: 3.8rem;
    font-weight: 800;
  }
  
  .hl2-card {
    background: var(--h2-bg-1);
    border: 1px solid var(--h2-border);
    border-radius: 32px;
    padding: 60px;
    margin-bottom: 40px;
    position: sticky;
    top: 120px;
    box-shadow: 0 40px 80px rgba(0,0,0,0.6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }
  .hl2-card:nth-child(2) { top: 140px; transform: scale(0.98); }
  .hl2-card:nth-child(3) { top: 160px; transform: scale(0.96); }

  .hl2-card h3 {
    font-size: 2.2rem;
    margin-bottom: 20px;
    font-weight: 800;
  }
  .hl2-card p {
    font-size: 1.15rem;
    color: var(--h2-text-muted) !important;
    line-height: 1.6;
  }
  .hl2-card__icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: rgba(0, 236, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
  }

  /* ====== BLOCK 4.1: COMPARATIVE TABLE (NEW) ====== */
  .hl2-compare-section {
    background: var(--h2-bg-1);
    padding: 160px 0;
    border-top: 1px solid var(--h2-border);
  }
  .hl2-compare-header {
    text-align: center;
    margin-bottom: 80px;
  }
  .hl2-compare-header h2 {
    font-size: 3rem;
  }
  .hl2-table-wrapper {
    background: var(--h2-bg-2);
    border: 1px solid var(--h2-border);
    border-radius: 32px;
    overflow: hidden;
  }
  .hl2-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .hl2-table tr {
    background-color: transparent !important;
  }
  .hl2-table tbody tr:nth-child(odd) {
    background-color: rgba(255, 255, 255, 0.02) !important;
  }
  .hl2-table tbody tr:nth-child(even) {
    background-color: transparent !important;
  }
  .hl2-table th, .hl2-table td {
    padding: 30px;
    border-bottom: 1px solid var(--h2-border) !important;
    font-size: 1.1rem;
    color: #FFFFFF !important;
  }
  .hl2-table th {
    background-color: rgba(255,255,255,0.04) !important;
    font-weight: 700;
  }
  .hl2-table td span, .hl2-table td p {
    color: #FFFFFF !important;
  }
  .hl2-table td strong {
    color: var(--h2-green) !important;
    font-weight: 700;
  }
  .hl2-table tr:last-child td { border-bottom: none !important; }
  
  .hl2-table td.highlight-col, .hl2-table th.highlight-col {
    background-color: rgba(0, 201, 123, 0.08) !important;
    border-left: 1px solid rgba(0, 201, 123, 0.3) !important;
    border-right: 1px solid rgba(0, 201, 123, 0.3) !important;
  }
  .hl2-table .highlight-col strong {
    color: var(--h2-green) !important;
  }

  /* ====== BLOCK 4.2: DEEP DATA (NEW) ====== */
  .hl2-data-section {
    background: var(--h2-bg-0);
    padding: 160px 0;
  }
  .hl2-data-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 80px;
  }
  .hl2-data-card {
    background: var(--h2-bg-1);
    border: 1px solid var(--h2-border);
    border-radius: 24px;
    padding: 50px;
    transition: transform 0.4s ease;
  }
  .hl2-data-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 236, 255, 0.3);
  }
  .hl2-data-card h3 {
    font-size: 1.8rem;
    margin-bottom: 20px;
    color: #FFFFFF !important;
  }
  .hl2-data-card p {
    font-size: 1.1rem;
    color: var(--h2-text-muted) !important;
    line-height: 1.6;
  }
  .hl2-data-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--h2-cyan) !important;
    margin-bottom: 20px;
  }

  /* ====== BLOCK 5: EL PITCH ====== */
  .hl2-pitch {
    padding: 160px 0;
    background: var(--h2-bg-2);
    border-top: 1px solid var(--h2-border);
    text-align: center;
  }
  .hl2-pitch-box {
    max-width: 1000px;
    margin: 0 auto;
    background: var(--h2-bg-1);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 40px;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    text-align: left;
    position: relative;
    overflow: hidden;
  }
  .hl2-pitch-box::after {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(0, 236, 255, 0.08) 0%, transparent 70%);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .hl2-pitch-img {
    background: var(--h2-bg-0);
    border-radius: 24px;
    border: 1px solid var(--h2-border);
    height: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hl2-pitch-content h2 {
    font-size: 2.8rem;
    margin-bottom: 16px;
  }
  .hl2-pitch-price {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--h2-cyan) !important;
    margin: 24px 0;
  }
  .hl2-checklist {
    list-style: none;
    padding: 0;
    margin: 30px 0 40px;
  }
  .hl2-checklist li {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 1.05rem;
  }
  .hl2-checklist li span {
    color: #FFFFFF !important; /* HARDCODED CONTRAST */
    font-weight: 500;
  }
  .hl2-checklist li svg {
    color: var(--h2-cyan);
  }

  /* ====== BLOCK 5.1: CASOS DE ESTUDIO (NEW) ====== */
  .hl2-cases-section {
    padding: 160px 0;
    background: var(--h2-bg-1);
    border-top: 1px solid var(--h2-border);
  }
  .hl2-cases-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    margin-top: 80px;
  }
  .hl2-case-card {
    background: var(--h2-bg-2);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--h2-border);
  }
  .hl2-case-img {
    height: 250px;
    background: var(--h2-bg-0);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--h2-border);
  }
  .hl2-case-img span {
    color: #FFFFFF !important;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .hl2-case-body {
    padding: 40px;
  }
  .hl2-case-body h4 {
    font-size: 1.8rem;
    margin-bottom: 15px;
    color: #FFFFFF !important;
  }
  .hl2-case-quote {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--h2-text-muted) !important;
    margin-bottom: 25px;
    line-height: 1.6;
  }
  .hl2-case-result {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--h2-green) !important;
  }

  /* ====== BLOCK 6: TRUSTPILOT MARQUEE ====== */
  .hl2-marquee-section {
    padding: 100px 0;
    background: var(--h2-bg-3);
    border-top: 1px solid var(--h2-border);
    border-bottom: 1px solid var(--h2-border);
    overflow: hidden;
  }
  .hl2-marquee-section h2 {
    text-align: center;
    font-size: 2.8rem;
    margin-bottom: 60px;
  }
  .hl2-marquee-track {
    display: flex;
    gap: 30px;
    width: max-content;
    animation: hl2-scroll 35s linear infinite;
  }
  .hl2-marquee-track:hover {
    animation-play-state: paused;
  }
  .hl2-review {
    width: 420px;
    background: var(--h2-bg-1);
    border: 1px solid var(--h2-border);
    border-radius: 24px;
    padding: 40px;
  }
  .hl2-review h4 {
    font-size: 1.25rem;
    margin: 16px 0;
  }
  .hl2-review p {
    color: var(--h2-text-muted) !important;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .hl2-review span {
    color: #FFFFFF !important;
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* ====== BLOCK 6.1: WHAT'S IN THE BOX (NEW) ====== */
  .hl2-box-section {
    padding: 160px 0;
    background: var(--h2-bg-2);
  }
  .hl2-box-container {
    max-width: 800px;
    margin: 0 auto;
    background: var(--h2-bg-1);
    border: 1px solid var(--h2-border);
    border-radius: 32px;
