{% if product.handle contains 'smartpaine' or product.title contains 'Atacama Vision' or product.title contains 'Vision PRO' or product.handle contains 'traduccion' %}
  {% render 'atacama-vision-pro' %}
{% else %}
  {% render 'motosport-landing-page', target_product: section.settings.target_product %}
{% endif %}

{% schema %}
{
  "name": "Moto Sport Landing",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "target_product",
      "label": "Producto Vinculado",
      "info": "Selecciona el producto maestro para que el carrito funcione en páginas independientes."
    }
  ],
  "presets": [
    {
      "name": "Moto Sport Landing"
    }
  ]
}
{% endschema %}
