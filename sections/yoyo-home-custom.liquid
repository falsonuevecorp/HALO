<style>
  @import url("https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@500;600;700;800;900&display=swap");

  .yoyo-home-wrapper {
    font-family: "Nunito", -apple-system, BlinkMacSystemFont, sans-serif;
    color: #0f172a;
    background-color: #f8fafc;
    margin: 0;
    padding: 0;
    line-height: 1.5;
  }

  .yoyo-home-wrapper h1, .yoyo-home-wrapper h2, .yoyo-home-wrapper h3 {
    font-family: "Fredoka", sans-serif;
    margin: 0;
    line-height: 1.1;
  }

  /* --- HERO SECTION --- */
  .yoyo-home-hero {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    padding: 100px 20px;
    text-align: center;
    border-bottom: 1px solid #bae6fd;
  }

  .yoyo-hero-badge {
    display: inline-block;
    background: #0ea5e9;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 14px;
    border-radius: 30px;
    margin-bottom: 24px;
  }

  .yoyo-home-hero h1 {
    font-size: 48px;
    color: #0f172a;
    max-width: 900px;
    margin: 0 auto 24px auto;
    letter-spacing: -1px;
  }

  .yoyo-home-hero p {
    font-size: 19px;
    color: #475569;
    max-width: 700px;
    margin: 0 auto 40px auto;
    font-weight: 600;
  }

  .yoyo-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #2563eb;
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
    padding: 18px 48px;
    border-radius: 100px;
    text-decoration: none;
    box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.4);
    transition: all 0.3s ease;
  }

  .yoyo-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px -5px rgba(37, 99, 235, 0.5);
  }

  /* --- COMPARISON SECTION --- */
  .yoyo-home-comparison {
    padding: 80px 20px;
    background: #ffffff;
  }

  .yoyo-comp-container {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .yoyo-comp-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 32px;
    padding: 40px;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .yoyo-comp-card.highlight {
    background: #0f172a;
    color: #ffffff;
    border: none;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transform: scale(1.03);
  }

  .yoyo-comp-card h3 {
    font-size: 28px;
    margin-bottom: 24px;
  }
  .yoyo-comp-card.highlight h3 {
    color: #fff;
  }

  .yoyo-comp-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .yoyo-comp-card li {
    font-size: 17px;
    margin-bottom: 20px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-weight: 600;
  }

  .yoyo-comp-card li svg {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-top: 2px;
  }

  .icon-cross { color: #ef4444; }
  .icon-check { color: #10b981; }

  /* --- SOCIAL PROOF --- */
  .yoyo-home-proof {
    background: #f1f5f9;
    padding: 80px 20px;
    text-align: center;
  }

  .yoyo-home-proof h2 {
    font-size: 40px;
    margin-bottom: 48px;
    letter-spacing: -1px;
  }

  .yoyo-proof-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .yoyo-review-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 32px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    text-align: left;
  }

  .yoyo-review-stars {
    color: #fbbf24;
    margin-bottom: 16px;
    font-size: 20px;
  }

  .yoyo-review-text {
    font-size: 17px;
    color: #334155;
    font-weight: 600;
    margin-bottom: 24px;
    font-style: italic;
  }

  .yoyo-review-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .yoyo-author-avatar {
    width: 48px;
    height: 48px;
    background: #cbd5e1;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: #ffffff;
    font-size: 18px;
  }
  .yoyo-author-avatar.blue { background: #3b82f6; }
  .yoyo-author-avatar.purple { background: #8b5cf6; }
  .yoyo-author-avatar.pink { background: #ec4899; }

  .yoyo-author-name {
    font-weight: 800;
    font-size: 15px;
    color: #0f172a;
    display: block;
  }
  
  .yoyo-author-badge {
    font-size: 13px;
    color: #10b981;
    font-weight: 700;
  }

  @media (max-width: 800px) {
    .yoyo-comp-container { grid-template-columns: 1fr; }
    .yoyo-comp-card.highlight { transform: scale(1); }
    .yoyo-home-hero h1 { font-size: 36px; }
  }
</style>

<div class="yoyo-home-wrapper">
  
  <!-- HERO -->
  <section class="yoyo-home-hero">
    <div class="yoyo-hero-badge">Alternativa Segura al Celular</div>
    <h1>EL PRIMER RELOJ INTELIGENTE QUE NO ES UNA PANTALLA TÓXICA</h1>
    <p>GPS preciso. Llamadas seguras. Cero redes sociales. Protege a tu hijo sin exponerlo a depredadores, bullying ni adicción a la dopamina.</p>
    
    {% assign first_product = collections.all.products.first %}
    <a href="{{ first_product.url | default: '/collections/all' }}" class="yoyo-btn-primary">
      PROTEGER AHORA
    </a>
  </section>

  <!-- COMPARISON -->
  <section class="yoyo-home-comparison">
    <div class="yoyo-comp-container">
      
      <!-- Teléfono -->
      <div class="yoyo-comp-card">
        <h3>Darle un Celular</h3>
        <ul>
          <li>
            <svg class="icon-cross" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            Acceso libre a internet y redes sociales
          </li>
          <li>
            <svg class="icon-cross" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            Exposición a depredadores y cyberbullying
          </li>
          <li>
            <svg class="icon-cross" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            Fácil de perder o romper ($800+ USD)
          </li>
          <li>
            <svg class="icon-cross" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            Adicción temprana a las pantallas
          </li>
        </ul>
      </div>

      <!-- Yoyo Watch -->
      <div class="yoyo-comp-card highlight">
        <h3>Usar Yoyo Watch</h3>
        <ul>
          <li>
            <svg class="icon-check" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Comunicación bloqueada solo a contactos aprobados
          </li>
          <li>
            <svg class="icon-check" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Rastreo GPS en tiempo real
          </li>
          <li>
            <svg class="icon-check" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Botón de pánico SOS instantáneo
          </li>
          <li>
            <svg class="icon-check" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Diseño robusto, imposible de perder (va en la muñeca)
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="yoyo-home-proof">
    <h2>Lo que dicen los padres</h2>
    
    <div class="yoyo-proof-grid">
      
      <div class="yoyo-review-card">
        <div class="yoyo-review-stars">★★★★★</div>
        <p class="yoyo-review-text">"Por fin puedo saber dónde está mi hija cuando sale del colegio. Mucho mejor que darle un celular que la distraiga en clases."</p>
        <div class="yoyo-review-author">
          <div class="yoyo-author-avatar blue">M</div>
          <div>
            <span class="yoyo-author-name">María P.</span>
            <span class="yoyo-author-badge">✔ Madre Verificada</span>
          </div>
        </div>
      </div>

      <div class="yoyo-review-card">
        <div class="yoyo-review-stars">★★★★★</div>
        <p class="yoyo-review-text">"El botón de pánico SOS me da una tranquilidad inmensa. Mi hijo de 7 años sabe cómo usarlo perfecto. Es el mejor invento."</p>
        <div class="yoyo-review-author">
          <div class="yoyo-author-avatar purple">C</div>
          <div>
            <span class="yoyo-author-name">Carlos R.</span>
            <span class="yoyo-author-badge">✔ Padre Verificado</span>
          </div>
        </div>
      </div>

      <div class="yoyo-review-card">
        <div class="yoyo-review-stars">★★★★★</div>
        <p class="yoyo-review-text">"Cero juegos adictivos, cero redes sociales. Solo llamadas conmigo y con su papá. Justo lo que estábamos buscando."</p>
        <div class="yoyo-review-author">
          <div class="yoyo-author-avatar pink">V</div>
          <div>
            <span class="yoyo-author-name">Verónica T.</span>
            <span class="yoyo-author-badge">✔ Madre Verificada</span>
          </div>
        </div>
      </div>

    </div>
  </section>

</div>

{% schema %}
{
  "name": "Yoyo Custom Home",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Yoyo Custom Home"
    }
  ]
}
{% endschema %}
