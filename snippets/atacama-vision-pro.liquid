{% comment %}
  Atacama Vision PRO® - Hyper-Dense Zoned Vanguard Salespage Snippet
  Theme: Boutique UI Multi-Tone Zoning (Apple / Vercel / IM8 Aesthetic)
  Rule 18: Section Zoning & Rhythm (Deep Black, Slate Gray, Pure White Shock, Graphite)
  Rule 14 & 28: Typography matching HALO Loop V2 (-apple-system, Inter, SF Pro Display)
  Rule 19: Strict Hardcoded Contrast Protection (!important) on Light and Dark sections
  Rule 27: Hyper-Dense Buy Box (MercadoPago + Stock Pulse + Dual-CTA + Trustpilot)
  Kinetic Mechanics: Mouse-Glow Tracking (Orion), Sticky Pin Mask Reveal (Apple), Clinical Fades (IM8)
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  :root {
    --avp-bg-black: #000000;
    --avp-bg-graphite: #0A0A0C;
    --avp-bg-slate: #0F172A;
    --avp-bg-slate-card: #1E293B;
    --avp-bg-white: #FFFFFF;
    --avp-bg-light: #F8FAFC;
    --avp-cyan: #00ECFF;
    --avp-green: #00C97B;
    --avp-red: #EF4444;
    --avp-border: rgba(255, 255, 255, 0.12);
    --avp-border-dark: #E2E8F0;
    --avp-text-muted: #94a3b8;
    --avp-text-dark: #0F172A;
    --avp-text-dark-muted: #475569;
    --font-family: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --mouse-x: 50%;
    --mouse-y: 50%;
  }

  /* HARDCODED CONTRAST & TYPOGRAPHY SCOPING (RULE 19 & 28) */
  .atacama-vision-pro, 
  .atacama-vision-pro * {
    font-family: var(--font-family) !important;
    box-sizing: border-box;
  }

  .atacama-vision-pro {
    background-color: var(--avp-bg-black) !important;
    color: #FFFFFF !important;
    line-height: 1.5;
    overflow-x: hidden;
    width: 100%;
  }

  .avp-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* CLINICAL FADES ANIMATIONS & STAGGERING */
  .avp-fade {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .avp-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .stagger-1 { transition-delay: 0.1s; }
  .stagger-2 { transition-delay: 0.2s; }
  .stagger-3 { transition-delay: 0.3s; }
  .stagger-4 { transition-delay: 0.4s; }

  .avp-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 236, 255, 0.1) !important;
    border: 1px solid rgba(0, 236, 255, 0.3) !important;
    color: var(--avp-cyan) !important;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 9999px;
    margin-bottom: 20px;
  }

  .avp-tag-red {
    background: rgba(239, 68, 68, 0.1) !important;
    border: 1px solid rgba(239, 68, 68, 0.3) !important;
    color: var(--avp-red) !important;
  }

  .avp-tag-dark {
    background: rgba(15, 23, 42, 0.08) !important;
    border: 1px solid rgba(15, 23, 42, 0.2) !important;
    color: var(--avp-text-dark) !important;
  }

  /* ====== BLOCK 1: HERO & HYPER-DENSE BUY BOX (NEGRO PROFUNDO TECH) ====== */
  .avp-hero {
    padding: 60px 0 100px;
    background: var(--avp-bg-black) !important;
    background-image: radial-gradient(circle at 80% 20%, rgba(0, 236, 255, 0.1) 0%, transparent 60%) !important;
  }
  .avp-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: flex-start;
  }
  .avp-hero__visual {
    position: sticky;
    top: 40px;
  }
  .avp-hero-img {
    width: 100%;
    height: auto;
    border-radius: 32px;
    border: 1px solid var(--avp-border);
    box-shadow: 0 20px 60px rgba(0,0,0,0.8);
    display: block;
    object-fit: cover;
    aspect-ratio: 4/5;
  }

  .avp-hero__buybox {
    background: var(--avp-bg-graphite) !important;
    border: 1px solid var(--avp-border) !important;
    border-radius: 32px;
    padding: 40px;
    box-shadow: 0 30px 90px rgba(0,0,0,0.9);
  }
  .avp-stars {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.04) !important;
    padding: 6px 16px;
    border-radius: 99px;
    border: 1px solid var(--avp-border) !important;
    margin-bottom: 20px;
  }
  .avp-stars span, .avp-stars div {
    color: #FFFFFF !important;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .avp-hero h1 {
    font-size: 2.8rem !important;
    font-weight: 900 !important;
    line-height: 1.08 !important;
    letter-spacing: -0.04em !important;
    margin-bottom: 15px !important;
    background: linear-gradient(135deg, #FFFFFF 0%, #A5A5A5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .avp-hero__price {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin-bottom: 20px;
  }
  .price-current {
    font-size: 2.8rem !important;
    font-weight: 900 !important;
    color: #FFFFFF !important;
    letter-spacing: -0.02em;
  }
  .price-compare {
    font-size: 1.4rem !important;
    text-decoration: line-through;
    color: var(--avp-text-muted) !important;
    opacity: 0.6;
  }

  /* MERCADOPAGO CARD - RULE 19 HARDCODED CONTRAST */
  .avp-mp-card {
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.22) !important;
    border-radius: 16px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }
  .avp-mp-card, 
  .avp-mp-card span, 
  .avp-mp-card div, 
  .avp-mp-card .money, 
  .avp-mp-card strong, 
  .avp-mp-card * {
    color: #FFFFFF !important;
  }

  /* DUAL-TEXT BUTTON */
  .avp-btn {
    background: linear-gradient(135deg, #00C97B 0%, #00965B 100%) !important;
    color: #FFFFFF !important;
    border: none !important;
    border-radius: 16px;
    padding: 18px 24px;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    box-shadow: 0 10px 30px rgba(0, 201, 123, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .avp-btn *, .avp-btn span {
    color: #FFFFFF !important;
  }
  .avp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(0, 201, 123, 0.5);
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2.5);
      opacity: 0;
    }
  }

  /* ====== BLOCK 2: MARQUEE INFINITO (GRIS AZABACHE) ====== */
  .avp-logos {
    padding: 24px 0;
    background: var(--avp-bg-graphite) !important;
    border-top: 1px solid var(--avp-border) !important;
    border-bottom: 1px solid var(--avp-border) !important;
    overflow: hidden;
  }
  .avp-logos__track {
    display: flex;
    gap: 60px;
    width: max-content;
    animation: avp-scroll 35s linear infinite;
  }
  .avp-logos__item {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.4) !important;
    text-transform: uppercase;
  }
  @keyframes avp-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ====== BLOCK 3: TRIPLE DOLOR (TONO GRIS PIZARRA BIÓNICO #0F172A) ====== */
  .avp-pain-section {
    padding: 120px 0;
    background: var(--avp-bg-slate) !important;
    border-top: 1px solid var(--avp-border) !important;
    border-bottom: 1px solid var(--avp-border) !important;
  }
  .avp-pain-card {
    background: var(--avp-bg-slate-card) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 32px;
    padding: 45px;
    position: relative;
    overflow: hidden;
  }
  .avp-pain-card h3 {
    font-size: 1.8rem !important;
    line-height: 1.08 !important;
    letter-spacing: -0.04em !important;
    margin-bottom: 15px !important;
    color: #FFFFFF !important;
  }
  .avp-pain-card p {
    font-size: 1.1rem;
    color: #CBD5E1 !important;
    line-height: 1.7;
  }

  /* ====== BLOCK 4: APPLE STICKY SHOWCASE (SECCIÓN BLANCA DE SHOCK VISUAL #FFFFFF) ====== */
  .apple-pin-container {
    position: relative;
    padding: 120px 0;
    background: var(--avp-bg-white) !important;
    color: var(--avp-text-dark) !important;
  }
  .apple-pin-container h2 {
    color: var(--avp-text-dark) !important;
    font-size: 3rem !important;
    font-weight: 900 !important;
    line-height: 1.08 !important;
    letter-spacing: -0.04em !important;
  }
  .apple-pin-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .apple-pin-card-light {
    background: #F1F5F9 !important;
    border: 1px solid var(--avp-border-dark) !important;
    border-radius: 28px;
    padding: 35px;
  }
  .apple-pin-card-light h3 {
    color: var(--avp-text-dark) !important;
    font-size: 1.5rem !important;
    line-height: 1.08 !important;
    margin-bottom: 10px !important;
  }
  .apple-pin-card-light p {
    color: var(--avp-text-dark-muted) !important;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  
  /* TARJETA STICKY NEGRA TECH EN SECCIÓN BLANCA (ESTILO VERCEL) */
  .apple-pin-sticky {
    position: sticky;
    top: 100px;
    background: var(--avp-bg-graphite) !important;
    border: 2px solid var(--avp-cyan) !important;
    border-radius: 36px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .apple-pin-sticky * {
    color: #FFFFFF !important;
  }

  /* ====== BLOCK 5: EFECTO ORION (GRIS GRAFITO #0A0A0C) ====== */
  .avp-features {
    padding: 120px 0;
    background: var(--avp-bg-graphite) !important;
    border-top: 1px solid var(--avp-border) !important;
    border-bottom: 1px solid var(--avp-border) !important;
  }
  .avp-features h2 {
    font-size: 2.8rem !important;
    font-weight: 900 !important;
    line-height: 1.08 !important;
    color: #FFFFFF !important;
  }
  .orion-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 50px;
  }
  .orion-card {
    position: relative;
    background: #141417 !important;
    border: 1px solid var(--avp-border) !important;
    border-radius: 28px;
    padding: 40px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .orion-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(0, 236, 255, 0.14), transparent 40%);
    pointer-events: none;
    border-radius: inherit;
  }
  .orion-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 236, 255, 0.5) !important;
  }
  .orion-card h3 {
    font-size: 1.5rem !important;
    font-weight: 800 !important;
    margin-bottom: 12px !important;
    color: #FFFFFF !important;
  }
  .orion-card p {
    color: var(--avp-text-muted) !important;
  }

  /* ====== BLOCK 6: TABLA COMPARATIVA (NEGRO ABSOLUTO #000000) ====== */
  .avp-table-section {
    padding: 120px 0;
    background: var(--avp-bg-black) !important;
  }
  .avp-table-section h2 {
    font-size: 2.8rem !important;
    font-weight: 900 !important;
    line-height: 1.08 !important;
    color: #FFFFFF !important;
  }
  .avp-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 40px;
    text-align: left;
  }
  .avp-table th, .avp-table td {
    padding: 20px 24px;
    border-bottom: 1px solid var(--avp-border) !important;
    color: #FFFFFF !important;
    background-color: transparent !important;
  }
  .avp-table th {
    font-size: 1.1rem;
    font-weight: 800;
    background: var(--avp-bg-graphite) !important;
  }
  .avp-table tbody tr:nth-child(odd) td {
    background-color: rgba(255, 255, 255, 0.02) !important;
  }
  .avp-table tbody tr:nth-child(even) td {
    background-color: rgba(255, 255, 255, 0.05) !important;
  }
  .avp-table .highlight-col {
    background: rgba(0, 236, 255, 0.08) !important;
    border-left: 2px solid var(--avp-cyan) !important;
    border-right: 2px solid var(--avp-cyan) !important;
  }

  /* ====== BLOCK 7: SIMULADOR DUAL (GRIS CLARO CLÍNICO #F8FAFC) ====== */
  .avp-sim-section-light {
    padding: 120px 0;
    background: var(--avp-bg-light) !important;
    color: var(--avp-text-dark) !important;
    border-top: 1px solid var(--avp-border-dark) !important;
    border-bottom: 1px solid var(--avp-border-dark) !important;
  }
  .avp-sim-section-light h2 {
    color: var(--avp-text-dark) !important;
    font-size: 2.8rem !important;
    font-weight: 900 !important;
    line-height: 1.08 !important;
  }
  .avp-sim-box-dark {
    background: var(--avp-bg-slate) !important;
    border: 2px solid var(--avp-cyan) !important;
    border-radius: 36px;
    padding: 50px;
    box-shadow: 0 20px 60px rgba(15,23,42,0.25);
  }
  .avp-sim-box-dark * {
    color: #FFFFFF !important;
  }

  /* ====== BLOCK 8: PREGUNTAS FRECUENTES (GRIS GRAFITO #0A0A0C) ====== */
  .avp-faq {
    padding: 120px 0;
    background: var(--avp-bg-graphite) !important;
  }
  .avp-faq h2 {
    font-size: 2.8rem !important;
    font-weight: 900 !important;
    line-height: 1.08 !important;
    color: #FFFFFF !important;
  }
  .avp-faq-item {
    border-bottom: 1px solid var(--avp-border) !important;
    padding: 24px 0;
  }
  .avp-faq-question {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF !important;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .avp-faq-answer {
    display: none;
    padding-top: 15px;
    color: var(--avp-text-muted) !important;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .avp-faq-item.active .avp-faq-answer {
    display: block;
  }

  /* ====== BLOCK 9: PITCH BOX FINAL (NEGRO PROFUNDO #000000) ====== */
  .avp-pitch-section {
    padding: 100px 0;
    background: var(--avp-bg-black) !important;
  }

  /* ====== STICKY MOBILE CHECKOUT FOOTER ====== */
  .avp-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(10, 10, 10, 0.65) !important;
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.3);
    padding: 14px 24px;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .avp-sticky-bar.is-visible {
    transform: translateY(0);
  }

  @keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0.3; }
    100% { opacity: 1; }
  }

  /* ====== RESPONSIVE ====== */
  @media (max-width: 768px) {
    .avp-hero__grid, .orion-grid, .apple-pin-grid {
      grid-template-columns: 1fr;
    }
    .avp-hero h1 {
      font-size: 2.2rem !important;
    }
    .avp-hero__visual {
      position: relative;
      top: 0;
    }
  }
</style>

<div class="atacama-vision-pro">

  <!-- BLOCK 1: HERO & BUY BOX (ZONA 1: NEGRO PROFUNDO TECH #000000) -->
  <section class="avp-hero">
    <div class="avp-wrap avp-fade">
      <div class="avp-hero__grid">
        
        <!-- LADO IZQUIERDO: VISUAL DEL PRODUCTO CON BADGE DE USO REAL -->
        <div class="avp-hero__visual">
          {% if product.featured_image %}
            <div style="position: relative; overflow: hidden; border-radius: 32px;">
              <img src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}" class="avp-hero-img">
              
              <div style="position: absolute; bottom: 20px; left: 20px; background: rgba(0,0,0,0.85); backdrop-filter: blur(12px); border: 1px solid rgba(0,236,255,0.4); padding: 12px 18px; border-radius: 18px; display: flex; align-items: center; gap: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.8);">
                <span style="width: 10px; height: 10px; background: var(--avp-cyan); border-radius: 50%; display: inline-block; box-shadow: 0 0 10px var(--avp-cyan);"></span>
                <div>
                  <div style="color: #FFFFFF !important; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.05em;">USO REAL: FOTOCROMÍA Y AUDIO EN RUTA</div>
                  <div style="color: var(--avp-text-muted) !important; font-size: 0.7rem;">Cero pantallas desvelantes • Alerta 100% al tráfico</div>
                </div>
              </div>
            </div>
          {% else %}
            <div class="avp-hero-placeholder">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              <span style="color:#FFFFFF !important;">ATACAMA VISION PRO® - FOTO 4K</span>
            </div>
          {% endif %}
        </div>

        <!-- LADO DERECHO: BUY BOX TRANSACCIONAL HIPER-DENSO (REGLA 27) -->
        <div class="avp-hero__buybox">
          <div class="avp-stars">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span style="color:#FFFFFF !important;">4.9/5 (Más de 15,000 Conductores y Atletas)</span>
          </div>

          <h1>{{ product.title | default: 'Atacama Vision PRO®' }}</h1>
          <p>Lentes inteligentes fotocromáticos con cambio de tinte a un clic, traducción por voz simultánea con IA y sonido espacial de oído libre.</p>

          <div class="avp-hero__price">
            {% if product %}
              <span class="price-current">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="price-compare">{{ product.compare_at_price | money }}</span>
                <span style="background:#E60000; color:#FFFFFF !important; font-size:0.75rem; font-weight:900; padding:4px 10px; border-radius:6px; letter-spacing:0.05em;">SALE - 57% OFF</span>
              {% endif %}
            {% else %}
              <span class="price-current">$59,990 CLP</span>
              <span class="price-compare">$140,000 CLP</span>
            {% endif %}
          </div>

          <!-- BANNER MERCADOPAGO -->
          <div class="avp-mp-card">
            <img src="https://http2.mlstatic.com/frontend-assets/mp-web-navigation/ui-navigation/5.19.1/mercadopago/logo__small@2x.png" alt="Mercado Pago" style="width:40px; height:40px; object-fit:contain; background:#FFF; border-radius:8px; padding:4px; flex-shrink:0;">
            <div style="display:flex; flex-direction:column; gap:2px;">
              <div style="font-size:0.95rem; font-weight:700; color:#FFFFFF !important;">
