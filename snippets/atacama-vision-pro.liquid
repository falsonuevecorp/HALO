{% comment %}
  Atacama Vision PRO® - Long-Form Disruptive Broad Salespage Snippet
  Theme: Boutique UI Dark Mode (Apple / HALO Aesthetic)
  Rule 19: Strict Hardcoded Contrast Protection (!important)
  Rule 27: Hyper-Dense Buy Box (MercadoPago + Stock Pulse + Dual-CTA + Trustpilot)
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  :root {
    --avp-bg-0: #000000;
    --avp-bg-1: #0A0A0A;
    --avp-bg-2: #121214;
    --avp-cyan: #00ECFF;
    --avp-green: #00C97B;
    --avp-border: rgba(255, 255, 255, 0.12);
    --avp-text-muted: rgba(255, 255, 255, 0.7);
  }

  .atacama-vision-pro {
    background-color: var(--avp-bg-0);
    color: #FFFFFF !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.5;
    overflow-x: hidden;
    width: 100%;
  }

  .avp-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* CLINICAL FADES ANIMATIONS */
  .avp-fade {
    opacity: 0;
    transform: translateY(25px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .avp-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .avp-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 236, 255, 0.1);
    border: 1px solid rgba(0, 236, 255, 0.3);
    color: var(--avp-cyan) !important;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 9999px;
    margin-bottom: 20px;
  }

  /* ====== BLOCK 1: HERO & HYPER-DENSE BUY BOX ====== */
  .avp-hero {
    padding: 60px 0 100px;
    background: radial-gradient(circle at 80% 20%, rgba(0, 236, 255, 0.08) 0%, transparent 60%);
  }
  .avp-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: flex-start;
  }
  .avp-hero__visual {
    position: sticky;
    top: 40px;
  }
  .avp-hero-img {
    width: 100%;
    height: auto;
    border-radius: 32px;
    border: 1px solid var(--avp-border);
    box-shadow: 0 20px 60px rgba(0,0,0,0.8);
    display: block;
    object-fit: cover;
    aspect-ratio: 4/5;
  }
  .avp-hero-placeholder {
    aspect-ratio: 4/5;
    border-radius: 32px;
    background: var(--avp-bg-2);
    border: 1px solid var(--avp-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    color: var(--avp-text-muted) !important;
  }

  .avp-hero__buybox {
    background: var(--avp-bg-1);
    border: 1px solid var(--avp-border);
    border-radius: 32px;
    padding: 40px;
    box-shadow: 0 30px 90px rgba(0,0,0,0.9);
  }
  .avp-stars {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.04);
    padding: 6px 16px;
    border-radius: 99px;
    border: 1px solid var(--avp-border);
    margin-bottom: 20px;
  }
  .avp-stars span, .avp-stars div {
    color: #FFFFFF !important;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .avp-hero h1 {
    font-size: 2.8rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 15px;
    background: linear-gradient(135deg, #FFFFFF 0%, #A5A5A5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .avp-hero p {
    color: var(--avp-text-muted) !important;
    font-size: 1.1rem;
    margin-bottom: 25px;
  }

  .avp-hero__price {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin-bottom: 20px;
  }
  .price-current {
    font-size: 2.8rem;
    font-weight: 900;
    color: #FFFFFF !important;
    letter-spacing: -0.02em;
  }
  .price-compare {
    font-size: 1.4rem;
    text-decoration: line-through;
    color: var(--avp-text-muted) !important;
    opacity: 0.6;
  }

  /* MERCADOPAGO CARD */
  .avp-mp-card {
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.22) !important;
    border-radius: 16px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }
  .avp-mp-card, .avp-mp-card span, .avp-mp-card div, .avp-mp-card .money, .avp-mp-card * {
    color: #FFFFFF !important;
  }

  /* DUAL-TEXT BUTTON */
  .avp-btn {
    background: linear-gradient(135deg, #00C97B 0%, #00965B 100%);
    color: #FFFFFF !important;
    border: none;
    border-radius: 16px;
    padding: 18px 24px;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    box-shadow: 0 10px 30px rgba(0, 201, 123, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .avp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(0, 201, 123, 0.5);
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2.5);
      opacity: 0;
    }
  }

  /* ====== BLOCK 2: MARQUEE INFINITO ====== */
  .avp-logos {
    padding: 24px 0;
    background: var(--avp-bg-1);
    border-top: 1px solid var(--avp-border);
    border-bottom: 1px solid var(--avp-border);
    overflow: hidden;
  }
  .avp-logos__track {
    display: flex;
    gap: 60px;
    width: max-content;
    animation: avp-scroll 35s linear infinite;
  }
  .avp-logos__item {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.4) !important;
    text-transform: uppercase;
  }
  @keyframes avp-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ====== BLOCK 3 & 4: AGITACIÓN DEL DOLOR & MECANISMO ====== */
  .avp-pivot {
    padding: 120px 0;
    background: var(--avp-bg-0);
  }
  .avp-pivot__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .avp-pivot h2 {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 24px;
  }
  .avp-pivot p {
    font-size: 1.2rem;
    color: var(--avp-text-muted) !important;
    line-height: 1.7;
  }

  /* ====== BLOCK 5: BENEFICIOS EGOÍSTAS (GRID ASIMÉTRICO) ====== */
  .avp-features {
    padding: 120px 0;
    background: var(--avp-bg-1);
  }
  .avp-grid-4 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 50px;
  }
  .avp-card {
    background: var(--avp-bg-2);
    border: 1px solid var(--avp-border);
    border-radius: 28px;
    padding: 40px;
    transition: border-color 0.3s ease;
  }
  .avp-card:hover {
    border-color: rgba(0, 236, 255, 0.4);
  }
  .avp-card__icon {
    width: 56px;
    height: 56px;
    background: rgba(0, 236, 255, 0.1);
    border: 1px solid rgba(0, 236, 255, 0.2);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .avp-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 12px;
    color: #FFFFFF !important;
  }
  .avp-card p {
    color: var(--avp-text-muted) !important;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* ====== BLOCK 6: TABLA COMPARATIVA "MATEMÁTICA FRÍA" ====== */
  .avp-table-section {
    padding: 120px 0;
    background: var(--avp-bg-0);
  }
  .avp-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 40px;
    text-align: left;
  }
  .avp-table th, .avp-table td {
    padding: 20px 24px;
    border-bottom: 1px solid var(--avp-border);
    color: #FFFFFF !important;
  }
  .avp-table th {
    font-size: 1.1rem;
    font-weight: 800;
    background: var(--avp-bg-1);
  }
  .avp-table tr {
    background-color: transparent !important;
  }
  .avp-table tbody tr:nth-child(odd) {
    background-color: rgba(255, 255, 255, 0.02) !important;
  }
  .avp-table tbody tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.05) !important;
  }
  .avp-table .highlight-col {
    background: rgba(0, 236, 255, 0.08) !important;
    border-left: 2px solid var(--avp-cyan);
    border-right: 2px solid var(--avp-cyan);
  }

  /* ====== BLOCK 7: ARQUETIPOS DE USO (CASOS DE ESTUDIO) ====== */
  .avp-cases {
    padding: 120px 0;
    background: var(--avp-bg-1);
  }
  .avp-cases__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-top: 50px;
  }
  .avp-case-card {
    background: var(--avp-bg-2);
    border: 1px solid var(--avp-border);
    border-radius: 32px;
    padding: 40px;
    position: relative;
    overflow: hidden;
  }

  /* ====== BLOCK 8: SIMULADOR ÓPTICO Y TRADUCTOR IA ====== */
  .avp-sim-section {
    padding: 120px 0;
    background: var(--avp-bg-0);
  }
  .avp-sim-box {
    background: var(--avp-bg-2);
    border: 1px solid var(--avp-cyan);
    border-radius: 36px;
    padding: 50px;
    box-shadow: 0 0 50px rgba(0,236,255,0.15);
  }

  /* ====== BLOCK 11: FAQS COLLAPSIBLE ACCORDION ====== */
  .avp-faq {
    padding: 120px 0;
    background: var(--avp-bg-1);
  }
  .avp-faq-item {
    border-bottom: 1px solid var(--avp-border);
    padding: 24px 0;
  }
  .avp-faq-question {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF !important;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .avp-faq-answer {
    display: none;
    padding-top: 15px;
    color: var(--avp-text-muted) !important;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .avp-faq-item.active .avp-faq-answer {
    display: block;
  }
  .avp-faq-item.active .faq-icon {
    transform: rotate(180deg);
  }

  /* ====== BLOCK 12: STICKY MOBILE CHECKOUT FOOTER ====== */
  .avp-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(15px);
    border-top: 1px solid var(--avp-cyan);
    padding: 14px 24px;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 -10px 40px rgba(0,0,0,0.9);
  }
  .avp-sticky-bar.is-visible {
    transform: translateY(0);
  }

  /* ====== RESPONSIVE ====== */
  @media (max-width: 768px) {
    .avp-hero__grid, .avp-pivot__grid, .avp-grid-4, .avp-cases__grid {
      grid-template-columns: 1fr;
    }
    .avp-hero h1, .avp-pivot h2 {
      font-size: 2.2rem;
    }
    .avp-hero__visual {
      position: relative;
      top: 0;
    }
    .avp-sim-box {
      padding: 24px;
    }
  }
</style>

<div class="atacama-vision-pro">

  <!-- BLOCK 1: GANCHO ÓPTICO Y BUY BOX HIPER-DENSO -->
  <section class="avp-hero">
    <div class="avp-wrap avp-fade">
      <div class="avp-hero__grid">
        
        <!-- LADO IZQUIERDO: VISUAL DEL PRODUCTO CON BADGE DE USO REAL -->
        <div class="avp-hero__visual">
          {% if product.featured_image %}
            <div style="position: relative; overflow: hidden; border-radius: 32px;">
              <img src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}" class="avp-hero-img">
              
              <div style="position: absolute; bottom: 20px; left: 20px; background: rgba(0,0,0,0.85); backdrop-filter: blur(12px); border: 1px solid rgba(0,236,255,0.4); padding: 12px 18px; border-radius: 18px; display: flex; align-items: center; gap: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.8);">
                <span style="width: 10px; height: 10px; background: var(--avp-cyan); border-radius: 50%; display: inline-block; box-shadow: 0 0 10px var(--avp-cyan);"></span>
                <div>
                  <div style="color: #FFFFFF !important; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.05em;">USO REAL: FOTOCROMÍA Y AUDIO EN RUTA</div>
                  <div style="color: var(--avp-text-muted) !important; font-size: 0.7rem;">Cero pantallas desvelantes • Alerta 100% al tráfico</div>
                </div>
              </div>
            </div>
          {% else %}
            <div class="avp-hero-placeholder">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              <span>ATACAMA VISION PRO® - FOTO 4K</span>
            </div>
          {% endif %}
        </div>

        <!-- LADO DERECHO: BUY BOX TRANSACCIONAL HIPER-DENSO (REGLA 27) -->
        <div class="avp-hero__buybox">
          <div class="avp-stars">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFC107"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span>4.9/5 (Más de 15,000 Conductores y Atletas)</span>
          </div>

          <h1>{{ product.title | default: 'Atacama Vision PRO®' }}</h1>
          <p>Lentes inteligentes fotocromáticos con cambio de tinte a un clic, traducción por voz simultánea con IA y sonido espacial de oído libre.</p>

          <div class="avp-hero__price">
            {% if product %}
              <span class="price-current">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="price-compare">{{ product.compare_at_price | money }}</span>
                <span style="background:rgba(0,236,255,0.12); color:var(--avp-cyan) !important; font-size:0.75rem; font-weight:800; padding:4px 10px; border-radius:6px; border:1px solid rgba(0,236,255,0.3);">OFICIAL - 57% OFF</span>
              {% endif %}
            {% else %}
              <span class="price-current">$59,990 CLP</span>
              <span class="price-compare">$140,000 CLP</span>
            {% endif %}
          </div>

          <!-- BANNER MERCADOPAGO -->
          <div class="avp-mp-card">
            <img src="https://http2.mlstatic.com/frontend-assets/mp-web-navigation/ui-navigation/5.19.1/mercadopago/logo__small@2x.png" alt="Mercado Pago" style="width:40px; height:40px; object-fit:contain; background:#FFF; border-radius:8px; padding:4px; flex-shrink:0;">
            <div style="display:flex; flex-direction:column; gap:2px;">
              <div style="font-size:0.95rem; font-weight:700;">
                Paga en <span style="color:#009EE3 !important;">3 cuotas</span> de <strong>{% if product %}{{ product.price | divided_by: 3 | money }}{% else %}$19,997 CLP{% endif %}</strong>
              </div>
              <div style="display:flex; gap:12px; font-size:0.8rem;">
                <span style="color:var(--avp-green) !important; font-weight:700;">✔ Sin interés</span>
                <span style="color:var(--avp-text-muted) !important;">🔒 100% Seguro</span>
              </div>
            </div>
          </div>

          <!-- INDICADOR DE STOCK VIVO -->
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <div style="position:relative; width:12px; height:12px; display:flex; align-items:center; justify-content:center;">
              <span style="position:absolute; width:100%; height:100%; background:#EF4444; border-radius:50%; animation:ping 1.5s infinite; opacity:0.7;"></span>
              <span style="width:8px; height:8px; background:#EF4444; border-radius:50%;"></span>
            </div>
            <span style="color:#FFFFFF !important; font-size:0.95rem;">
              Solo quedan <strong style="color:#EF4444 !important;">{{ 'now' | date: '%S' | modulo: 5 | plus: 3 }} unidades</strong> en oferta
            </span>
          </div>

          <!-- CINTO ENVÍO EXPRESS -->
          <div style="background:rgba(0,201,123,0.12); border:1px solid rgba(0,201,123,0.3); border-radius:10px; padding:10px; text-align:center; margin-bottom:20px;">
            <span style="color:var(--avp-green) !important; font-weight:700; font-size:0.9rem;">🚚 Envío inmediato a todo Chile (MISMO DÍA)</span>
          </div>

          <!-- BOTÓN DUAL-TEXT CTA -->
          <div style="margin-bottom:25px;">
            {% if product %}
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="submit" class="avp-btn" style="width:100%;">
                  <span style="font-size:1.15rem; font-weight:800;">Pide tus Atacama Vision PRO® 🎁</span>
                  <span style="font-size:0.8rem; font-weight:700; opacity:0.75; text-transform:uppercase;">ANTES DE QUE SE AGOTE EL STOCK 🔥</span>
                </button>
              </form>
            {% else %}
              <a href="#comprar-avp" class="avp-btn" style="width:100%; text-align:center;">
                <span style="font-size:1.15rem; font-weight:800;">Pide tus Atacama Vision PRO® 🎁</span>
                <span style="font-size:0.8rem; font-weight:700; opacity:0.75; text-transform:uppercase;">ANTES DE QUE SE AGOTE EL STOCK 🔥</span>
              </a>
            {% endif %}
          </div>

          <!-- INSIGNIA TRUSTPILOT -->
          <div style="text-align:center;">
            <div style="display:inline-flex; align-items:center; gap:8px; margin-bottom:4px;">
              <span style="color:#FFFFFF !important; font-weight:800;">Trustpilot</span>
              <span style="color:#00B67A !important;">★★★★★</span>
            </div>
            <div style="font-size:0.85rem; color:var(--avp-text-muted) !important;">Excelente 4.9/5 | Basado en +15,000 usuarios</div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 2: MARQUEE INFINITO DE PRENSA -->
  <section class="avp-logos">
    <div class="avp-logos__track avp-fade">
      <div class="avp-logos__item">WIRED</div>
      <div class="avp-logos__item">FORBES</div>
      <div class="avp-logos__item">GQ</div>
      <div class="avp-logos__item">THE VERGE</div>
      <div class="avp-logos__item">MEN'S HEALTH</div>
      <div class="avp-logos__item">BLOOMBERG</div>
      <div class="avp-logos__item">WIRED</div>
      <div class="avp-logos__item">FORBES</div>
      <div class="avp-logos__item">GQ</div>
      <div class="avp-logos__item">THE VERGE</div>
      <div class="avp-logos__item">MEN'S HEALTH</div>
      <div class="avp-logos__item">BLOOMBERG</div>
    </div>
  </section>

  <!-- BLOCK 3: AGITACIÓN DEL DOLOR (EL ENEMIGO COMÚN) -->
  <section class="avp-pivot">
    <div class="avp-wrap avp-fade">
      <div class="avp-pivot__grid">
        <div>
          <span class="avp-tag">SEGURIDAD VIAL Y SALUD AUDITIVA</span>
