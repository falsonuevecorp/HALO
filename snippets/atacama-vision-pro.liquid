<script>
  // EFECTO ORION: MOUSE GLOW TRACKER
  document.addEventListener('mousemove', e => {
    const cards = document.querySelectorAll('.orion-card');
    cards.forEach(card => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // CLINICAL FADES ON SCROLL
  document.addEventListener('DOMContentLoaded', function() {
    const fadeEls = document.querySelectorAll('.avp-fade');
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { root: null, threshold: 0.08 });
    fadeEls.forEach(el => observer.observe(el));

    // STICKY FOOTER ON SCROLL (>350px)
    const stickyFooter = document.getElementById('avp-sticky-footer');
    window.addEventListener('scroll', function() {
      if (window.scrollY > 350) {
        stickyFooter.classList.add('is-visible');
      } else {
        stickyFooter.classList.remove('is-visible');
      }
    });
  });

  // SIMULATOR MODE TOGGLE
  function setLensMode(mode) {
    const preview = document.getElementById('avp-lens-preview');
    if (mode === 'day') {
      preview.style.background = 'radial-gradient(circle, rgba(0,0,0,0.95) 0%, #000 100%)';
      preview.style.borderColor = 'var(--avp-cyan)';
      preview.style.boxShadow = '0 0 50px rgba(0,236,255,0.5)';
    } else {
      preview.style.background = 'radial-gradient(circle, rgba(0,236,255,0.25) 0%, rgba(255,255,255,0.05) 100%)';
      preview.style.borderColor = 'rgba(255,255,255,0.5)';
      preview.style.boxShadow = '0 0 20px rgba(255,255,255,0.2)';
    }
  }

  // ACCORDION TOGGLE
  function toggleFaq(element) {
    element.classList.toggle('active');
  }
</script>
