{%- comment -%}
  HALO · paneles animados con los datos que entrega la app.

  NO son capturas de la app: son ilustraciones de la marca, en castellano y con
  el aire de la página. Van rotuladas como ejemplo, y se reemplazan por capturas
  reales en cuanto haya una banda a mano.

  Uso: {% render 'halo-app-visual', bloque: 'noche' | 'dia' | 'sesion' %}
{%- endcomment -%}

{%- if estilos -%}
<style id="halo-app-visual-css">
  .hav {
    max-width: 560px; margin: 32px auto 0; padding: 20px 18px 18px;
    background: #FFFFFF; border: 1px solid rgba(10,15,19,.10);
    border-radius: 18px; box-shadow: 0 14px 40px rgba(10,15,19,.07);
    font-variant-numeric: tabular-nums;
  }
  .hav__cab { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 16px; }
  .hav__tit { font-size: .74rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--text-muted) !important; }
  .hav__fecha { font-size: .7rem; color: var(--text-subtle) !important; }
  .hav__pie { margin-top: 14px; font-size: .66rem; color: var(--text-subtle) !important; text-align: center; }

  /* ---------- anillo ---------- */
  .hav__anillo { display: flex; align-items: center; gap: 20px; }
  .hav__rosca { position: relative; flex: 0 0 auto; }
  .hav__rosca svg { display: block; transform: rotate(-90deg); }
  .hav__rosca circle { fill: none; stroke-linecap: round; }
  .hav__rosca .pista { stroke: rgba(10,15,19,.07); }
  .hav__rosca .arco { stroke-dasharray: var(--largo); stroke-dashoffset: var(--resto); }
  .hav.on .hav__rosca .arco { animation: hav-dibuja 1.5s cubic-bezier(.22,.9,.3,1) backwards; }
  @keyframes hav-dibuja { from { stroke-dashoffset: var(--largo); } }
  .hav__centro { position: absolute; inset: 0; display: flex; flex-direction: column;
                 align-items: center; justify-content: center; }
  .hav__centro b { font-size: 1.35rem; font-weight: 800; color: var(--text-white) !important; line-height: 1; }
  .hav__centro span { font-size: .62rem; color: var(--text-subtle) !important; margin-top: 3px; }

  /* ---------- cifras ---------- */
  .hav__cifras { flex: 1 1 auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 10px; }
  .hav__cifra { border-left: 3px solid var(--tono, var(--cyan-orbit)); padding-left: 9px; }
  .hav__cifra b { display: block; font-size: 1rem; font-weight: 800; color: var(--text-white) !important; line-height: 1.15; }
  .hav__cifra span { display: block; font-size: .66rem; color: var(--text-subtle) !important; margin-top: 1px; }

  /* ---------- hipnograma ---------- */
  .hav__hipno { display: flex; align-items: flex-end; gap: 2px; height: 56px; margin-top: 16px; }
  .hav__hipno i { flex: 1 1 auto; border-radius: 2px; background: var(--tono);
                  height: var(--alto); transform-origin: bottom; }
  .hav.on .hav__hipno i { animation: hav-sube .5s cubic-bezier(.22,.9,.3,1) var(--retraso) backwards; }
  @keyframes hav-sube { from { transform: scaleY(0); } }
  .hav__horas { display: flex; justify-content: space-between; margin-top: 6px;
                font-size: .62rem; color: var(--text-subtle) !important; }

  /* ---------- curva de pulso ---------- */
  .hav__curva { margin-top: 4px; }
  .hav__curva svg { width: 100%; height: 92px; display: block; overflow: visible; }
  .hav__curva .linea { fill: none; stroke: #E53935; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round;
                       stroke-dasharray: 1200; stroke-dashoffset: 0; }
  .hav.on .hav__curva .linea { animation: hav-traza 1.8s ease-out backwards; }
  @keyframes hav-traza { from { stroke-dashoffset: 1200; } }
  .hav__curva .relleno { fill: url(#havDeg); }
  .hav.on .hav__curva .relleno { animation: hav-aparece .8s ease-out 1.1s backwards; }
  @keyframes hav-aparece { from { opacity: 0; } }

  /* ---------- zonas ---------- */
  .hav__zonas { margin-top: 16px; display: grid; gap: 9px; }
  .hav__zona { display: grid; grid-template-columns: 9px 1fr auto; align-items: center; gap: 10px; }
  .hav__punto { width: 9px; height: 9px; border-radius: 50%; background: var(--tono); }
  .hav__barra { height: 7px; border-radius: 999px; background: rgba(10,15,19,.06); overflow: hidden; }
  .hav__barra i { display: block; height: 100%; border-radius: 999px; background: var(--tono);
                  width: var(--ancho); transform-origin: left; }
  .hav.on .hav__barra i { animation: hav-crece .8s cubic-bezier(.22,.9,.3,1) var(--retraso) backwards; }
  @keyframes hav-crece { from { transform: scaleX(0); } }
  .hav__zona > span:last-child { font-size: .72rem; color: var(--text-muted) !important; white-space: nowrap; }
  .hav__zona em { font-style: normal; font-weight: 700; color: var(--text-white) !important; }
  .hav__etq { font-size: .72rem; color: var(--text-muted) !important; }

  @media (max-width: 560px) {
    .hav__anillo { flex-direction: column; align-items: stretch; gap: 16px; }
    .hav__rosca { align-self: center; }
    .hav__centro b { font-size: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hav .arco, .hav__hipno i, .hav__curva .linea, .hav__curva .relleno, .hav__barra i {
      animation: none !important;
    }
  }
</style>
<script>
  /* Se animan al entrar en pantalla: si arrancaran al cargar, nadie las vería. */
  (function () {
    function armar() {
      var ob = new IntersectionObserver(function (filas) {
        filas.forEach(function (f) {
          if (f.isIntersecting) { f.target.classList.add('on'); ob.unobserve(f.target); }
        });
      }, { threshold: 0.3 });
      document.querySelectorAll('.hav').forEach(function (n) { ob.observe(n); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', armar);
    else armar();
  })();
</script>
{%- endif -%}


{%- if bloque == 'noche' -%}
<div class="hav" role="img" aria-label="Ejemplo de una noche medida: 7 horas 10 minutos dormidas, 2 horas 35 de sueño profundo y 58 pulsaciones de media.">
  <div class="hav__cab">
    <span class="hav__tit">Tu noche</span>
    <span class="hav__fecha">23:40 → 07:05</span>
  </div>
  <div class="hav__anillo">
    <div class="hav__rosca" style="width:112px; height:112px;">
      <svg viewBox="0 0 112 112" width="112" height="112" aria-hidden="true">
        <circle class="pista" cx="56" cy="56" r="48" stroke-width="11"></circle>
        <circle class="arco" cx="56" cy="56" r="48" stroke-width="11" stroke="#6C4CE0"
                style="--largo:301.6; --resto:33.2;"></circle>
        <circle class="pista" cx="56" cy="56" r="34" stroke-width="9"></circle>
        <circle class="arco" cx="56" cy="56" r="34" stroke-width="9" stroke="#C044C9"
                style="--largo:213.6; --resto:136.7; animation-delay:.25s;"></circle>
      </svg>
      <div class="hav__centro"><b>7h 10m</b><span>dormidas</span></div>
    </div>
    <div class="hav__cifras">
      <div class="hav__cifra" style="--tono:#C044C9"><b>2h 35m</b><span>Sueño profundo</span></div>
      <div class="hav__cifra" style="--tono:#6C4CE0"><b>4h 35m</b><span>Sueño ligero</span></div>
      <div class="hav__cifra" style="--tono:#E53935"><b>58 ppm</b><span>Pulso medio</span></div>
      <div class="hav__cifra" style="--tono:#8A95A8"><b>2</b><span>Despertares</span></div>
    </div>
  </div>
  <div class="hav__hipno">
    {%- assign alturas = '30,54,46,24,18,40,56,50,22,16,26,52,44,20,34,56,48,26,18,38,54,42,24,32' | split: ',' -%}
    {%- for a in alturas -%}
      {%- assign n = forloop.index0 | times: 35 -%}
      {%- assign profundo = a | plus: 0 -%}
      <i style="--alto:{{ a }}%; --retraso:{{ n }}ms; --tono:{% if profundo > 40 %}#6C4CE0{% else %}#C044C9{% endif %};"></i>
    {%- endfor -%}
  </div>
  <div class="hav__horas"><span>23:40</span><span>03:20</span><span>07:05</span></div>
  <div class="hav__pie">Ejemplo de una noche · los datos que entrega la app</div>
</div>
{%- endif -%}


{%- if bloque == 'dia' -%}
<div class="hav" role="img" aria-label="Ejemplo de un día: 8.420 pasos, 612 kilocalorías, 6,2 kilómetros y 74 minutos activos.">
  <div class="hav__cab">
    <span class="hav__tit">Tu día</span>
    <span class="hav__fecha">Meta 10.000 pasos</span>
  </div>
  <div class="hav__anillo">
    <div class="hav__rosca" style="width:112px; height:112px;">
      <svg viewBox="0 0 112 112" width="112" height="112" aria-hidden="true">
        <circle class="pista" cx="56" cy="56" r="48" stroke-width="12"></circle>
        <circle class="arco" cx="56" cy="56" r="48" stroke-width="12" stroke="#E8720C"
                style="--largo:301.6; --resto:47.7;"></circle>
      </svg>
      <div class="hav__centro"><b>8.420</b><span>pasos</span></div>
    </div>
    <div class="hav__cifras">
      <div class="hav__cifra" style="--tono:#E8720C"><b>612 kcal</b><span>Quemadas hoy</span></div>
      <div class="hav__cifra" style="--tono:#007A8C"><b>6,2 km</b><span>Recorridos</span></div>
      <div class="hav__cifra" style="--tono:#008A54"><b>74 min</b><span>En movimiento</span></div>
      <div class="hav__cifra" style="--tono:#E53935"><b>62 ppm</b><span>Pulso en reposo</span></div>
    </div>
  </div>
  <div class="hav__zonas" style="margin-top:18px;">
    {%- assign dias = 'Lun,58;Mar,74;Mié,41;Jue,88;Vie,66;Sáb,95;Dom,52' | split: ';' -%}
    {%- for d in dias -%}
      {%- assign par = d | split: ',' -%}
      {%- assign ret = forloop.index0 | times: 90 -%}
      <div class="hav__zona" style="--tono:#E8720C">
        <span class="hav__etq" style="width:auto">{{ par[0] }}</span>
        <div class="hav__barra"><i style="--ancho:{{ par[1] }}%; --retraso:{{ ret }}ms;"></i></div>
        <span><em>{{ par[1] | times: 7 }}</em> kcal</span>
      </div>
    {%- endfor -%}
  </div>
  <div class="hav__pie">Ejemplo de una semana · los datos que entrega la app</div>
</div>
{%- endif -%}


{%- if bloque == 'sesion' -%}
<div class="hav" role="img" aria-label="Ejemplo de una sesión: 474 kilocalorías, 1 hora 3 minutos, pulso medio 138 y máximo 171, con 26 minutos en quema de grasa.">
  <div class="hav__cab">
    <span class="hav__tit">Tu sesión · Trote</span>
    <span class="hav__fecha">07:53 → 08:56</span>
  </div>
  <div class="hav__cifras" style="grid-template-columns:repeat(4,1fr); margin-bottom:16px;">
    <div class="hav__cifra" style="--tono:#E8720C"><b>474</b><span>kcal</span></div>
    <div class="hav__cifra" style="--tono:#007A8C"><b>1h 03m</b><span>Duración</span></div>
    <div class="hav__cifra" style="--tono:#E53935"><b>138</b><span>Pulso medio</span></div>
    <div class="hav__cifra" style="--tono:#E53935"><b>171</b><span>Pulso máximo</span></div>
  </div>
  <div class="hav__curva">
    <svg viewBox="0 0 320 92" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="havDeg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#E53935" stop-opacity=".26"></stop>
          <stop offset="100%" stop-color="#E53935" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="relleno" d="M0,74 L14,66 L28,58 L42,60 L56,48 L70,40 L84,44 L98,32 L112,26 L126,30 L140,20 L154,16 L168,24 L182,18 L196,28 L210,22 L224,34 L238,30 L252,42 L266,38 L280,50 L294,56 L308,64 L320,70 L320,92 L0,92 Z"></path>
      <path class="linea" d="M0,74 L14,66 L28,58 L42,60 L56,48 L70,40 L84,44 L98,32 L112,26 L126,30 L140,20 L154,16 L168,24 L182,18 L196,28 L210,22 L224,34 L238,30 L252,42 L266,38 L280,50 L294,56 L308,64 L320,70"></path>
    </svg>
  </div>
  <div class="hav__zonas">
    {%- assign zonas = 'Límite,#B3001B,0,0;Resistencia anaeróbica,#E53935,4,15;Resistencia aeróbica,#E8720C,12,46;Quema de grasa,#008A54,26,100;Calentamiento,#007A8C,21,81' | split: ';' -%}
    {%- for z in zonas -%}
      {%- assign c = z | split: ',' -%}
      {%- assign ret = forloop.index0 | times: 110 -%}
      <div class="hav__zona" style="--tono:{{ c[1] }}">
        <span class="hav__punto"></span>
        <div class="hav__barra"><i style="--ancho:{{ c[3] }}%; --retraso:{{ ret }}ms;"></i></div>
        <span><em>{{ c[2] }}</em> min · {{ c[0] }}</span>
      </div>
    {%- endfor -%}
  </div>
  <div class="hav__pie">Ejemplo de una sesión · los datos que entrega la app</div>
</div>
{%- endif -%}
