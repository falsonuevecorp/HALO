{%- comment -%}
  HALO · barra flotante de vidrio (estilo Apple) + carro con la marca.
  - En la salespage el menú no se imprime (ver layout/theme.liquid), acá solo
    se anula el espacio que dejaba.
  - En el resto del sitio la barra flota sobre el contenido: sin franja blanca.
{%- endcomment -%}

{%- assign hl_sin_menu = false -%}
{%- if template.suffix == 'halo-salespage' or template.suffix == 'no-header' or template.suffix == 'landing-no-header' -%}
  {%- assign hl_sin_menu = true -%}
{%- endif -%}

<style id="halo-liquid-header-css">
  :root {
    --halo-verde: #00C97B;
    --halo-vidrio: rgba(14, 16, 20, 0.55);
    --halo-vidrio-alto: rgba(10, 11, 14, 0.78);
    --halo-borde: rgba(255, 255, 255, 0.14);
  }

  /* El contenido arranca pegado arriba: la barra flota encima, no empuja. */
  .container { padding-top: 0 !important; }

{%- if hl_sin_menu -%}
  .page__header { display: none !important; }
{%- else -%}

  /* ---------- la barra ---------- */
  .page__header {
    position: fixed !important;
    top: 14px;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: min(1180px, calc(100% - 28px));
    height: 58px !important;
    min-height: 0 !important;
    padding: 0 !important;
    z-index: 1000 !important;
    border-radius: 999px !important;
    background: var(--halo-vidrio) !important;
    -webkit-backdrop-filter: blur(26px) saturate(180%);
    backdrop-filter: blur(26px) saturate(180%);
    border: 1px solid var(--halo-borde) !important;
    box-shadow:
      0 10px 34px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 -1px 0 rgba(0, 0, 0, 0.30) !important;
    transition: top .32s cubic-bezier(.22,.61,.36,1),
                width .32s cubic-bezier(.22,.61,.36,1),
                background .32s ease, box-shadow .32s ease;
  }

  /* El reflejo especular que le da el aspecto de vidrio de verdad. */
  .page__header::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.03) 38%, rgba(255,255,255,0) 60%),
      radial-gradient(120% 180% at 12% -40%, rgba(255,255,255,0.20) 0%, rgba(255,255,255,0) 55%);
  }

  /* Al bajar se compacta y se opaca un poco: se lee sobre cualquier fondo. */
  .page__header.halo-scrolled {
    top: 8px;
    width: min(1040px, calc(100% - 20px));
    background: var(--halo-vidrio-alto) !important;
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.46),
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      inset 0 -1px 0 rgba(0, 0, 0, 0.34) !important;
  }

  .page__header--width {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 10px;
    height: 58px;
    padding: 0 10px !important;
    margin: 0 !important;
    max-width: none !important;
    position: relative;
    z-index: 1;
  }

  /* ---------- tipografía e iconos ---------- */
  .page__header,
  .page__header a,
  .page__header .nav__link,
  .page__header .minicart__label { color: #FFFFFF !important; }
  .page__header svg path { fill: #FFFFFF !important; }

  .page__header .nav__link {
    font-size: 0.9rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.01em;
    padding: 8px 14px !important;
    border-radius: 999px !important;
    opacity: 0.86;
    transition: background .2s ease, opacity .2s ease;
  }
  .page__header .nav__link:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.12) !important;
  }

  /* Cada control es un círculo de vidrio propio. */
  .page__header .minicart__button { position: relative; }
  .page__header .header__utility .overlay,
  .page__header .minicart__holder { border-radius: 0 !important; background: none; }
  .page__header .mobile-submenu-label,
  .page__header .minicart__label,
  .page__header .search__icon {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    flex: 0 0 40px !important;
    width: 40px !important;
    min-width: 40px !important;
    max-width: 40px !important;
    height: 40px !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }
  .page__header .mobile-submenu-label:hover,
  .page__header .minicart__label:hover,
  .page__header .search__icon:hover {
    background: rgba(255, 255, 255, 0.20);
    transform: translateY(-1px);
  }
  .page__header .mobile-submenu-label i,
  .page__header .search__icon i,
  .page__header .minicart__label i { color: #FFFFFF !important; font-size: 1.15rem; }

  /* La pelotita del contador, en verde HALO. */
  .page__header .item__count {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--halo-verde) !important;
    color: #04130C !important;
    font-size: 0.68rem !important;
    font-weight: 800 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 201, 123, 0.45);
  }

  .page__header .header__logo img,
  .page__header .logo--default { max-height: 26px !important; width: auto !important; }

  /* ---------- orden: menú · logo · acciones ---------- */
  .page__header .header__utility {
    display: flex !important;
    align-items: center !important;
    gap: 8px;
  }

  @media screen and (min-width: 768px) {
    .page__header .main__navigation { order: 1 !important; flex: 1 1 0 !important; justify-content: flex-start !important; display: flex !important; }
    .page__header .header__logo     { order: 2 !important; flex: 0 0 auto !important; display: flex !important; justify-content: center !important; }
    .page__header .header__utility  { order: 3 !important; flex: 1 1 0 !important; justify-content: flex-end !important; }
  }

  @media screen and (max-width: 767px) {
    .page__header { top: 10px; width: calc(100% - 20px); height: 54px !important; }
    .page__header.halo-scrolled { top: 6px; width: calc(100% - 14px); }
    .page__header--width { height: 54px; padding: 0 8px !important; }
    .page__header .mobile-submenu-label { order: 1 !important; }
    .page__header .header__logo { order: 2 !important; flex-grow: 1 !important; display: flex !important; justify-content: center !important; }
    .page__header .header__utility { order: 3 !important; }
  }

  /* La barra flota encima, así que el primer bloque respira por debajo de ella.
     El relleno va dentro de la sección (que sí tiene fondo), nunca fuera. */
  main > .shopify-section:first-of-type > section:first-of-type,
  main > .shopify-section:first-of-type > div:first-of-type > section:first-of-type,
  main > .shopify-section:first-of-type > div:first-of-type:not(:has(section)) { padding-top: 92px; }
  @media screen and (max-width: 767px) {
    main > .shopify-section:first-of-type > section:first-of-type,
    main > .shopify-section:first-of-type > div:first-of-type > section:first-of-type,
    main > .shopify-section:first-of-type > div:first-of-type:not(:has(section)) { padding-top: 78px; }
  }

  /* ---------- cajón de navegación móvil ---------- */
  .mobile__navigation {
    background: rgba(10, 11, 14, 0.92) !important;
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    border-right: 1px solid rgba(255, 255, 255, 0.10) !important;
  }
  .mobile__navigation .nav__link {
    color: #FFFFFF !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
  }
  .mobile__navigation .mobile__submenu__toggle i { color: var(--halo-verde) !important; }
  .mobile__navigation__footer { border-top: 1px solid rgba(255, 255, 255, 0.06) !important; }

{%- endif -%}
</style>

{%- unless hl_sin_menu -%}
<script>
  // La barra se compacta al bajar. Sin librerías y sin bloquear el scroll.
  (function () {
    var barras = [], abajo = null;
    function pinta() {
      var ahora = window.scrollY > 24;
      if (ahora === abajo) return;
      abajo = ahora;
      for (var i = 0; i < barras.length; i++) barras[i].classList.toggle('halo-scrolled', ahora);
    }
    document.addEventListener('DOMContentLoaded', function () {
      barras = [].slice.call(document.querySelectorAll('.page__header'));
      pinta();
      window.addEventListener('scroll', pinta, { passive: true });
    });
  })();
</script>
{%- endunless -%}
