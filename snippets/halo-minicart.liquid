{%- comment -%}
  HALO · el cajón del carro con la identidad de la marca.
  Solo estilos: no toca el marcado ni la lógica de BoosterTheme.
{%- endcomment -%}
<style id="halo-minicart-css">
  /* ---------- el panel ---------- */
  .minicart__holder.minicart--sidebar {
    background: #0B0D10 !important;
    color: #FFFFFF !important;
    border-left: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.45) !important;
  }
  .minicart__holder .minicart,
  .minicart__holder .minicart__entries {
    background: transparent !important;
    color: #FFFFFF !important;
  }

  /* ---------- encabezado ---------- */
  .minicart__title {
    display: flex !important;
    align-items: center;
    gap: 8px;
    font-family: Arimo, sans-serif;
    font-size: 1.05rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #FFFFFF !important;
    padding: 20px 20px 16px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
  }
  .minicart__title > span:first-of-type { color: #00C97B !important; font-weight: 800; }
  .minicart__close {
    margin-left: auto;
    font-size: 0.72rem !important;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.55) !important;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }
  .minicart__close:hover { background: rgba(255, 255, 255, 0.10); color: #FFFFFF !important; }

  /* ---------- reloj de reserva ---------- */
  .minicart__timer {
    margin: 14px 20px 0 !important;
    padding: 10px 14px !important;
    border-radius: 12px !important;
    background: rgba(0, 201, 123, 0.10) !important;
    border: 1px solid rgba(0, 201, 123, 0.28) !important;
    color: #7CF0C0 !important;
    font-size: 0.82rem !important;
    text-align: center;
  }

  /* ---------- cada producto ---------- */
  .minicart__entry {
    padding: 18px 20px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07) !important;
    background: transparent !important;
  }
  .minicart__image .card__img,
  .minicart__image img {
    border-radius: 12px !important;
    background: #15181D !important;
  }
  .minicart__info a {
    color: #FFFFFF !important;
    font-weight: 700 !important;
    line-height: 1.3;
    text-decoration: none !important;
  }
  .minicart__variation { color: rgba(255, 255, 255, 0.45) !important; font-size: 0.8rem !important; }
  .minicart__price,
  .minicart__price .jsPrice { color: #00C97B !important; font-weight: 800 !important; }
  .minicart__price s { color: rgba(255, 255, 255, 0.35) !important; font-weight: 500 !important; }

  /* ---------- cantidad ---------- */
  .minicart__entry .quantity--input {
    margin-top: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
    border-radius: 999px !important;
    overflow: hidden;
    display: inline-flex !important;
    background: rgba(255, 255, 255, 0.04) !important;
  }
  .minicart__entry .quantity--input__button {
    background: transparent !important;
    color: #FFFFFF !important;
    border: 0 !important;
    width: 32px;
    cursor: pointer;
  }
  .minicart__entry .quantity--input__button:hover { background: rgba(255, 255, 255, 0.10) !important; }
  .minicart__entry .quantity--input__input {
    background: transparent !important;
    color: #FFFFFF !important;
    border: 0 !important;
    width: 38px;
    text-align: center;
    font-weight: 700;
  }

  .minicart__trash svg path,
  .minicart__trash svg { fill: rgba(255, 255, 255, 0.4) !important; transition: fill .2s ease; }
  .minicart__trash:hover svg path { fill: #FF5A5A !important; }

  /* ---------- carro vacío ---------- */
  .empty__cart--icon svg path { fill: rgba(255, 255, 255, 0.22) !important; }
  .minicart__entries .button--primary__filled {
    background: #00C97B !important;
    border-color: #00C97B !important;
    color: #04130C !important;
    font-weight: 800 !important;
    border-radius: 999px !important;
    padding: 14px 26px !important;
  }
  .empty__cart--title {
    color: rgba(255, 255, 255, 0.65) !important;
    font-size: 1rem !important;
    margin: 12px 0 18px !important;
  }

  /* ---------- pie ---------- */
  .minicart__bottom {
    background: rgba(255, 255, 255, 0.035) !important;
    border-top: 1px solid rgba(255, 255, 255, 0.10) !important;
    padding: 20px !important;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .minicart__total {
    display: flex !important;
    align-items: baseline;
    justify-content: space-between;
    color: rgba(255, 255, 255, 0.6) !important;
    font-size: 0.9rem !important;
    margin-bottom: 14px;
  }
  .minicart__total .jsPrice {
    color: #FFFFFF !important;
    font-family: Arimo, sans-serif;
    font-size: 1.5rem !important;
    font-weight: 900 !important;
  }
  .minicart__bottom .button--primary__filled {
    background: #00C97B !important;
    border-color: #00C97B !important;
    color: #04130C !important;
    font-weight: 800 !important;
    letter-spacing: 0.02em;
    border-radius: 999px !important;
    padding: 16px !important;
    box-shadow: 0 8px 24px rgba(0, 201, 123, 0.28) !important;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .minicart__bottom .button--primary__filled:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px rgba(0, 201, 123, 0.38) !important;
  }
  .minicart__bottom .button--text {
    color: rgba(255, 255, 255, 0.55) !important;
    text-decoration: none !important;
  }
  .minicart__bottom .button--text:hover { color: #FFFFFF !important; }

  /* ---------- la cortina ---------- */
  .minicart__button > .overlay,
  .overlay--minicart {
    background: rgba(4, 6, 9, 0.6) !important;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* barra de scroll discreta dentro del cajón */
  .minicart__entries.fancy-scroll::-webkit-scrollbar { width: 6px; }
  .minicart__entries.fancy-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 999px;
  }

  /* ---------- barra de envío gratis ---------- */
  .hm-envio { margin: 14px 20px 0; padding: 11px 14px; border-radius: 12px;
              background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); }
  .hm-envio--listo { background: rgba(0,201,123,.10); border-color: rgba(0,201,123,.30); }
  .hm-envio__texto { font-size: .82rem; color: rgba(255,255,255,.72); text-align: center; }
  .hm-envio--listo .hm-envio__texto { color: #7CF0C0; }
  .hm-envio__texto b { color: #FFF; font-weight: 800; }
  .hm-envio--listo .hm-envio__texto b { color: #7CF0C0; }
  .hm-envio__riel { margin-top: 8px; height: 5px; border-radius: 999px; background: rgba(255,255,255,.10); overflow: hidden; }
  .hm-envio__riel span { display: block; height: 100%; border-radius: 999px; background: #00C97B; transition: width .35s ease; }

  /* ---------- lo que ahorra en cada línea ---------- */
  .hm-ahorro { display: flex; align-items: center; gap: 8px; margin-top: 4px; font-size: .74rem; }
  .hm-ahorro s { color: rgba(255,255,255,.38); }
  .hm-ahorro b { color: #00C97B; font-weight: 800; background: rgba(0,201,123,.12);
                 border: 1px solid rgba(0,201,123,.28); border-radius: 999px; padding: 2px 8px; }

  /* ---------- la correa ---------- */
  .hm-extra { margin: 4px 20px 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.08); }
  .hm-extra__tit { font-size: .64rem; letter-spacing: .14em; text-transform: uppercase;
                   color: rgba(255,255,255,.42); margin-bottom: 10px; }
  .hm-correa { display: flex; align-items: center; gap: 12px; padding: 10px;
               background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09); border-radius: 12px; }
  .hm-correa img { width: 52px; height: 52px; object-fit: cover; border-radius: 8px; flex: 0 0 auto; background: #15191F; }
  .hm-correa__cuerpo { flex: 1 1 auto; min-width: 0; }
  .hm-correa__nombre { font-size: .84rem; font-weight: 700; color: #FFF; line-height: 1.25; }
  .hm-correa__desc { font-size: .72rem; color: rgba(255,255,255,.52); line-height: 1.35; margin-top: 2px; }
  .hm-correa__precio { margin-top: 4px; font-size: .78rem; display: flex; gap: 7px; align-items: baseline; }
  .hm-correa__precio b { color: #FFF; font-weight: 800; }
  .hm-correa__precio s { color: rgba(255,255,255,.35); }
  .hm-correa__btn { flex: 0 0 auto; border: 1px solid rgba(255,255,255,.22); background: transparent;
                    color: #FFF; font-size: .74rem; font-weight: 700; padding: 8px 14px;
                    border-radius: 999px; cursor: pointer; transition: background .2s ease; }
  .hm-correa__btn:hover { background: rgba(255,255,255,.10); }
  .hm-correa__btn[disabled] { opacity: .5; cursor: default; }

  /* ---------- protección de envío ---------- */
  .hm-prot { display: flex; align-items: center; gap: 11px; margin: 14px 20px 0; padding: 11px 13px;
             background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09);
             border-radius: 12px; cursor: pointer; }
  .hm-prot--on { background: rgba(0,201,123,.09); border-color: rgba(0,201,123,.28); }
  .hm-prot__ico { font-size: 1.1rem; line-height: 1; }
  .hm-prot__cuerpo { flex: 1 1 auto; min-width: 0; }
  .hm-prot__tit { display: block; font-size: .82rem; font-weight: 700; color: #FFF; line-height: 1.25; }
  .hm-prot__desc { display: block; font-size: .72rem; color: rgba(255,255,255,.52); line-height: 1.35; margin-top: 2px; }
  .hm-prot__check { position: absolute; opacity: 0; pointer-events: none; }
  .hm-prot__switch { flex: 0 0 auto; width: 38px; height: 22px; border-radius: 999px;
                     background: rgba(255,255,255,.16); position: relative; transition: background .2s ease; }
  .hm-prot__switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px;
                            border-radius: 50%; background: #FFF; transition: transform .2s ease; }
  .hm-prot__check:checked ~ .hm-prot__switch { background: #00C97B; }
  .hm-prot__check:checked ~ .hm-prot__switch::after { transform: translateX(16px); }

  /* ---------- boleta o factura ---------- */
  .hm-doc { margin: 14px 20px 0; }
  .hm-doc__tit { font-size: .78rem; color: rgba(255,255,255,.62); margin-bottom: 7px; }
  .hm-doc__ops { display: flex; gap: 20px; }
  .hm-doc__ops label { display: flex; align-items: center; gap: 6px; font-size: .82rem;
                       color: #FFF; cursor: pointer; }
  .hm-doc__ops input { accent-color: #00C97B; }

  /* ---------- el pie ---------- */
  .hm-linea { display: flex; justify-content: space-between; align-items: baseline;
              font-size: .82rem; margin-bottom: 6px; }
  .hm-linea--ahorro span { color: rgba(255,255,255,.58); }
  .hm-linea--ahorro b { color: #00C97B; font-weight: 800; }
  .hm-confianza { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px;
                  margin: 10px 0 12px; font-size: .68rem; color: rgba(255,255,255,.45); }
  .hm-pagar { font-weight: 800 !important; letter-spacing: .01em; }
</style>

<script>
/* El cajón se vuelve a dibujar por AJAX en cada cambio, así que todo va delegado
   al documento: los nodos de adentro no existen todavía cuando esto se ejecuta. */
(function () {
  function refrescar() {
    if (window.BoosterTheme && BoosterTheme.cart && BoosterTheme.cart.getCart) {
      BoosterTheme.cart.getCart();
    } else {
      window.location.reload();
    }
  }

  document.addEventListener('click', function (e) {
    var boton = e.target.closest('[data-hm-add]');
    if (boton) {
      e.preventDefault();
      if (boton.disabled) return;
      boton.disabled = true;
      boton.textContent = 'Añadiendo…';
      fetch('/cart/add.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(boton.dataset.hmAdd), quantity: 1 })
      }).then(refrescar).catch(function () {
        boton.disabled = false; boton.textContent = 'Añadir';
      });
    }
  });

  document.addEventListener('change', function (e) {
    var prot = e.target.closest('[data-hm-proteccion]');
    if (prot) {
      var id = Number(prot.dataset.hmProteccion);
      var cuerpo = prot.checked ? { id: id, quantity: 1 } : { id: id, quantity: 0 };
      var url = prot.checked ? '/cart/add.js' : '/cart/change.js';
      fetch(url, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cuerpo)
      }).then(refrescar);
      return;
    }

    var doc = e.target.closest('[data-hm-doc]');
    if (doc) {
      fetch('/cart/update.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: { Documento: doc.value } })
      });
    }
  });
})();
</script>
