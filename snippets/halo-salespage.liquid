    border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 24px;
  }
  .hl-review-card__stars { color: var(--amber-warn); font-size: 0.9rem; margin-bottom: 12px; letter-spacing: 2px; }
  .hl-review-card__text { font-size: 0.9rem; color: var(--text-muted) !important; line-height: 1.65; margin-bottom: 16px; }
  .hl-review-card__author { display: flex; align-items: center; gap: 10px; }
  .hl-review-card__avatar {
    width: 36px; height: 36px; border-radius: 50%; background: var(--titanium-mid);
    display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0;
  }
