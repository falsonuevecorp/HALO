  }
  .hl-sticky-bar.visible { transform: translateY(0); opacity: 1; pointer-events: auto; }
  .hl-sticky-bar__inner { max-width: 600px; margin: 0 auto; width: 100%; }

  .wb-sticky-direct-btn {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    width: 100%; background: #0A0F13;
    color: #ffffff !important; text-decoration: none;
    padding: 9px 9px 9px 22px;
    border-radius: 999px; border: 1px solid #0A0F13; cursor: pointer;
    box-shadow: 0 1px 2px rgba(10,15,19,0.10), 0 14px 34px rgba(10,15,19,0.30);
    transition: background .26s ease, transform .26s cubic-bezier(.22,.61,.36,1);
    box-sizing: border-box;
  }
  .wb-sticky-direct-btn:hover { background: #19222B; transform: translateY(-1px); }

  /* izquierda: el dato */
  .wbs__izq { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .wbs__precios { display: flex; align-items: baseline; gap: 8px; }
  .wbs__precio {
    font-family: 'Inter', sans-serif; font-size: 19px; font-weight: 800;
    letter-spacing: -0.02em; color: #FFFFFF !important; font-variant-numeric: tabular-nums;
  }
  .wbs__antes {
    font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.40) !important;
    text-decoration: line-through; font-variant-numeric: tabular-nums;
  }
  .wb-sticky-btn-subtitle {
    font-family: 'Inter', sans-serif; font-size: 9.5px; font-weight: 600;
    letter-spacing: 0.10em; text-transform: uppercase;
    margin: 2px 0 0; text-align: left;
    color: rgba(255,255,255,0.45) !important; white-space: nowrap;
  }

  /* derecha: la acción, en claro para que no compita con el precio */
  .wbs__accion {
    flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px;
    background: #FFFFFF; color: #0A0F13 !important;
    font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 700;
    letter-spacing: -0.005em; padding: 12px 20px; border-radius: 999px;
    transition: background .24s ease;
  }
  .wb-sticky-direct-btn:hover .wbs__accion { background: #EDF0F5; }
  .wbs__accion .hl-cta__flecha { opacity: .6; }
  .wb-sticky-direct-btn:hover .wbs__accion .hl-cta__flecha { transform: translateX(3px); opacity: 1; }
  @media (max-width: 380px) {
    .wb-sticky-direct-btn { padding-left: 16px; }
    .wbs__precio { font-size: 17px; }
    .wbs__accion { padding: 11px 15px; font-size: 12.5px; }
  }

  /* FAQ */
  .hl-faq { background: var(--obsidian); }
  .hl-faq__list { max-width: 760px; margin: 40px auto 0; }
  .hl-faq__item {
    border-bottom: 1px solid var(--border-subtle); padding: 20px 0;
  }
  .hl-faq__q {
    display: flex; justify-content: space-between; align-items: center;
    cursor: pointer; font-weight: 600; font-size: 0.95rem; color: var(--text-white) !important;
  }
  .hl-faq__q .ico { color: var(--cyan-orbit); font-size: 1.2rem; transition: transform 0.3s; flex-shrink: 0; margin-left: 12px; }
  .hl-faq__a { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
  .hl-faq__a.open { max-height: 300px; }
  .hl-faq__a-inner { padding-top: 14px; font-size: 0.9rem; color: var(--text-muted) !important; line-height: 1.7; }

  .hl-caja { background: var(--obsidian); }
  .hl-caja__grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 40px;
  }
  .hl-caja__item {
    background: var(--titanium-dark); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: 24px 20px; text-align: center;
  }
  .hl-caja__num {
    display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;
    font-weight: 600; letter-spacing: 0.1em; color: var(--cyan-orbit);
    border: 1px solid rgba(0,122,140,0.25); border-radius: 999px; padding: 3px 10px; margin-bottom: 14px;
  }
  .hl-caja__ico { font-size: 1.9rem; line-height: 1; margin-bottom: 12px; }
  .hl-caja__nombre { font-family: 'Inter', sans-serif; font-weight: 800; font-size: 0.98rem; color: var(--text-white) !important; margin-bottom: 6px; }
  .hl-caja__desc { font-size: 0.84rem; line-height: 1.45; color: var(--text-muted) !important; }
  @media (max-width: 860px) { .hl-caja__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 460px) { .hl-caja__grid { grid-template-columns: 1fr; gap: 12px; } .hl-caja__item { display: flex; align-items: center; gap: 14px; text-align: left; padding: 16px; } .hl-caja__ico { margin-bottom: 0; } .hl-caja__num { display: none; } }

  .hl-costo {
    margin-top: 56px; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    background: var(--titanium-dark); padding: 32px 28px;
    box-shadow: 0 14px 40px rgba(0,0,0,0.06);
  }
  .hl-costo__head { text-align: center; margin-bottom: 26px; }
  .hl-costo__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .hl-costo__col {
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    padding: 22px 20px; background: var(--obsidian);
  }
  .hl-costo__col--halo { border-color: rgba(0,138,84,0.32); background: rgba(0,138,84,0.05); }
  .hl-costo__quien { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-subtle) !important; }
  .hl-costo__col--halo .hl-costo__quien { color: var(--green-signal) !important; }
  .hl-costo__linea { display: flex; justify-content: space-between; gap: 10px; font-size: 0.88rem; padding: 10px 0; border-bottom: 1px solid var(--border-subtle); color: var(--text-muted) !important; }
  .hl-costo__linea:last-of-type { border-bottom: 0; }
  .hl-costo__total { margin-top: 14px; padding-top: 14px; border-top: 2px solid var(--border-subtle); }
  .hl-costo__total b { display: block; font-family: 'Inter', sans-serif; font-size: 1.7rem; font-weight: 900; color: var(--text-white) !important; letter-spacing: -0.02em; }
  .hl-costo__col--halo .hl-costo__total b { color: var(--green-signal) !important; }
  .hl-costo__total span { font-size: 0.78rem; color: var(--text-subtle) !important; }
  .hl-costo__pie { margin-top: 22px; text-align: center; font-size: 0.9rem; color: var(--text-muted) !important; }
  @media (max-width: 620px) {
    .hl-costo { padding: 24px 18px; }
    .hl-costo__grid { grid-template-columns: 1fr; }
    .hl-costo__total b { font-size: 1.45rem; }
  }

  @keyframes hl-titila { 0%, 100% { opacity: 1; } 50% { opacity: 0.15; } }
  .hl-titila { animation: hl-titila 0.7s steps(1, end) infinite; }

  .hl-cta__cod {
    display: flex; align-items: flex-start; gap: 10px;
    margin-top: 12px; padding: 12px 14px;
    background: #F1F8F3; border: 1px solid rgba(0,138,84,0.22);
    border-radius: 12px; font-size: 0.86rem; line-height: 1.35;
    color: var(--text-muted) !important;
  }
  .hl-cta__cod b { color: var(--green-signal) !important; }
  .hl-cod__icono { font-size: 1.1rem; line-height: 1; }
  .hl-cod__sub { display: block; font-size: 0.78rem; color: var(--text-subtle) !important; margin-top: 2px; }

  /* Qué llega en la caja, dicho arriba: el 14% que viene de Facebook
     no baja de los 1.700 px y nunca ve la sección de la caja.          */
  .hl-cta__caja {
    margin-top: 12px; padding: 11px 14px;
    background: rgba(10,15,19,0.04); border: 1px solid rgba(10,15,19,0.10);
    border-radius: 12px; font-size: 0.8rem; line-height: 1.45;
    color: var(--text-muted) !important; text-align: left;
  }
  .hl-cta__caja b { color: var(--text-dark) !important; font-weight: 700; }

  /* Los cuatro resultados, inmediatamente después del botón. */
  .hl-cta__benef { width: 100%; margin-top: 14px; display: grid; gap: 10px; }
  .hl-benef__fila { display: flex; align-items: flex-start; gap: 10px; text-align: left; }
  .hl-benef__ico { font-size: 1.05rem; line-height: 1.25; flex: 0 0 auto; }
  /* Los <span> heredan display inline y el título se pega a la bajada. */
  .hl-benef__fila > span:last-child { display: block; }
  .hl-benef__t { display: block; font-size: 0.87rem; font-weight: 700; color: var(--text-dark) !important; line-height: 1.3; }
  .hl-benef__d { display: block; font-size: 0.78rem; color: var(--text-muted) !important; line-height: 1.4; margin-top: 2px; }

  /* Quién despacha y desde dónde: lo que separa una marca de un intermediario. */
  .hl-cta__local { width: 100%; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border-subtle);
                   display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center; }
  .hl-local__item { display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .hl-local__ico { font-size: 1.15rem; line-height: 1; }
  .hl-local__t { font-size: 0.62rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: var(--text-dark) !important; line-height: 1.2; }
  .hl-local__d { font-size: 0.62rem; color: var(--text-subtle) !important; line-height: 1.25; }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    /* ── El primer pantallazo decide la venta ──────────────────────────
       En el teléfono el orden pasa a ser: prueba social · titular ·
       bajada · foto · precio · botón. Todo lo demás baja.
       `display: contents` disuelve la columna de texto para poder
       intercalar la foto entre sus hijos.                              */
    .hl-hero__grid { display: flex !important; flex-direction: column; gap: 0 !important; }
    .hl-hero__copy { display: contents; }
    .hl-hero__proof    { order: 1; }
    .hl-hero .h-display { order: 2; font-size: 1.62rem !important; line-height: 1.12; }
    .hl-hero__copy > .body-lg { order: 3; font-size: 0.95rem !important; margin-top: 10px !important; margin-bottom: 14px !important; }
    .hl-hero__img-wrap { order: 4; margin-bottom: 14px; }
    /* La foto cede 47 px para que el botón no caiga bajo el pliegue:
       el banner de cuotas se comió justo ese espacio.                  */
    .hl-hero__img-wrap img { max-width: 84%; margin-left: auto; margin-right: auto; }
    .hl-hero__cta-box  { order: 5; margin-top: 0 !important; }
    .hl-hero__badge-row { order: 6; margin-top: 18px; }

    /* Dentro de la caja: precio y botón primero, el resto después. */
    .hl-hero__cta-box { display: flex; flex-direction: column; }
    .hl-cta__precio  { order: 1; }
    .hl-cta__boton   { order: 2; }
    .hl-cta__mp      { order: 3; margin-top: 18px; }
    .hl-cta__benef   { order: 4; }
    .hl-cta__cod     { order: 5; }
    .hl-cta__caja    { order: 6; }
    .hl-cta__correa  { order: 7; }
    .hl-cta__reloj   { order: 8; margin-bottom: 0 !important; }
    .hl-cta__envio   { order: 9; margin-top: 12px; margin-bottom: 0 !important; }
    .hl-cta__trust   { order: 10; }
    .hl-cta__local   { order: 11; }

    /* Cada píxel de arriba cuenta: el sello y la bajada van más apretados. */
    .hl-hero__proof { margin-bottom: 14px !important; padding: 5px 12px 5px 6px !important; }
    .hl-hero { padding-top: 10px !important; }
    .hl-hero__cta-box { padding: 16px 14px !important; }
    .hl-hero__grid, .hl-pain__grid { grid-template-columns: 1fr; gap: 40px; }
    .hl-hero__img-wrap { max-height: none; }
    .hl-cred__grid { grid-template-columns: repeat(2,1fr); }
    .hl-bullets__grid { grid-template-columns: 1fr 1fr; }
    .hl-how__steps { grid-template-columns: 1fr; }
    .hl-reviews__ugc-grid { grid-template-columns: 1fr; }
    .hl-aha__flow { grid-template-columns: 1fr; }
    .hl-aha__arrow { transform: rotate(90deg); }
    .hl-section { padding: 60px 0; }
    .hl-offer__body, .hl-offer__header { padding: 24px; }
  }
  @media (max-width: 600px) {
    .hl-bullets__grid { grid-template-columns: 1fr; }
    .hl-cred__grid { grid-template-columns: 1fr 1fr; }
    .hl-proof-bar__inner { gap: 20px; }
    .hl-proof-divider { display: none; }
    .hl-pain__vs { grid-template-columns: 1fr; }
    .hl-pain__vs-center { display: none; }
    .hl-compare__table { font-size: 0.78rem; }
    .hl-compare__table th, .hl-compare__table td { padding: 10px 8px; }
    .hl-sticky-bar { padding: 10px 16px; }
    .wb-sticky-btn-title { font-size: 14px; }
    .wb-sticky-btn-subtitle { font-size: 10.5px; }
  }
</style>

