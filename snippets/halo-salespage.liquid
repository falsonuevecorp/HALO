<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;600;700;900&family=JetBrains+Mono:wght@500;600&display=swap');

  /* ===================================================
     HALO® NEURO — LONG-FORM SALESPAGE v2.0 "IM8 Protocol"
     13-Step Conversion Architecture
     =================================================== */

  .halo-funnel {
    /* LIGHT MODE PALETTE */
    --space-black:   #FFFFFF;          /* antes: fondo oscuro → ahora: blanco puro */
    --obsidian:      #F5F7FA;          /* antes: obsidian oscuro → ahora: gris ultra-claro */
    --titanium-dark: #FFFFFF;          /* antes: tarjeta oscura → ahora: blanco */
    --titanium-mid:  #EDF0F5;          /* hover state */
    --border-subtle: rgba(0,0,0,0.09); /* bordes sutiles oscuros sobre blanco */
    --cyan-orbit:    #007A8C;          /* cyan oscurecido para contraste AAA sobre blanco */
    --cyan-cta:      #00B8CC;          /* cyan original solo para botones CTA */
    --cyan-dim:      rgba(0,122,140,0.08);
    --cyan-glow:     0 4px 24px rgba(0,184,204,0.25);
    --green-signal:  #008A54;
    --amber-warn:    #D4861A;
    --text-white:    #0D1117;          /* antes: blanco → ahora: casi negro */
    --text-muted:    #4A5568;          /* texto secundario oscuro */
    --text-subtle:   #8A95A8;          /* texto terciario */
    --radius-sm:     8px;
    --radius-md:     16px;
    --radius-lg:     24px;
    font-family: 'Inter', sans-serif;
    background: #FFFFFF;
    color: #0D1117;
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  .halo-funnel *, .halo-funnel *::before, .halo-funnel *::after { box-sizing: border-box; margin: 0; }
  .halo-funnel a { color: inherit; text-decoration: none; }
  .halo-funnel img { max-width: 100%; display: block; }

  /* Typography */
  .halo-funnel .h-display {
    font-family: 'Inter', sans-serif; font-weight: 800;
    font-size: clamp(2rem, 8vw, 5rem); line-height: 1.04; letter-spacing: -0.04em;
    color: var(--text-white) !important;
    overflow-wrap: break-word; word-wrap: break-word; hyphens: auto;
  }
  .halo-funnel .h-title {
    font-family: 'Inter', sans-serif; font-weight: 800;
    font-size: clamp(1.6rem, 6vw, 3.4rem); line-height: 1.1; letter-spacing: -0.03em;
    color: var(--text-white) !important;
    overflow-wrap: break-word; word-wrap: break-word;
  }
  .halo-funnel .h-sub {
    font-family: 'Inter', sans-serif; font-weight: 700;
    font-size: clamp(1.2rem, 3vw, 1.8rem); line-height: 1.25; letter-spacing: -0.015em;
    color: var(--text-white) !important;
  }
  .halo-funnel .mono-tag {
    font-family: 'JetBrains Mono', monospace; font-weight: 600;
    font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--cyan-orbit); /* #007A8C — contraste AAA sobre blanco */
  }
  .halo-funnel .body-lg { font-size: 1.125rem; color: var(--text-muted) !important; line-height: 1.7; }
  .halo-funnel .body-md { font-size: 1rem; color: var(--text-muted) !important; line-height: 1.65; }

  /* Layout */
  .hl-wrap { max-width: 1160px; margin: 0 auto; padding: 0 20px; overflow-x: hidden; }
  .hl-wrap--narrow { max-width: 760px; margin: 0 auto; padding: 0 20px; overflow-x: hidden; }
  .hl-section { padding: 100px 0; }
  .hl-section--sm { padding: 64px 0; }
  .hl-divider { border: none; border-top: 1px solid var(--border-subtle); margin: 0; }

  /* ===== STEP 1: ANNOUNCEMENT BAR ===== */
  .hl-announcement {
    background: var(--cyan-orbit); color: var(--space-black);
    padding: 10px 0;
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 0.85rem;
    letter-spacing: 0.04em;
    position: sticky; top: 0; z-index: 100;
    overflow: hidden; white-space: nowrap;
  }
  .hl-announcement__marquee {
    display: inline-block;
    padding-left: 100%;
    animation: hl-marquee 15s linear infinite;
  }
  @keyframes hl-marquee {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-100%, 0); }
  }
  .hl-announcement__marquee span { opacity: 0.85; margin: 0 12px; }

  /* ===== STEP 2: HERO ===== */
  .hl-hero {
    background: var(--space-black);
    padding: 20px 0 60px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .hl-hero__grid {
    display: grid; grid-template-columns: 1fr; gap: 30px; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 20px;
  }
  .hl-hero__img-wrap { order: -1; }
  @media(min-width: 900px){
    .hl-hero__grid { grid-template-columns: 1fr 1fr; gap: 60px; }
    .hl-hero__img-wrap { order: 0; }
  }
  .hl-hero__left { max-width: 540px; }
  .hl-hero__dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--green-signal);
    box-shadow: 0 0 8px var(--green-signal); animation: pulse-dot 2s ease infinite;
  }
  @keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.4} }

  .hl-hero__badge-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .hl-hero__badge {
    display: flex; align-items: center; gap: 6px; padding: 6px 12px;
    border: 1px solid var(--border-subtle); border-radius: 100px;
    font-size: 0.78rem; font-weight: 600; color: var(--text-muted) !important;
    background: var(--obsidian);
  }
  .hl-hero__badge svg { width: 14px; height: 14px; flex-shrink: 0; }

  .hl-hero__cta-box {
    background: var(--titanium-dark) !important; border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg); padding: 28px; margin-top: 40px;
  }
  .hl-hero__toggle {
    display: grid; grid-template-columns: 1fr 1fr;
    background: var(--space-black); border-radius: var(--radius-md); padding: 4px;
    margin-bottom: 20px;
  }
  .hl-hero__toggle-btn {
    flex: 1; padding: 12px; font-size: 0.85rem; font-weight: 700;
    color: var(--text-muted) !important; border: none; background: transparent !important;
    border-radius: 100px; cursor: pointer; transition: 0.3s;
  }
  .hl-hero__toggle-btn.active {
    background: var(--titanium-mid) !important; color: var(--text-white) !important;
  }
  .hl-price-row { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; }
  .hl-price-main { font-family: 'Inter',sans-serif; font-weight: 900; font-size: 2.6rem; color: var(--text-white) !important; }
  .hl-price-compare { font-size: 1.1rem; color: var(--text-subtle); text-decoration: line-through; }
  .hl-price-badge {
    background: var(--green-signal); color: #fff; font-size: 0.72rem; font-weight: 700;
    padding: 3px 8px; border-radius: 4px; letter-spacing: 0.05em;
  }
  .hl-cuotas { font-size: 0.88rem; color: var(--text-muted) !important; margin-bottom: 20px; }

  /* CTA Button */
  .hl-btn-cta {
    display: inline-block; width: 100%; text-align: center;
    background: var(--green-signal) !important; color: #FFFFFF !important;
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.1rem;
    padding: 20px 24px; border-radius: 100px; text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 15px rgba(0, 201, 123, 0.3);
  }
  .hl-btn-cta span { color: #FFFFFF !important; }
  .hl-btn-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0, 201, 123, 0.4); animation: none; }
  @keyframes pulse-cta {
    0%,100%{ box-shadow: 0 0 0 0 rgba(0,184,204,0.3) }
    50%{ box-shadow: 0 0 0 10px rgba(0,184,204,0) }
  }
  .hl-btn-secondary {
    display: block; width: 100%; padding: 14px 24px; border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle); color: var(--text-muted) !important;
    font-weight: 600; font-size: 0.9rem; text-align: center; background: transparent;
    cursor: pointer; transition: border-color 0.2s, color 0.2s;
  }
  .hl-btn-secondary:hover { border-color: var(--cyan-orbit); color: var(--text-white) !important; }

  .hl-trust-micro {
    display: flex; justify-content: center; gap: 20px; margin-top: 14px;
    font-size: 0.78rem; color: var(--text-subtle); flex-wrap: wrap;
  }
  .hl-trust-micro span { display: flex; align-items: center; gap: 4px; }

  .hl-hero__img-wrap {
    position: relative; border-radius: var(--radius-lg); overflow: hidden;
    background: var(--titanium-dark) !important; border: 1px solid var(--border-subtle);
    aspect-ratio: 4/5;
    display: flex; align-items: center; justify-content: center;
  }
  .hl-hero__img-wrap::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 80%, rgba(0,184,204,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .hl-hero__img-fallback {
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    color: var(--text-subtle);
  }
  .hl-hero__img-fallback .device-icon {
    width: 80px; height: 80px; border-radius: 50%;
    border: 2px solid var(--cyan-orbit); display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem;
    box-shadow: var(--cyan-glow);
  }

  /* ===== STEP 3: SOCIAL PROOF BAR ===== */
  .hl-proof-bar {
    background: var(--obsidian); border-bottom: 1px solid var(--border-subtle);
    padding: 20px 0;
  }
  .hl-proof-bar__inner {
    display: flex; align-items: center; justify-content: center;
    gap: 40px; flex-wrap: wrap;
  }
  .hl-proof-stat { text-align: center; }
  .hl-proof-stat__num {
    font-family: 'Inter', sans-serif; font-weight: 900;
    font-size: 1.5rem; color: var(--text-white) !important;
  }
  .hl-proof-stat__label { font-size: 0.78rem; color: var(--text-subtle); margin-top: 2px; }
  .hl-proof-divider { width: 1px; height: 40px; background: var(--border-subtle); }
  .hl-proof-stars { color: var(--amber-warn); font-size: 1.1rem; letter-spacing: 2px; }

  /* ===== STEP 4: PAIN BRIDGE ===== */
  .hl-pain { background: var(--space-black); }
  .hl-pain__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .hl-pain__vs {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: stretch;
  }
  .hl-pain__card {
    background: var(--titanium-dark) !important; border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle); padding: 24px 20px;
  }
  .hl-pain__card--bad { border-color: rgba(255,80,80,0.25); }
  .hl-pain__card--good { border-color: rgba(0,184,204,0.3); background: rgba(0,184,204,0.04); }
  .hl-pain__card-label {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);
  }
  .hl-pain__card-label.bad { color: #FF6B6B; }
  .hl-pain__card-label.good { color: var(--cyan-orbit); }
  .hl-pain__vs-center {
    display: flex; align-items: center; justify-content: center;
    font-family: 'Inter', sans-serif; font-weight: 900; font-size: 0.9rem;
    color: var(--text-subtle);
  }
  .hl-pain__item {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.88rem; margin-bottom: 10px; color: var(--text-muted) !important;
  }
  .hl-pain__item:last-child { margin-bottom: 0; }
  .hl-pain__item .icon-bad { color: #FF6B6B; flex-shrink: 0; }
  .hl-pain__item .icon-good { color: var(--cyan-orbit); flex-shrink: 0; }

  /* ===== STEP 5: CREDIBILITY STACK ===== */
  .hl-cred { background: var(--obsidian); }
  .hl-cred__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; }
  .hl-cred__item {
    background: var(--obsidian); padding: 32px 24px; text-align: center;
  }
  .hl-cred__icon { font-size: 2rem; margin-bottom: 12px; }
  .hl-cred__title { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 6px; color: var(--text-white) !important; }
  .hl-cred__desc { font-size: 0.82rem; color: var(--text-subtle); line-height: 1.5; }

  /* ===== STEP 6: A-HA MOMENT ===== */
  .hl-aha { background: var(--space-black); }
  .hl-aha__mechanism {
    background: var(--titanium-dark) !important; border: 1px solid rgba(0,184,204,0.2);
    border-radius: var(--radius-lg); padding: 48px;
    position: relative; overflow: hidden;
  }
  .hl-aha__mechanism::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan-orbit), transparent);
  }
  .hl-aha__flow {
    display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 16px; align-items: center;
    margin-top: 40px;
  }
  .hl-aha__step {
    text-align: center; background: var(--space-black); border-radius: var(--radius-md);
    padding: 24px 16px; border: 1px solid var(--border-subtle);
  }
  .hl-aha__step-icon { font-size: 2rem; margin-bottom: 12px; }
  .hl-aha__step-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 6px; color: var(--text-white) !important; }
  .hl-aha__step-desc { font-size: 0.8rem; color: var(--text-subtle); line-height: 1.5; }
  .hl-aha__arrow { color: var(--cyan-orbit); font-size: 1.5rem; }

  /* ===== STEP 7: FASCINATION BULLETS ===== */
  .hl-bullets { background: var(--obsidian); }
  .hl-bullets__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
  .hl-bullet-card {
    background: var(--titanium-dark) !important; border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: 28px;
    transition: border-color 0.3s, transform 0.2s;
  }
  .hl-bullet-card:hover { border-color: rgba(0,184,204,0.3); transform: translateY(-4px); }
  .hl-bullet-card__icon { font-size: 2rem; margin-bottom: 16px; }
  .hl-bullet-card__title { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.05rem; margin-bottom: 8px; color: var(--text-white) !important; }
  .hl-bullet-card__desc { font-size: 0.88rem; color: var(--text-muted) !important; line-height: 1.6; }

  /* ===== STEP 8: US VS THEM ===== */
  .hl-compare { background: var(--space-black); }
  .hl-compare__table { width: 100%; border-collapse: collapse; margin-top: 48px; }
  .hl-compare__table th, .hl-compare__table td {
    padding: 16px 20px; text-align: center;
    font-size: 0.9rem; border-bottom: 1px solid var(--border-subtle);
  }
  .hl-compare__table thead th { font-weight: 700; font-size: 0.88rem; color: var(--text-white) !important; }
  .hl-compare__table .col-halo {
    background: rgba(0,184,204,0.06); border: 1px solid rgba(0,184,204,0.25);
    color: var(--cyan-orbit);
  }
  .hl-compare__table .col-rival { color: var(--text-subtle); }
  .hl-compare__table tbody td { color: var(--text-muted) !important; }
  .hl-compare__table .check { color: var(--green-signal); font-weight: 700; }
  .hl-compare__table .cross { color: #FF6B6B; }
  .hl-compare__table .feature-label { text-align: left; font-weight: 600; color: var(--text-white) !important; }
  .hl-compare__table tbody tr:hover td { background: rgba(0,0,0,0.02); }

  /* ===== STEP 9: TECHNOLOGY BREAKDOWN ===== */
  .hl-tech { background: var(--obsidian); }
  .hl-accordion { border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; margin-top: 40px; }
  .hl-accordion__item { border-bottom: 1px solid var(--border-subtle); }
  .hl-accordion__item:last-child { border-bottom: none; }
  .hl-accordion__trigger {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    padding: 20px 24px; cursor: pointer; background: var(--titanium-dark) !important;
    border: none; color: var(--text-white) !important; text-align: left; transition: background 0.2s;
  }
  .hl-accordion__trigger:hover { background: var(--titanium-mid); }
  .hl-accordion__trigger-title { font-weight: 700; font-size: 0.95rem; }
  .hl-accordion__trigger-tag { font-size: 0.78rem; color: var(--cyan-orbit); font-weight: 600; }
  .hl-accordion__icon { font-size: 1.2rem; color: var(--cyan-orbit); transition: transform 0.3s; flex-shrink: 0; margin-left: 12px; }
  .hl-accordion__content {
    max-height: 0; overflow: hidden; transition: max-height 0.4s ease;
    background: var(--space-black);
  }
  .hl-accordion__content.open { max-height: 500px; }
  .hl-accordion__body { padding: 20px 24px; font-size: 0.9rem; color: var(--text-muted) !important; line-height: 1.7; }

  /* ===== STEP 10: TESTIMONIALS ===== */
  .hl-reviews { background: var(--space-black); }
  .hl-reviews__marquee-wrap { overflow: hidden; margin-top: 40px; }
  .hl-reviews__track {
    display: flex; gap: 20px; width: max-content;
    animation: marquee-scroll 35s linear infinite;
  }
  .hl-reviews__track:hover { animation-play-state: paused; }
  @keyframes marquee-scroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
  .hl-review-card {
    width: 320px; flex-shrink: 0; background: var(--titanium-dark) !important;
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 24px;
  }
  .hl-review-card__stars { color: var(--amber-warn); font-size: 0.9rem; margin-bottom: 12px; letter-spacing: 2px; }
  .hl-review-card__text { font-size: 0.9rem; color: var(--text-muted) !important; line-height: 1.65; margin-bottom: 16px; }
  .hl-review-card__author { display: flex; align-items: center; gap: 10px; }
  .hl-review-card__avatar {
    width: 36px; height: 36px; border-radius: 50%; background: var(--titanium-mid);
    display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0;
  }
  .hl-review-card__name { font-weight: 700; font-size: 0.85rem; color: var(--text-white) !important; }
  .hl-review-card__meta { font-size: 0.76rem; color: var(--text-subtle); }
  .hl-reviews__ugc-grid {
    display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 40px;
  }
  .hl-ugc-msg {
    background: var(--titanium-dark) !important; border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: 20px;
    font-size: 0.88rem; color: var(--text-muted) !important; line-height: 1.6;
    position: relative;
  }
  .hl-ugc-msg::before {
    content: '"'; font-family: 'Inter', sans-serif; font-size: 3rem; font-weight: 900;
    color: var(--cyan-dim); position: absolute; top: 8px; left: 16px; line-height: 1;
  }
  .hl-ugc-msg__body { padding-top: 20px; }
  .hl-ugc-msg__user { font-weight: 700; font-size: 0.8rem; color: var(--text-muted) !important; margin-top: 12px; }
  .hl-ugc-msg__platform { font-size: 0.72rem; color: var(--text-subtle); }

  /* ===== STEP 11: HOW IT WORKS ===== */
  .hl-how { background: var(--obsidian); }
  .hl-how__steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border-subtle); border-radius: var(--radius-lg); overflow: hidden; margin-top: 48px; }
  .hl-how__step {
    background: var(--obsidian); padding: 48px 32px; text-align: center; position: relative;
  }
  .hl-how__step-num {
    width: 48px; height: 48px; border-radius: 50%;
    border: 2px solid var(--cyan-orbit); background: rgba(0,184,204,0.08);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Inter', sans-serif; font-weight: 900; font-size: 1.1rem;
    color: var(--cyan-orbit); margin: 0 auto 20px;
    box-shadow: var(--cyan-glow);
  }
  .hl-how__step-icon { font-size: 2.5rem; margin-bottom: 16px; }
  .hl-how__step-title { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.1rem; margin-bottom: 10px; color: var(--text-white) !important; }
  .hl-how__step-desc { font-size: 0.9rem; color: var(--text-muted) !important; line-height: 1.65; }

  /* ===== STEP 12: SUBSCRIPTION MILESTONE JOURNEY ===== */
  .hl-journey { background: var(--space-black); }
  .hl-journey__timeline { position: relative; max-width: 800px; margin: 48px auto 0; }
  .hl-journey__timeline::before {
    content: ''; position: absolute; left: 24px; top: 0; bottom: 0;
    width: 2px; background: linear-gradient(to bottom, var(--cyan-orbit), rgba(0,184,204,0.1));
  }
  .hl-journey__item {
    display: flex; gap: 32px; align-items: flex-start;
    margin-bottom: 40px; padding-left: 72px; position: relative;
  }
  .hl-journey__dot {
    position: absolute; left: 12px;
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--cyan-orbit); border: 3px solid var(--space-black);
    box-shadow: 0 0 12px rgba(0,184,204,0.3);
    flex-shrink: 0;
  }
  .hl-journey__month {
    font-family: 'JetBrains Mono', monospace; font-weight: 600;
    font-size: 0.75rem; color: var(--cyan-orbit); letter-spacing: 0.1em;
    margin-bottom: 6px; text-transform: uppercase;
  }
  .hl-journey__title { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.05rem; margin-bottom: 6px; color: var(--text-white) !important; }
  .hl-journey__desc { font-size: 0.9rem; color: var(--text-muted) !important; }
  .hl-journey__tag {
    display: inline-block; padding: 3px 10px; border-radius: 4px;
