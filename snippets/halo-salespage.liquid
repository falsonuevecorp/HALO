  }
  .hl-ugc-msg__body { padding-top: 20px; }
  .hl-ugc-msg__user { font-weight: 700; font-size: 0.8rem; color: var(--text-muted) !important; margin-top: 12px; }
  .hl-ugc-msg__platform { font-size: 0.72rem; color: var(--text-subtle); }

  /* ===== STEP 11: HOW IT WORKS ===== */
  .hl-how { background: var(--obsidian); }
  .hl-how__steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border-subtle); border-radius: var(--radius-lg); overflow: hidden; margin-top: 48px; }
  .hl-how__step {
    background: var(--obsidian); padding: 48px 32px; text-align: center; position: relative;
  }
  .hl-how__step-num {
    width: 48px; height: 48px; border-radius: 50%;
    border: 2px solid var(--cyan-orbit); background: rgba(0,184,204,0.08);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Inter', sans-serif; font-weight: 900; font-size: 1.1rem;
    color: var(--cyan-orbit); margin: 0 auto 20px;
    box-shadow: var(--cyan-glow);
  }
  .hl-how__step-icon { font-size: 2.5rem; margin-bottom: 16px; }
  .hl-how__step-title { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.1rem; margin-bottom: 10px; color: var(--text-white) !important; }
  .hl-how__step-desc { font-size: 0.9rem; color: var(--text-muted) !important; line-height: 1.65; }

  /* ===== STEP 12: SUBSCRIPTION MILESTONE JOURNEY ===== */
  .hl-journey { background: var(--space-black); }
  .hl-journey__timeline { position: relative; max-width: 800px; margin: 48px auto 0; }
  .hl-journey__timeline::before {
    content: ''; position: absolute; left: 24px; top: 0; bottom: 0;
    width: 2px; background: linear-gradient(to bottom, var(--cyan-orbit), rgba(0,184,204,0.1));
  }
  .hl-journey__item {
    display: flex; gap: 32px; align-items: flex-start;
    margin-bottom: 40px; padding-left: 72px; position: relative;
  }
  .hl-journey__dot {
    position: absolute; left: 12px;
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--cyan-orbit); border: 3px solid var(--space-black);
    box-shadow: 0 0 12px rgba(0,184,204,0.3);
    flex-shrink: 0;
  }
  .hl-journey__month {
    font-family: 'JetBrains Mono', monospace; font-weight: 600;
    font-size: 0.75rem; color: var(--cyan-orbit); letter-spacing: 0.1em;
    margin-bottom: 6px; text-transform: uppercase;
  }
  .hl-journey__title { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.05rem; margin-bottom: 6px; color: var(--text-white) !important; }
  .hl-journey__desc { font-size: 0.9rem; color: var(--text-muted) !important; }
  .hl-journey__tag {
    display: inline-block; padding: 3px 10px; border-radius: 4px;
    background: rgba(0,201,123,0.15); border: 1px solid rgba(0,201,123,0.3);
    color: var(--green-signal); font-size: 0.76rem; font-weight: 700; margin-top: 8px;
  }

  /* ===== STEP 13: OFFER + GUARANTEE + FINAL CTA ===== */
  .hl-offer { background: var(--obsidian); }
  .hl-offer__box {
    background: var(--titanium-dark) !important; border: 1px solid rgba(0,184,204,0.25);
    border-radius: var(--radius-lg); overflow: hidden;
    max-width: 700px; margin: 48px auto 0;
    box-shadow: 0 20px 40px rgba(0,0,0,0.06);
  }
  .hl-offer__header {
    background: linear-gradient(135deg, rgba(0,184,204,0.1), rgba(0,184,204,0.02));
    padding: 32px 40px; text-align: center;
    border-bottom: 1px solid rgba(0,184,204,0.1);
  }
  .hl-offer__body { padding: 32px 40px; }
  .hl-offer__item {
    display: flex; align-items: flex-start; gap: 16px;
    padding: 16px 0; border-bottom: 1px solid var(--border-subtle);
  }
  .hl-offer__item:last-child { border-bottom: none; }
  .hl-offer__item-icon { font-size: 1.5rem; flex-shrink: 0; }
  .hl-offer__item-name { font-weight: 700; font-size: 0.95rem; margin-bottom: 2px; color: var(--text-white) !important; }
  .hl-offer__item-desc { font-size: 0.82rem; color: var(--text-muted) !important; }
  .hl-offer__item-val { margin-left: auto; flex-shrink: 0; text-align: right; }
  .hl-offer__item-val .orig { font-size: 0.82rem; color: var(--text-subtle); text-decoration: line-through; }
  .hl-offer__item-val .free { font-size: 0.82rem; color: var(--green-signal); font-weight: 700; }
  .hl-offer__total {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 0 0;
  }
  .hl-offer__total-label { font-size: 0.88rem; color: var(--text-muted) !important; }
  .hl-offer__total-price { font-family: 'Inter', sans-serif; font-weight: 900; font-size: 1.5rem; }
  .hl-offer__total-orig { font-size: 0.82rem; color: var(--text-subtle); text-decoration: line-through; }

  .hl-guarantee {
    border: 1px solid rgba(0,201,123,0.3); background: rgba(0,201,123,0.06);
    border-radius: var(--radius-md); padding: 32px; margin-top: 40px; text-align: center;
    max-width: 700px; margin: 40px auto 0;
  }
  .hl-guarantee__icon { font-size: 3rem; margin-bottom: 16px; }
  .hl-guarantee__title { font-family: 'Inter', sans-serif; font-weight: 900; font-size: 1.5rem; margin-bottom: 12px; color: var(--green-signal); }
  .hl-guarantee__text { font-size: 0.95rem; color: var(--text-muted) !important; line-height: 1.7; max-width: 540px; margin: 0 auto; }

  .hl-final-cta {
    text-align: center; padding: 80px 24px; background: var(--space-black);
    border-top: 1px solid var(--border-subtle);
  }
  .hl-final-cta__urgency {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.85rem; color: var(--text-muted) !important; margin-top: 20px;
  }
  .hl-final-cta__urgency .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green-signal); animation: pulse-dot 2s ease infinite; }

  /* STICKY BAR */
  /* El widget de WhatsApp se planta encima del botón de compra.
     Cuando la barra aparece, lo subimos para que no se tapen. */
  #chat-bubble.whatsapp-widget { transition: transform .3s cubic-bezier(.22,.61,.36,1); }
  html.hl-sticky-on #chat-bubble.whatsapp-widget { transform: translateY(-84px); }

  .hl-sticky-bar {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(0,0,0,0.08);
    padding: 12px 24px; transform: translateY(100%); transition: transform 0.4s ease, opacity 0.3s ease;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
