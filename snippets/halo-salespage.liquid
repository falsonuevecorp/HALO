<script>
  // ---- STICKY BAR & TIMER ----
  (function(){
    var bar = document.getElementById('sticky-bar');
    var hero = document.querySelector('.hl-hero');
    if(bar && hero){
      window.addEventListener('scroll', function(){
        var heroBottom = hero.getBoundingClientRect().bottom;
        var arriba = heroBottom < 0;
        bar.classList.toggle('visible', arriba);
        // La burbuja de WhatsApp vive en la misma esquina: se corre para arriba.
        document.documentElement.classList.toggle('hl-sticky-on', arriba);
      }, {passive:true});
    }

    // Reloj del precio de lanzamiento: 24 h desde la primera visita.
    // Se guarda en el navegador para que no se reinicie en cada recarga.
    var VENTANA = 24 * 60 * 60 * 1000;
    var CLAVE = 'hl_oferta_hasta';
    var hasta;
    try { hasta = parseInt(localStorage.getItem(CLAVE), 10); } catch (e) {}
    if (!hasta || isNaN(hasta) || hasta - Date.now() > VENTANA) {
      hasta = Date.now() + VENTANA;
      try { localStorage.setItem(CLAVE, String(hasta)); } catch (e) {}
    }

    var reloj = document.getElementById('hl-oferta-reloj');
    var relojSticky = document.getElementById('sticky-timer');
    var envoltorio = document.getElementById('sticky-timer-wrap');

    function dosDigitos(n) { return n < 10 ? '0' + n : '' + n; }

    var bloque = document.getElementById('hl-oferta-bloque');
    var texto = document.getElementById('hl-oferta-texto');
    var yaVencio = false;

    function vencer() {
      // Al vencer: el aviso titila unos segundos y después desaparece del todo.
      if (yaVencio) return;
      yaVencio = true;
      if (texto) texto.textContent = '⚠️ Se agota la oferta';
      if (bloque) bloque.classList.add('hl-titila');
      if (envoltorio) {
        envoltorio.textContent = 'Se agota la oferta';
        envoltorio.classList.add('hl-titila');
      }
      setTimeout(function () {
        if (bloque) bloque.style.display = 'none';
        if (envoltorio) envoltorio.style.display = 'none';
      }, 10000);
    }

    function pintarReloj() {
      var falta = hasta - Date.now();
      if (falta <= 0) {
        vencer();
        return false;
      }
      var seg = Math.floor(falta / 1000);
      var texto = dosDigitos(Math.floor(seg / 3600)) + ':' +
                  dosDigitos(Math.floor(seg % 3600 / 60)) + ':' +
                  dosDigitos(seg % 60);
      if (reloj) reloj.textContent = texto;
      if (relojSticky) relojSticky.textContent = texto;
      return true;
    }

    if (pintarReloj()) {
      var tic = setInterval(function () { if (!pintarReloj()) clearInterval(tic); }, 1000);
    }
  })();

  // JS de suscripción removido

  // ---- TECH ACCORDION ----
  function toggleAccordion(btn) {
    var content = btn.nextElementSibling;
    var icon = btn.querySelector('.hl-accordion__icon');
    var isOpen = content.classList.contains('open');
    document.querySelectorAll('.hl-accordion__content').forEach(function(c){ c.classList.remove('open'); });
    document.querySelectorAll('.hl-accordion__icon').forEach(function(i){ i.textContent = '+'; i.style.transform = ''; });
    if(!isOpen){ content.classList.add('open'); icon.textContent = '−'; icon.style.transform = 'rotate(180deg)'; }
  }

  // ---- FAQ TOGGLE ----
  function toggleFaq(el) {
    var answer = el.nextElementSibling;
    var icon = el.querySelector('.ico');
    var isOpen = answer.classList.contains('open');
    document.querySelectorAll('.hl-faq__a').forEach(function(a){ a.classList.remove('open'); });
    document.querySelectorAll('.hl-faq__q .ico').forEach(function(i){ i.textContent = '+'; });
    if(!isOpen){ answer.classList.add('open'); icon.textContent = '−'; }
  }
</script>
