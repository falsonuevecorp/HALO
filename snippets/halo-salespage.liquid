          <div class="hl-trust-micro" style="margin-top:14px; justify-content:center;">
            <span>🔒 Pago 100% Seguro</span>
            <span>🛡️ Garantía por Defectos de Fábrica</span>
            <span>📦 Despacho Gratis</span>
          </div>
        </div>
      </div>

      <!-- THE GODFATHER GUARANTEE -->
      <div class="hl-guarantee">
        <div class="hl-guarantee__icon">🛡️</div>
        <div class="hl-guarantee__title">Garantía "Despierta Como Nuevo" — 30 Noches</div>
        <div class="hl-guarantee__text">
          Úsalo 30 días. Si no tienes el sueño más reparador de tu vida, te reembolsamos el 100% y <strong style="color: var(--text-white) !important;">te quedas con los bonos.</strong> Cero riesgos.
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <div class="hl-final-cta">
    <span class="mono-tag" style="display:block; margin-bottom:16px;">¿Listo para apagar el ruido?</span>
    <h2 class="h-title" style="margin-bottom:16px;">Únete a +2.400 personas que ya duermen profundo.</h2>
    <p class="body-md" style="max-width:480px; margin:0 auto 32px;">
      Pagas el mal sueño con tu energía y salud. Es hora de detenerlo.
    </p>
    {% if product.available %}
      <a href="/cart/add?id={{ product.variants.first.id }}&quantity=1" class="hl-btn-cta" style="max-width:480px; margin:0 auto; display:block;">
        🌙 Comenzar Mis 30 Noches de Sueño Profundo
      </a>
    {% endif %}
    <div class="hl-final-cta__urgency">
      <div class="dot"></div>
      <span>Disponible hoy · Despacho en 24hrs · Garantía de Fábrica</span>
    </div>
  </div>

  <!-- STICKY BAR -->
  <div class="hl-sticky-bar" id="sticky-bar">
    <div class="hl-sticky-bar__inner">
      <div class="hl-sticky-bar__name">HALO® Neuro</div>
      <div class="hl-sticky-bar__price">$149.990</div>
      <a href="#oferta" class="hl-sticky-bar__cta">Obtener Ahora</a>
    </div>
  </div>

</div><!-- /halo-funnel -->

<script>
  // ---- STICKY BAR ----
  (function(){
    var bar = document.getElementById('sticky-bar');
    var hero = document.querySelector('.hl-hero');
    if(!bar || !hero) return;
    window.addEventListener('scroll', function(){
      var heroBottom = hero.getBoundingClientRect().bottom;
      bar.classList.toggle('visible', heroBottom < 0);
    }, {passive:true});
  })();

  // ---- HERO PRICE TOGGLE ----
  (function(){
    var btnSub = document.getElementById('btn-sub');
    var btnOnce = document.getElementById('btn-once');
    var priceEl = document.getElementById('price-display');
    var compareEl = document.getElementById('price-compare');
    var badgeEl = document.getElementById('price-badge');
    var cuotasEl = document.getElementById('cuotas-text');
    var ctaEl = document.getElementById('hero-cta');
    if(!btnSub) return;
    btnSub.addEventListener('click', function(){
      btnSub.classList.add('active'); btnOnce.classList.remove('active');
      priceEl.textContent = '$104.993';
      compareEl.textContent = '$149.990';
      badgeEl.textContent = '30% OFF';
      badgeEl.style.display = 'inline-block';
      cuotasEl.innerHTML = 'o 3 cuotas de <strong>$34.998</strong> sin interés · Despacho GRATIS';
      if(ctaEl) ctaEl.textContent = '🌙 Comenzar Mis 30 Noches de Sueño Profundo';
    });
    btnOnce.addEventListener('click', function(){
      btnOnce.classList.add('active'); btnSub.classList.remove('active');
      priceEl.textContent = '$149.990';
      compareEl.textContent = '$234.970';
      badgeEl.textContent = 'Pago Único';
      cuotasEl.innerHTML = 'o 3 cuotas de <strong>$49.997</strong> sin interés · Despacho GRATIS';
      if(ctaEl) ctaEl.textContent = '🌙 Obtener HALO Neuro Ahora';
    });
  })();

  // ---- TECH ACCORDION ----
  function toggleAccordion(btn) {
    var content = btn.nextElementSibling;
    var icon = btn.querySelector('.hl-accordion__icon');
    var isOpen = content.classList.contains('open');
    document.querySelectorAll('.hl-accordion__content').forEach(function(c){ c.classList.remove('open'); });
    document.querySelectorAll('.hl-accordion__icon').forEach(function(i){ i.textContent = '+'; i.style.transform = ''; });
    if(!isOpen){ content.classList.add('open'); icon.textContent = '−'; icon.style.transform = 'rotate(180deg)'; }
  }

  // ---- FAQ TOGGLE ----
  function toggleFaq(el) {
    var answer = el.nextElementSibling;
    var icon = el.querySelector('.ico');
    var isOpen = answer.classList.contains('open');
    document.querySelectorAll('.hl-faq__a').forEach(function(a){ a.classList.remove('open'); });
    document.querySelectorAll('.hl-faq__q .ico').forEach(function(i){ i.textContent = '+'; });
    if(!isOpen){ answer.classList.add('open'); icon.textContent = '−'; }
  }
</script>
