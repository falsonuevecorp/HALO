<script>
  // ---- STICKY BAR & TIMER ----
  (function(){
    var bar = document.getElementById('sticky-bar');
    var hero = document.querySelector('.hl-hero');
    if(bar && hero){
      window.addEventListener('scroll', function(){
        var heroBottom = hero.getBoundingClientRect().bottom;
        bar.classList.toggle('visible', heroBottom < 0);
      }, {passive:true});
    }

    var timerDisplay = document.getElementById('sticky-timer');
    if(timerDisplay) {
      var duration = 5 * 60; // 5 minutos
      var timer = setInterval(function() {
        var m = parseInt(duration / 60, 10);
        var s = parseInt(duration % 60, 10);
        m = m < 10 ? "0" + m : m;
        s = s < 10 ? "0" + s : s;
        timerDisplay.textContent = m + ":" + s;
        if (--duration < 0) {
          clearInterval(timer);
          document.getElementById('sticky-timer-wrap').style.display = 'none';
        }
      }, 1000);
    }
  })();

  // JS de suscripción removido

  // ---- TECH ACCORDION ----
  function toggleAccordion(btn) {
    var content = btn.nextElementSibling;
    var icon = btn.querySelector('.hl-accordion__icon');
    var isOpen = content.classList.contains('open');
    document.querySelectorAll('.hl-accordion__content').forEach(function(c){ c.classList.remove('open'); });
    document.querySelectorAll('.hl-accordion__icon').forEach(function(i){ i.textContent = '+'; i.style.transform = ''; });
    if(!isOpen){ content.classList.add('open'); icon.textContent = '−'; icon.style.transform = 'rotate(180deg)'; }
  }

  // ---- FAQ TOGGLE ----
  function toggleFaq(el) {
    var answer = el.nextElementSibling;
    var icon = el.querySelector('.ico');
    var isOpen = answer.classList.contains('open');
    document.querySelectorAll('.hl-faq__a').forEach(function(a){ a.classList.remove('open'); });
    document.querySelectorAll('.hl-faq__q .ico').forEach(function(i){ i.textContent = '+'; });
    if(!isOpen){ answer.classList.add('open'); icon.textContent = '−'; }
  }
</script>
